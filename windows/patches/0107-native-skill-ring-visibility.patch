+    ring = ui_object(p->map, ui_path_key(
+        "root.normallayer.consoleskillselection_main.layoutroot.skillloadout"));
+    if (!ring || !ui_visible(p->map, ring) ||
         !kbm_read64(ring, &vt) || vt != 0x90AF208 ||
         !kbm_read64(ring + 0x30, &ring_key) ||
         !kbm_read64(ring + 0x60, &children) ||
         !kbm_read32(ring + 0x68, &count) || count != 14) {
-        LOG("native: skill icon pre miss tab=%d ring=%llx vis=%d\n", state.current,
+        LOG("native: skill icon pre miss ring=%llx vis=%d\n",
             (unsigned long long)ring, ring ? ui_visible(p->map, ring) : 0);
         return 0;
     }
