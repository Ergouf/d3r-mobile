+/* The bucket hash in 0x8335350 only covers the low 4 bytes of the key; a few
+   UI nodes whose key collides are not reachable from its bucket. Scan the whole
+   registry when the direct lookup misses. */
+static u64 ui_find_key(u64 map, u64 key) {
+    u32 mask, total;
+    u64 buckets;
+    if (key == UINT64_MAX || !kbm_read32(map, &mask) || mask > 262143 ||
+        !kbm_read64(map + 0x10, &buckets) || !kbm_read32(map + 4, &total) ||
+        total > 262143) return 0;
+    for (u32 i = 0; i <= mask; i++) {
+        u64 node;
+        if (!kbm_read64(buckets + (u64)i * 8, &node)) continue;
+        for (unsigned g = 0; node && g < 1024; g++) {
+            u64 actual, obj, next;
+            if (!kbm_read64(node, &next)) break;
+            if (kbm_read64(node + 8, &actual) && actual == key &&
+                kbm_read64(node + 0x10, &obj)) return obj;
+            node = next;
+        }
+    }
+    return 0;
+}
