+            !ui_code(callback)) continue;
+        if (!ui_within(p->map, obj, state.page)) return 0;
+        if (obj == owner && callback == (state.current == 0 ? 0x81FB910ull : 0x8387180ull))
+            subscribed = 1;
+    }
+    return subscribed;
+}
