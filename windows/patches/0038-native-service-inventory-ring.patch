+    int subscribed = 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, table, callback;
+        if (!read64(entries + i * 8ull, &obj)) return 0;
+        if (!obj || !ui_visible(p->map, obj)) continue;
+        if (!ui_within(p->map, obj, normal)) return 0;
+        if (!read64(obj, &vt) || !read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
