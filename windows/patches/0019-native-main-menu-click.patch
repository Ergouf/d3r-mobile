+/* The main menu's confirm callback lives on a subscribed sibling proxy, not
+   on the list's parent chain.  Bind only this observed page/list/callback pair;
+   arbitrary page siblings may operate a different focused control. */
+static u64 ui_main_menu_owner(UiPick* p, u64 entries, u32 count) {
+    u64 reference, key, parent = ui_parent(p->map, p->focused), owner = 0;
+    if (!parent || !read64(0x91560D0, &reference) || !read64(reference, &key) ||
+        ui_object(p->map, key) != p->focused) return 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, table, callback, candidate_key;
+        if (!read64(entries + (u64)i * 8, &obj) || !obj ||
+            !read64(obj + 0x30, &candidate_key) || ui_object(p->map, candidate_key) != obj ||
+            ui_parent(p->map, obj) != parent || !ui_visible(p->map, obj) ||
+            !read64(obj, &vt) || !read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+            !read64(obj + 0x118, &table) || !read64(table + 0x20, &callback) ||
+            callback != 0x8366870) continue;
+        if (owner) return 0; /* ambiguous subscription: do not guess */
+        owner = obj;
+    }
+    if (owner) p->callback = 0x8366870;
+    return owner;
+}
