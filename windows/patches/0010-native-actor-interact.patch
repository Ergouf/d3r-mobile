+
+/* ---- native mouse cursor and the built-in skill wheel ---- */
+/* The pointer comes from SDL's motion events (window pixels), so it follows a
+   real mouse as well as a scripted one.  The wheel opens on Alt and casts the
+   slot the pointer points at when Alt is released: A B X Y L R around the
+   centre, the same native action queue the keyboard uses. */
+static float g_pt_x = -1, g_pt_y = -1;
+static float g_pt_width, g_pt_height;
+static int g_pt_inside;
+static int g_wheel;
+static float g_wheel_cx, g_wheel_cy;
+
+void overlay_pointer_feed(float x, float y, int inside, int width, int height) {
+    g_pt_x = x; g_pt_y = y; g_pt_width = width; g_pt_height = height;
+    g_pt_inside = inside && isfinite(x) && isfinite(y) && width > 0 && height > 0 &&
+                  x >= 0 && y >= 0 && x <= 1 && y <= 1;
+    if (!g_pt_inside) g_wheel = 0;
+}
+void overlay_wheel_begin(void) {
+    g_wheel = 0;
+    if (!g_pt_inside) return;
+    g_wheel = 1;
+    g_wheel_cx = g_pt_x; g_wheel_cy = g_pt_y;
+}
+void overlay_wheel_cancel(void) {
+    g_wheel = 0;
+}
+static int wheel_slot(void) {
+    if (!g_wheel || !g_pt_inside) return -1;
+    float dx = (g_pt_x - g_wheel_cx) * g_pt_width;
+    float dy = (g_pt_y - g_wheel_cy) * g_pt_height;
+    if (hypotf(dx, dy) <= 24.0f) return -1;
+    float angle = atan2f(dy, dx) + (float)M_PI / 2.0f;
+    while (angle < 0) angle += 2.0f * (float)M_PI;
+    return (int)lroundf(angle / ((float)M_PI / 3.0f)) % 6;
+}
+int overlay_wheel_end(void) {
+    int slot = wheel_slot(); /* latest motion, even when no draw occurred */
+    g_wheel = 0;
+    return slot;
+}
+
+static void cursor_draw(SnxUiList* l, float x, float y) {
+    /* Temporary drawn pointer. The actual PC cursor asset is not imported yet. */
+    ui_fill(l, x + 2, y + 1, 5, 15, 0xE0080C18);
+    ui_fill(l, x + 1, y + 9, 14, 13, 0xE0080C18);
+    ui_fill(l, x + 3, y + 2, 3, 13, 0xFFE8C07A);
+    ui_fill(l, x + 2, y + 10, 12, 10, 0xFFD9A85C);
+    ui_fill(l, x + 13, y + 11, 4, 6, 0xFFD9A85C);
+    ui_fill(l, x + 2, y + 10, 10, 2, 0xFFFFE7B8);
+    ui_fill(l, x + 5, y + 13, 2, 5, 0xFFE8C07A);
+    ui_fill(l, x + 8, y + 13, 2, 5, 0xFFE8C07A);
+    ui_fill(l, x + 11, y + 13, 2, 4, 0xFFE8C07A);
+}
+
+static void wheel_draw(SnxUiList* l, int sw, int sh) {
+    static const char* const label[6] = {"A", "B", "X", "Y", "L", "R"};
+    static const char* const keys[6] = {"SPACE", "Z", "C", "V", "Q", "E"};
+    float cx = g_wheel_cx * sw, cy = g_wheel_cy * sh;
+    int slot = wheel_slot(), i;
+    const float R = 74.0f, B = 21.0f;
+    ui_fill(l, cx - 8, cy - 8, 16, 16, 0xA0080C18);
+    ui_fill(l, cx - 6, cy - 6, 12, 12, 0xFFD9A85C);
+    for (i = 0; i < 6; ++i) {
+        float a = (float)i * (float)M_PI / 3.0f - (float)M_PI / 2.0f;
+        float x = cx + cosf(a) * R - B, y = cy + sinf(a) * R - B;
+        u32 fill = i == slot ? 0xC03088E8 : 0xB0080C18;
+        u32 edge = i == slot ? 0xFFFFE7B8 : 0xFF3FA0E8;
+        ui_fill(l, x, y, B * 2, B * 2, fill);
+        ui_fill(l, x, y, B * 2, 2, edge);
+        ui_fill(l, x, y + B * 2 - 2, B * 2, 2, edge);
+        ui_fill(l, x, y, 2, B * 2, edge);
+        ui_fill(l, x + B * 2 - 2, y, 2, B * 2, edge);
+        ui_text(l, x + B - 3, y + 3, 1, label[i], 0xFFFFE7B8);
+        ui_text(l, x + 2, y + B * 2 - 12, 1, keys[i], 0xC0D9A85C);
+    }
+    ui_text(l, cx - 22, cy - R - 30, 1, "SKILLS", 0xFF3FA0E8);
+}
+void overlay_pointer_draw(SnxUiList* l, int sw, int sh) {
+    if (g_wheel) wheel_draw(l, sw, sh);
+    if (g_pt_inside && g_pt_x >= 0 && g_pt_x <= 1 && g_pt_y >= 0 && g_pt_y <= 1)
+        cursor_draw(l, g_pt_x * sw, g_pt_y * sh);
+}
+
+int overlay_error_hit(const SnxOverlayRect* r, float x, float y) {    return r && r->w > 0 && r->h > 0 && x >= r->x && x < r->x + r->w && y >= r->y && y < r->y + r->h;
 }
