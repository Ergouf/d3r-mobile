+/* The native operate record the game builds for a natural A press on an actor
+   (0x80D5AF0 -> 0x840A4F0 -> 0x80CBA30).  Its header is four words and the
+   path starts at +0x14:
+     +0 controller handle, +4 power, +8 power, +0xC 0, +0x10 -1 */
+static int submit_interact(const CPU* cpu, u64 player_object, const WalkGoal* goal) {
+    const u64 record = g_stack_top - 0x1CD00, path = record + 0x14;
+    u32* words = (u32*)GP(record);
+    memset(GP(record), 0, 0x80);
+    words[0] = goal->controller;
+    words[1] = words[2] = goal->power;
+    words[3] = 0;
+    words[4] = 0xFFFFFFFFu;
+    u64 build[4] = {path, goal->handle, 0, 0};
+    if (!guest_call(cpu, PATH_ACTOR_PC, build, 4, NULL, 0, NULL)) {
+        LOG("native: operate path build failed for %08x\n", goal->handle);
+        return 0;
+    }
+    u32 type, id;
+    if (!read32(path, &type) || !read32(path + 4, &id) || type != 1 || id != goal->handle) {
+        LOG("native: operate path mismatch type %u id %08x (want %08x)\n", type, id, goal->handle);
+        return 0;
+    }
+    u64 submit[4] = {player_object, record, 1, 1};
+    GuestResult r;
+    if (!guest_call(cpu, ACTION_PC, submit, 4, NULL, 0, &r)) {
+        LOG("native: operate call incomplete for %08x\n", goal->handle);
+        return 0;
+    }
+    LOG("native: operate %08x record %08x/%d/%d -> %d\n", goal->handle, words[0], (int)words[1],
+        (int)words[2], (int)(u32)r.x0);
+    return (u32)r.x0 == 1;
+}
