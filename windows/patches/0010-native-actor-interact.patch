+/* Nearest interactive actor under the click.  A cylinder ray test is exact but
+   misses small or thin props; when it finds nothing, project the actors the
+   game owns and take the one whose on-screen body (base..top) is closest to the
+   click, still respecting the terrain ray for occlusion. */
+static int pick_entity(const CPU* cpu, u64 table, const WorldRay* ray, float occlusion,
+                       const WorldPos* pos, u32 player_actor, WalkGoal* goal) {
+    const u64 scratch = g_stack_top - 0x1D000, hit = scratch + 0x40;
+    u32 limit, shift;
+    u64 buckets;
+    float best = fminf(occlusion, ray->length) + 0.05f;
+    int found = 0;
+    if (!read32(table + 0x100, &limit) || !read32(table + 0x168, &shift) || shift > 16 ||
+        limit > 65536 || !read64(table + 0x120, &buckets)) return -1;
+    memcpy(GP(scratch), ray, sizeof *ray);
+    for (u32 i = 0; i < limit; i++) {
+        u64 bucket, entry;
+        u32 id, place, cid;
+        float cylinder[5], p[3], depth;
+        GuestResult r;
+        if (!read64(buckets + ((u64)i >> shift) * 8, &bucket) || !bucket) continue;
+        entry = bucket + (u64)(i & ((1u << shift) - 1)) * ENTITY_STRIDE;
+        if (!read32(entry, &id) || !id || (id & 0xFFFF) != i || id == 0xFFFFFFFFu || id == player_actor ||
+            !read32(entry + 0xA0, &place) || place != pos->place ||
+            !read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu ||
+            !readable(entry + 0x60, 12) || !readable(entry + 0x80, sizeof cylinder)) continue;
+        memcpy(p, GP(entry + 0x60), sizeof p);
+        memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
+        int finite = 1;
+        for (unsigned j = 0; j < 5; j++) if (!isfinite(cylinder[j])) finite = 0;
+        if (!finite || cylinder[3] <= 0 || cylinder[4] <= 0 ||
+            hypotf(p[0] - pos->x, p[1] - pos->y) > PICK_MAX_DISTANCE) continue;
+        /* Entity collision bounds, native ray test and native terrain depth.
+           No projected-nearest or generic confirm fallback may retarget a click. */
+        u64 args[3] = {scratch, entry + 0x80, hit};
+        if (!guest_call(cpu, CYLINDER_PC, args, 3, NULL, 0, &r)) return -1;
+        if (!r.x0) continue;
+        memcpy(&depth, GP(hit), 4);
+        if (!isfinite(depth) || depth < 0 || depth >= best) continue;
+        best = depth;
+        found = -1;
+        args[0] = entry;
+        if (!guest_call(cpu, CAP_POWER_PC, args, 1, NULL, 0, &r) || (i32)r.x0 < 0) continue;
+        found = 1;
+        goal->handle = id;
+        goal->controller = cid;
+        goal->entity = (WorldPos){p[0], p[1], p[2], place};
+        goal->power = (u32)r.x0;
+        goal->approach = fmaxf(INTERACT_APPROACH, cylinder[4] + 0.4f);
+    }
+    if (found > 0) LOG("native: cylinder hit %08x depth %.3f terrain %.3f power %d\n",
+                      goal->handle, best, occlusion, (int)goal->power);
+    return found;
+}
