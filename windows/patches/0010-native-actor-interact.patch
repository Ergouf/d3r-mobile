+static void ui_click(const CPU* cpu, const PointerPress* press) {
+    UiPick p = {.cpu = cpu};
+    GuestResult r;
+    const u64 scratch = g_stack_top - 0x1A000;
+    u64 global, world, manager, key, vt, method, table;
+    int pixel[2];
+    if ((u32)((u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED) - press->frame) > 120 ||
+        !pointer_pixel(cpu, press, pixel) || !read64(0x914F840, &global) ||
+        !read64(global + 0x10, &world) || !read64(world + 0xB80, &manager) ||
+        !read64(manager, &p.map)) return;
+    if (!guest_call(cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !read64(r.x0, &key) || !(p.focused = ui_object(p.map, key))) return;
+    if (!ui_visible(p.map, p.focused)) return;
+    p.owner = p.focused;
+    for (unsigned i = 0; p.owner && i < 64; i++) {
+        u32 flags;
+        if (!read32(p.owner + 0x18, &flags) || !(flags & 4)) return;
+        if (read64(p.owner, &vt) && read64(vt + 0xB0, &method) && method == 0x83B81F0 &&
+            read64(p.owner + 0x118, &table) && read64(table + 0x20, &p.callback) && ui_code(p.callback)) break;
+        p.owner = ui_parent(p.map, p.owner);
+    }
+    if (!p.owner || !ui_code(p.callback)) return;
+    memcpy(GP(scratch), pixel, sizeof pixel);
+    u64 args[3] = {scratch, scratch + 0x20};
+    if (!guest_call(cpu, 0x8350BF0, args, 2, NULL, 0, NULL)) return;
+    memcpy(p.point, GP(scratch + 0x20), sizeof p.point);
+    if (!isfinite(p.point[0]) || !isfinite(p.point[1]) || !ui_visit(&p, p.owner, 0)) {
+        LOG("native: UI pointer %u missed (%d,%d)\n", press->serial, pixel[0], pixel[1]);
+        return;
+    }
+    if (p.kind == 3) {
+        LOG("native: UI pointer %u disabled control %llx\n", press->serial, (unsigned long long)p.control);
+        return;
+    }
+    if (p.kind == 2) {
+        args[0] = p.control; args[1] = p.index;
+        u32 selected;
+        if (!guest_call(cpu, 0x838A6E0, args, 2, NULL, 0, NULL) ||
+            !read32(p.control + 0x1E0, &selected) || selected != p.index) return;
+    }
+    /* Invoke this hit control's callback, never a global A/confirm event. */
