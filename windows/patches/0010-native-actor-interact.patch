+/* UIReference holds a name key, not a pointer. +0x20/+0x28 are intrusive
+   sibling links; +0x38 is the parent reference used by the native UI code. */
+typedef struct {
+    const CPU* cpu;
+    u64 map, focused, owner, callback;
+    float point[2];
+    unsigned visited;
+    u64 control, row, hit_owner, hit_callback;
+    u32 index;
+    int kind; /* 1 = button, 2 = list row, 3 = disabled/blocked */
+} UiPick;
+
+static int ui_code(u64 pc) {
+    return pc >= g_code_lo && pc < g_code_hi && !(pc & 3);
+}
+
+static u64 ui_object(u64 map, u64 key) {
+    u32 mask, h = 0x811C9DC5u;
+    u64 buckets, node;
+    if (key == UINT64_MAX || !read32(map, &mask) || mask > 262143 ||
+        !read64(map + 0x10, &buckets)) return 0;
+    /* 0x8335350 hashes the low four bytes of the 64-bit name key. */
+    for (unsigned i = 0; i < 4; i++) h = (h ^ ((key >> (i * 8)) & 255)) * 0x1000193u;
+    if (!read64(buckets + (h & mask) * 8ull, &node)) return 0;
+    for (unsigned i = 0; node && i < 1024; i++) {
+        u64 actual, obj, identity;
+        if (!read64(node + 8, &actual)) return 0;
+        if (actual == key) {
+            if (!read64(node + 0x10, &obj) || !read64(obj + 0x30, &identity) || identity != key) return 0;
+            return obj;
+        }
+        if (!read64(node, &node)) return 0;
+    }
+    return 0;
+}
+
+static u64 ui_parent(u64 map, u64 obj) {
+    u64 key;
+    return read64(obj + 0x38, &key) ? ui_object(map, key) : 0;
+}
+
+static int ui_visible(u64 map, u64 obj) {
+    for (unsigned i = 0; obj && i < 64; i++) {
+        u32 flags;
+        u64 parent;
+        if (!read32(obj + 0x18, &flags) || !(flags & 4) || !read64(obj + 0x38, &parent)) return 0;
+        if (parent == UINT64_MAX) return 1;
+        obj = ui_object(map, parent);
+    }
+    return 0; /* missing parent, cycle or unbounded hierarchy */
+}
+
+static int ui_inside(UiPick* pick, u64 obj) {
+    const u64 scratch = g_stack_top - 0x1B000;
+    GuestResult r;
+    float clip[4];
+    u64 args[3] = {obj};
+    if (!readable(obj + 0x88, 16) ||
+        !guest_call(pick->cpu, 0x83B7EE0, args, 1, NULL, 0, &r) || !readable(r.x0, 16)) return 0;
+    args[0] = obj + 0x88; args[1] = r.x0; args[2] = scratch;
+    if (!guest_call(pick->cpu, 0x8A385B0, args, 3, NULL, 0, NULL)) return 0;
+    memcpy(clip, GP(scratch), sizeof clip);
+    for (unsigned i = 0; i < 4; i++) if (!isfinite(clip[i])) return 0;
+    return clip[2] > clip[0] && clip[3] > clip[1] &&
+           pick->point[0] >= clip[0] && pick->point[0] < clip[2] &&
+           pick->point[1] >= clip[1] && pick->point[1] < clip[3];
+}
+
+static int ui_visit(UiPick* p, u64 obj, unsigned depth) {
+    u64 vt, method, data;
+    u32 flags, count;
+    GuestResult r;
+    if (!obj || ++p->visited > 20000 || depth > 48 || !read32(obj + 0x18, &flags) ||
+        !(flags & 4) || !read64(obj, &vt)) return 0;
+    if (!read64(vt + 0xE0, &method)) return 0;
+    if (method == 0x838C6C0 && obj == p->focused && ui_inside(p, obj)) {
+        u64 model, model_vt, size_pc, allow_pc;
+        u32 page, columns;
+        if (!read64(obj + 0x258, &model) || !read64(model, &model_vt) ||
+            !read64(model_vt + 0x10, &size_pc) || !ui_code(size_pc) ||
+            !read64(model_vt + 0x30, &allow_pc) || !ui_code(allow_pc) ||
+            !read64(obj + 0x210, &data) || !read32(obj + 0x218, &count) || count > 4096 ||
+            !read32(obj + 0x1E4, &page) || !read32(obj + 0x2A4, &columns)) return 0;
+        u64 args[3] = {model};
+        if (!guest_call(p->cpu, size_pc, args, 1, NULL, 0, &r) || r.x0 > 65536) return 0;
+        u32 size = (u32)r.x0;
+        for (u32 i = count; i-- > 0;) {
+            u64 key, row;
+            i64 index = (i32)page < 0 ? -1 : (i64)page * columns + i;
+            if (!read64(data + i * 8ull, &key) || !(row = ui_object(p->map, key)) ||
+                !read32(row + 0x18, &flags) || !(flags & 4) || index < 0 || index >= size ||
+                !ui_inside(p, row)) continue;
+            args[0] = model; args[1] = obj; args[2] = (u32)index;
+            if (!guest_call(p->cpu, allow_pc, args, 3, NULL, 0, &r)) return 0;
+            p->kind = r.x0 ? 2 : 3;
+            p->control = obj; p->row = row; p->index = (u32)index;
+            p->hit_owner = p->owner; p->hit_callback = p->callback;
+            return 1;
+        }
+    }
+    if (!read32(obj + 0x68, &count) || count > 4096 || !read64(obj + 0x60, &data)) return 0;
+    for (u32 i = count; i-- > 0;) {
+        u64 child;
+        if (read64(data + i * 24ull + 8, &child) && ui_visit(p, child, depth + 1)) return 1;
+    }
+    if (read64(vt + 0x60, &method) && method == 0x8392410 && ui_inside(p, obj)) {
+        u32 enabled;
+        u64 table, cb, predicate;
+        if (!read32(obj + 0x3C8, &enabled) || !read64(obj + 0x118, &table) ||
+            !read64(table, &cb) || !ui_code(cb)) return 0;
+        p->kind = (enabled & 1) ? 1 : 3;
+        if (p->kind == 1 && read64(obj + 0x488, &predicate) && predicate) {
+            const u64 args[] = {obj + 0x30};
+            if (!ui_code(predicate) || !guest_call(p->cpu, predicate, args, 1, NULL, 0, &r) || !r.x0)
+                p->kind = 3;
+        }
+        p->control = p->hit_owner = obj; p->hit_callback = cb;
+        return 1;
+    }
+    return 0;
+}
