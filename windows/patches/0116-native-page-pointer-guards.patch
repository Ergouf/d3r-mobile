+/* Mouse-opened pages can inherit a hidden keyboard focus from the last page.
+   Require an input subscription in this page, and let visible modal owners
+   veto the click, rather than treating that stale focus as the active owner. */
+static int ui_pointer_page_allowed(UiPick* p, u64 first, u64 second) {
+    GuestResult r;
+    u64 global, world, manager, map, subs, entries, normal, key, focus;
+    u32 count;
+    if (!first || !ui_visible(p->map, first) ||
+        !kbm_read64(0x914F840, &global) || !kbm_read64(global + 0x10, &world) ||
+        !kbm_read64(world + 0xB80, &manager) || !kbm_read64(manager, &map) || map != p->map ||
+        !kbm_read64(manager + 0x10, &subs) || !kbm_read64(subs, &entries) ||
+        !kbm_read32(subs + 8, &count) || !count || count > 1024 ||
+        !(normal = ui_object(map, 1)) ||
+        !guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) || !kbm_read64(r.x0, &key)) return 0;
+    focus = key == UINT64_MAX ? 0 : ui_object(map, key);
+    if (focus && ui_visible(map, focus) && !ui_within(map, focus, first) &&
+        (!second || !ui_within(map, focus, second))) return 0;
+    int subscribed = 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, callbacks, callback;
+        if (!kbm_read64(entries + i * 8ull, &obj)) return 0;
+        if (!obj || !ui_visible(map, obj)) continue;
+        if (!ui_within(map, obj, normal)) return 0;
+        if (!kbm_read64(obj, &vt) || !kbm_read64(vt + 0xB0, &method) || method != 0x83B81F0) continue;
+        if (ui_within(map, obj, first) || (second && ui_within(map, obj, second))) subscribed = 1;
+        else if (kbm_read64(obj + 0x118, &callbacks) && callbacks &&
+                 kbm_read64(callbacks + 0x20, &callback) && ui_code(callback)) return 0;
+    }
+    return subscribed;
+}
