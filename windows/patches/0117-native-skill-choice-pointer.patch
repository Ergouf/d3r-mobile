+static int ui_skill_choice(UiPick* p, u32 serial) {
+    const u64 page = ui_object(p->map, ui_path_key("root.normallayer.consoleskillselection_main"));
+    u64 holder, controller;
+    u32 mode;
+    if (!page || !ui_visible(p->map, page) ||
+        !kbm_read64(0x9158040, &holder) || !kbm_read64(holder, &controller) ||
+        !kbm_read32(controller + 0x1F8, &mode) || mode < 1 || mode > 3 ||
+        !ui_pointer_page_allowed(p, page, 0)) return 0;
+    const u64 grid = controller + (mode == 1 ? 0x200 : mode == 2 ? 0x238 : 0x270);
+    const u64 callbacks[] = {0, 0x8387A20, 0x8387B10, 0x8387BF0};
+    const u64 accepts[] = {0, 0x8383CC0, 0x83841C0, 0x8384280};
+    u64 key, parent, data, callback;
+    u32 count, selected;
+    if (!kbm_read64(grid, &key) || !(parent = ui_object(p->map, key)) ||
+        !ui_visible(p->map, parent) || !ui_within(p->map, parent, page) ||
+        !kbm_read64(grid + 8, &data) ||
+        !kbm_read32(grid + 0x10, &count) || !count || count > 64 ||
+        !kbm_read64(grid + 0x30, &callback) || callback != callbacks[mode]) return 0;
+    if (mode == 1) {
+        const u64 arrows = ui_object(p->map, ui_path_key(
+            "root.normallayer.consoleskillselection_main.layoutroot.skillselection.skills.electivemode"));
+        if (arrows && ui_visible(p->map, arrows) && ui_inside(p, arrows) &&
+            kbm_readable(parent + 0x88, 16)) {
+            const float* rect = (const float*)GP(parent + 0x88);
+            if (p->point[0] < rect[0] || p->point[0] >= rect[2]) {
+                const u64 cycle[] = {controller, p->point[0] >= rect[2]};
+                guest_call(p->cpu, 0x83805F0, cycle, 2, NULL, 0, NULL);
+                return 1;
+            }
+        }
+    }
+    if (!ui_inside(p, parent)) return 0;
+    int hit = -1;
+    float best = FLT_MAX;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj;
+        float rect[4];
+        if (!kbm_read64(data + i * 8ull, &key) || !(obj = ui_object(p->map, key)) ||
+            !ui_visible(p->map, obj) || !ui_within(p->map, obj, parent) ||
+            !ui_inside(p, obj) || !kbm_readable(obj + 0x88, sizeof rect)) continue;
+        memcpy(rect, GP(obj + 0x88), sizeof rect);
+        const float distance = hypotf(p->point[0] - (rect[0] + rect[2]) * .5f,
+                                      p->point[1] - (rect[1] + rect[3]) * .5f);
+        if (distance < best) { best = distance; hit = (int)i; }
+    }
+    if (hit < 0) return 0;
+    GuestResult r;
+    const u64 select[] = {grid, (unsigned)hit, 0};
+    int ok = guest_call(p->cpu, 0x823FCE0, select, 3, NULL, 0, &r) && r.x0 &&
+        kbm_read32(grid + 0x20, &selected) && selected == (u32)hit;
+    if (ok) {
+        const u64 accept[] = {controller};
+        ok = guest_call(p->cpu, accepts[mode], accept, 1, NULL, 0, NULL);
+    }
+    LOG("native: UI skill choice %u mode=%u index=%d -> %s\n", serial, mode, hit,
+        ok ? "returned" : "blocked");
+    return 1;
 }
 
