+/* Standard treasure chests have a collision radius near five, so the closest
+   reachable point is outside the normal natural-operate range.  Only these
+   verified chest SNOs get the wider submission gate; portals retain the strict
+   range so the game performs their walk-in transition. */
+static int long_interact_sno(u32 sno) {
+    switch (sno) {
+        case 3142u: case 3143u:       /* adventure treasure chests */
+        case 62859u: case 62860u:     /* Act 1 Fields */
+        case 62865u: case 62866u:     /* Act 1 Highlands */
+        case 64271u:                  /* Act 1 stump chest */
+        case 78790u: case 78957u:     /* Act 1 wilderness */
+        case 94708u: case 95011u:     /* Leoric manor */
+        case 96522u: case 96993u:     /* Cathedral */
+        case 289247u: case 289248u:   /* Act 5 Westmarch */
+        case 289757u: case 289758u:   /* Act 5 Abattoir */
+        case 289786u: case 289787u:   /* Act 5 graveyard */
+            return 1;
+        default:
+            return 0;
+    }
+}
