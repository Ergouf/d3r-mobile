+    vk_render_end();
+    Surf2D from = {.addr = scene->gva, .width = 1280, .height = 720, .format = 0xD5, .linear = 1, .pitch = 1280 * 4};
+    Surf2D to = {.addr = ui->gva, .width = 1600, .height = 900, .format = 0xD5, .linear = 1, .pitch = 1600 * 4};
+    CHECK(vk_blit2d(&from, &to, 0, 0, 1280, 720, 0, 0, 1, 1));
