+    for (u32 i = 0; i < 4; i++) {
+        copies[i].bufferOffset = i * 4;
+        copies[i].imageSubresource = (VkImageSubresourceLayers){VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
