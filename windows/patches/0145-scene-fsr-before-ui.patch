+    vk_render_end();
+    const float uv[4] = {0, 0, 0.5f, 1}; /* only the red half is active, as with dynamic scene resolution */
+    const i32 crop[4] = {8, 8, 32, 32};
+    for (u32 i = 0; i < 3; i++) {
+        Surf* dst = i == 1 ? bgra : ui;
+        cb = vk_cmd();
+        vk_surf_use(cb, small, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT,
