+static int check_ui_depth_scale(void) {
+    float saved = g_vk_scale, saved_base = g_vk_base_scale;
+    g_vk_scale = g_vk_base_scale = 1.75f;
+    for (u32 kind = 0; kind < 2; kind++) {
+        GpuChannel* ch = calloc(1, sizeof *ch);
+        CHECK(ch);
+        u32* r = ch->r3d;
+        r[0x54E] = 1;
+        r[0x3F9] = 0x1400000 + kind * 0x500000;
+        r[0x3FA] = kind ? 0x14 : 0x0A;
+        r[0x3FB] = 0x1000;
+        r[0x48A] = 1280;
+        r[0x48B] = 720;
+        r[0x48C] = 1;
+        float depth = 0.25f;
+        memcpy(&r[0x364], &depth, 4);
+        r[0x368] = 0x53;
+        vk_render_clear(ch, kind ? 3 : 1);
+        Surf* scene = vk_rt_find(r[0x3F9]);
+        CHECK(scene);
+        r[0x43E] = 0x100;
+        r[0x380] = 1;
+        r[0x381] = (1280u << 16) | 640;
+        r[0x382] = (720u << 16) | 360;
+        depth = 0.75f;
+        memcpy(&r[0x364], &depth, 4);
+        r[0x368] = 0x71;
+        vk_render_clear(ch, kind ? 3 : 1);
+        vk_render_end();
+        Surf* ui = vk_depth_for_scale(scene, 1.75f, 0);
+        if (!ui) {
+            VkFormatProperties props;
+            vkGetPhysicalDeviceFormatProperties(g_vk.phys, scene->f.vk, &props);
+            fprintf(stderr, "depth copy declined: kind=%u fmt=%d layout=%d features=%x src=%ux%u scale=%g\n", kind,
+                    scene->f.vk, scene->layout, props.optimalTilingFeatures, scene->sw, scene->sh, scene->scale);
+        }
+        CHECK(ui && ui->sw == 2240 && ui->sh == 1260);
+        CHECK(ui == vk_depth_for_scale(scene, 1.75f, 0));
+        if (scene->f.stencil && !ui->f.stencil) CHECK(!vk_depth_for_scale(scene, 1.75f, 1));
+        VkBuffer buffer;
+        u8* data = vk_readback_buffer(16, &buffer);
+        CHECK(data);
+        VkCommandBuffer cb = vk_cmd();
+        vk_surf_use(cb, ui, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT,
+                    VK_ACCESS_2_TRANSFER_READ_BIT);
+        VkBufferImageCopy copies[4] = {0};
+        for (u32 i = 0; i < 4; i++) {
+            copies[i].bufferOffset = i * 4;
+            copies[i].imageSubresource =
+                (VkImageSubresourceLayers){i < 2 ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_STENCIL_BIT, 0, 0, 1};
+            copies[i].imageExtent = (VkExtent3D){1, 1, 1};
+            if (i & 1) copies[i].imageOffset = (VkOffset3D){2239, 1259, 0};
+        }
+        rec_CmdCopyImageToBuffer(cb, ui->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer, 2, copies);
+        if (kind) {
+            vk_surf_use(cb, scene, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT,
+                        VK_ACCESS_2_TRANSFER_READ_BIT);
+            copies[3].imageOffset = (VkOffset3D){(i32)scene->sw - 1, (i32)scene->sh - 1, 0};
+            rec_CmdCopyImageToBuffer(cb, scene->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer, 2, copies + 2);
+        }
+        vk_finish();
+        vk_readback_ready();
+        for (u32 i = 0; i < 2; i++) {
+            float got;
+            if (ui->f.vk == VK_FORMAT_D24_UNORM_S8_UINT) {
+                u32 raw;
+                memcpy(&raw, data + i * 4, 4);
+                got = (raw & 0xffffff) / 16777215.0f;
+            } else
+                memcpy(&got, data + i * 4, 4);
+            CHECK(fabsf(got - (i ? 0.75f : 0.25f)) < 0.00001f);
+        }
+        if (kind) CHECK(data[8] == 0x53 && data[12] == 0x71);
+        if (ui != scene) {
+            /* Simulate a native-size UI depth write and its target_written notification.
+               Reading the guest depth must resample it back without changing stencil. */
+            cb = vk_cmd();
+            vk_surf_use(cb,ui,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,VK_PIPELINE_STAGE_2_CLEAR_BIT,VK_ACCESS_2_TRANSFER_WRITE_BIT);
+            VkClearDepthStencilValue value = {0.5f,0};
+            VkImageSubresourceRange range = {VK_IMAGE_ASPECT_DEPTH_BIT,0,1,0,1};
+            rec_CmdClearDepthStencilImage(cb,ui->img,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,&value,1,&range);
+            scene->ui_depth_dirty=1;
+            CHECK(vk_depth_restore(scene));
+            CHECK(!scene->ui_depth_dirty);
+            data=vk_readback_buffer(16,&buffer); CHECK(data);
+            cb=vk_cmd();
+            vk_surf_use(cb,scene,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,VK_PIPELINE_STAGE_2_COPY_BIT,VK_ACCESS_2_TRANSFER_READ_BIT);
+            copies[1].imageOffset=(VkOffset3D){(i32)scene->sw-1,(i32)scene->sh-1,0};
+            rec_CmdCopyImageToBuffer(cb,scene->img,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,buffer,kind?4:2,copies);
+            vk_finish(); vk_readback_ready();
+            for (u32 i=0;i<2;i++) {
+                float got;
+                if (scene->f.vk==VK_FORMAT_D24_UNORM_S8_UINT) {
+                    u32 raw;memcpy(&raw,data+i*4,4);got=(raw&0xffffff)/16777215.0f;
+                } else memcpy(&got,data+i*4,4);
+                CHECK(fabsf(got-0.5f)<0.00001f);
+            }
+            if (kind) CHECK(data[8]==0x53 && data[12]==0x71);
+        }
+        free(ch);
+    }
+    g_vk_scale = saved;
+    g_vk_base_scale = saved_base;
+    return 0;
+}
