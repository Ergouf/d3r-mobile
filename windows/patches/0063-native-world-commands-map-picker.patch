+
+/* Q/T keep the game's equipped-potion lookup, health/cooldown checks and
+   recall restrictions. Resolve its current control layout only to build the
+   listener's native press event; do not publish or synthesize Npad input. */
+static void world_command_tick(const CPU* cpu) {
+    unsigned commands;
+    u32 frame;
+    pm_lock(&g_pointer_lock);
+    commands = g_world_command;
+    frame = g_command_frame;
+    g_world_command = 0;
+    pm_unlock(&g_pointer_lock);
+    if (!commands || native_world_ui_blocked() ||
+        (u32)((u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED) - frame) > 120) return;
+    u32 actor;
+    u64 entity, controller, player, table;
+    WorldPos pos;
+    if (!local_player(cpu, &actor, &entity, &controller, &pos, &player, &table) ||
+        !actor_alive(cpu, entity)) return;
+    const u64 event = g_stack_top - 0x18000;
+    for (unsigned command = 1; command <= 2; command <<= 1) {
+        if (!(commands & command)) continue;
+        u64 predicate = command == NATIVE_COMMAND_POTION ? 0x840C2B0 : 0x840C340;
+        unsigned matches = 0, selected = 0;
+        for (unsigned bit = 0; bit < 16; bit++) {
+            memset(GP(event), 0, 0x50);
+            *(u32*)GP(event) = 0x1D;
+            *(u32*)GP(event + 0x2C) = bit;
+            const u64 args[] = {event};
+            GuestResult r;
+            if (!guest_call(cpu, predicate, args, 1, NULL, 0, &r)) { matches = 0; break; }
+            if (r.x0) { matches++; selected = bit; }
+        }
+        if (matches != 1) continue;
+        if (command == NATIVE_COMMAND_RECALL) {
+            /* A previous click-to-walk goal must not keep submitting Walk and
+               immediately interrupt the recall channel. */
+            g_goal.active = 0;
+            __atomic_store_n(&g_hold_kind, 0, __ATOMIC_RELEASE);
+            pm_lock(&g_pointer_lock);
+            g_have_pointer = 0;
+            pm_unlock(&g_pointer_lock);
+        }
+        *(u32*)GP(event + 0x2C) = selected;
+        const u64 args[] = {event};
+        GuestResult r;
+        /* Full world listener retains all native action gates. */
+        int complete = guest_call(cpu, 0x80CF3A0, args, 1, NULL, 0, &r);
+        LOG("native: world command %s bit=%u -> %s/%u\n",
+            command == NATIVE_COMMAND_POTION ? "potion" : "recall", selected,
+            complete ? "returned" : "incomplete", complete ? (u32)r.x0 : 0);
+    }
+}
+
+static int submit_mouse_skill(const CPU* cpu, u64 player, const WorldPos* pos,
+                              const WorldPos* ground, int ground_ok, const WalkGoal* picked,
+                              int has_target, u64 table, unsigned slot) {
+    if (slot >= 6) return 0;
+    GuestResult r;
+    const u64 loadout[] = {player, slot};
+    u32 power;
+    if (!guest_call(cpu, 0x8525ED0, loadout, 2, NULL, 0, &r) ||
+        !read32(r.x0, &power) || !power || power == UINT32_MAX) return 0;
+    const u64 record = g_stack_top - 0x1CB00, path = record + 0x14;
+    u32* words = (u32*)GP(record);
+    u64 target = 0;
+    u32 type = 0;
+    int actor_target = has_target && picked->attack &&
+        lookup(table, picked->handle, ENTITY_STRIDE, &target) &&
+        read32(target + 0x14C, &type) && type == 1 && actor_alive(cpu, target);
+    if (!actor_target && !ground_ok) return 0;
+    memset(GP(record), 0, 0x80);
+    words[0] = actor_target ? picked->controller : UINT32_MAX;
+    words[1] = words[2] = power;
+    words[4] = UINT32_MAX;
+    if (actor_target) {
+        const u64 args[] = {path, picked->handle, 0, 0};
+        if (!guest_call(cpu, PATH_ACTOR_PC, args, 4, NULL, 0, NULL)) return 0;
+    } else {
+        WorldPos aim = *ground;
+        aim.z = pos->z + 4.37f;
+        memcpy(GP(record + 0x60), &aim, sizeof aim);
+        const u64 args[] = {path, record + 0x60};
+        if (!guest_call(cpu, PATH_POS_PC, args, 2, NULL, 0, NULL)) return 0;
+    }
+    const u64 args[] = {player, record, 1, 1};
+    if (!guest_call(cpu, ACTION_PC, args, 4, NULL, 0, &r)) return 0;
+    LOG("native: mouse skill slot=%u power=%u path=%u target=%08x -> %u\n",
+        slot, power, actor_target ? 1u : 2u, actor_target ? picked->handle : UINT32_MAX, (u32)r.x0);
+    return r.x0 == 1;
 }
 
