+/* The console maps have no generic button callback at their nodes. Their
+   controller owns a {point,index,UIReference} vector (stride 0x18). Select the
+   clicked node through that vector and the native detail/highlight refresh. */
+static int ui_map_click(UiPick* p, u32 serial) {
+    const u64 local = ui_object(p->map, ui_path_key("root.normallayer.map_dialog_mainpage"));
+    const u64 waypoint = ui_object(p->map, ui_path_key("root.normallayer.waypointmap_main"));
+    const int local_on = local && ui_visible(p->map, local);
+    const int waypoint_on = waypoint && ui_visible(p->map, waypoint);
+    if (!local_on && !waypoint_on) return 0;
+    GuestResult r;
+    u64 focus_key, focus;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) || !read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX && (!(focus = ui_object(p->map, focus_key)) ||
+        !ui_visible(p->map, focus) ||
+        !((local_on && ui_within(p->map, focus, local)) ||
+          (waypoint_on && ui_within(p->map, focus, waypoint))))) return 0;
+
+    /* Region / Act / World tabs are navigation group 8, not character tabs. */
+    if (p->point[1] >= 39 && p->point[1] < 63) {
+        static const float rects[3][2] = {{125,375},{357,607},{636,792}};
+        static const u64 opens[3] = {0x83EC6C0,0x823E1E0,0x823E7A0};
+        static const u64 closes[3] = {0x83EC8E0,0x823E760,0x823E9D0};
+        int target = -1;
+        float best = FLT_MAX;
+        for (unsigned i = 0; i < 3; i++) {
+            float d = fabsf(p->point[0] - (rects[i][0] + rects[i][1]) * .5f);
+            if (p->point[0] >= rects[i][0] && p->point[0] < rects[i][1] && d < best) {
+                best = d; target = (int)i;
+            }
+        }
+        u64 holder, nav, group, active, data, n;
+        u32 player, enabled;
+        if (target >= 0 && read64(0x9152080, &holder) && read64(holder, &nav) &&
+            read64(nav + 8 * 8, &group) && read64(nav + 0x108, &active) && group == active &&
+            read64(group, &data) && read64(group + 8, &n) && n == 3 &&
+            read32(group + 0x1C, &player) && player == 0) {
+            for (unsigned i = 0; i < 3; i++) {
+                u64 open, close;
+                if (!read64(data + i * 24, &open) || open != opens[i] ||
+                    !read64(data + i * 24 + 8, &close) || close != closes[i]) return 0;
+            }
+            if (!read32(data + target * 24 + 16, &enabled) || enabled != 1) return 1;
+            const u64 args[] = {8, (unsigned)target, 0, 0};
+            int ok = guest_call(p->cpu, 0x816F550, args, 4, NULL, 0, NULL);
+            LOG("native: map tab %u target=%d -> %s\n", serial, target, ok ? "returned" : "incomplete");
+            return 1;
+        }
+    }
+    if (!waypoint_on) return 0;
+    u64 state, data, count;
+    u32 player;
+    if (!read64(0x9154E30, &state) || !read64(state + 0x28, &data) ||
+        !read64(state + 0x30, &count) || !count || count > 256 ||
+        !read32(state + 0x20, &player) || player != 0) return 0;
+    int target = -1;
+    float best = 32.0f;
+    for (unsigned i = 0; i < count; i++) {
+        u64 key, obj, vt;
+        u32 index;
+        float point[2];
+        const u64 row = data + i * 24;
+        if (!readable(row, 24) || !read32(row + 8, &index) || index != i ||
+            !read64(row + 16, &key) || !(obj = ui_object(p->map, key)) ||
+            !read64(obj, &vt) || vt != 0x90AF208 || !ui_visible(p->map, obj) ||
+            !ui_within(p->map, obj, waypoint) || !ui_inside(p, obj)) continue;
+        memcpy(point, GP(row), sizeof point);
+        if (!isfinite(point[0]) || !isfinite(point[1])) continue;
+        const float distance = hypotf(p->point[0] - point[0], p->point[1] - point[1]);
+        if (distance < best) { best = distance; target = (int)i; }
+    }
+    if (target < 0) return 0;
+    /* These are controller selection fields, not the UI focus. They mirror
+       the native map navigation branch at 0x823DF98..0x823DFE0. */
+    const u64 args[] = {(unsigned)target};
+    if (!guest_call(p->cpu, 0x800F9F0, NULL, 0, NULL, 0, &r)) return 1;
+    *(u32*)GP(state + 0x44) = (u32)target;
+    *(u32*)GP(state + 0x50) = (u32)r.x0;
+    *(u32*)GP(state + 0x48) = 1;
+    int ok = guest_call(p->cpu, 0x823EF60, args, 1, NULL, 0, NULL);
+    if (guest_call(p->cpu, 0x8170BD0, NULL, 0, NULL, 0, &r)) {
+        const u64 dirty[] = {r.x0, 1};
+        guest_call(p->cpu, 0x81C0B80, dirty, 2, NULL, 0, NULL);
+    }
+    LOG("native: map node %u index=%d distance=%.2f -> %s\n", serial, target, best,
+        ok ? "returned" : "incomplete");
+    return 1;
+}
