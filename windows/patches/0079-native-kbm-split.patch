+static int submit_ground_attack(const CPU* cpu, u64 player_object, const WorldPos* player,
+                                const WorldPos* point) {
+    const u64 record = g_stack_top - 0x1CB00, path = record + 0x14;
+    u32* words = (u32*)GP(record);
+    WorldPos aim = *point;
+    memset(GP(record), 0, 0x80);
+    words[0] = 0xFFFFFFFFu;
+    words[1] = words[2] = ATTACK_POWER;
+    words[3] = 0;
+    words[4] = 0xFFFFFFFFu;
+    aim.z = player->z + 4.37f;
+    memcpy(GP(record + 0x60), &aim, sizeof aim);
+    u64 build[] = {path, record + 0x60};
+    if (!guest_call(cpu, PATH_POS_PC, build, 2, NULL, 0, NULL)) return 0;
+    u32 type, id;
+    if (!kbm_read32(path, &type) || !kbm_read32(path + 4, &id) || type != 2 || id != 0xFFFFFFFFu) {
+        LOG("native: stand-still path mismatch type %u id %08x\n", type, id);
+        return 0;
+    }
+    u64 submit[] = {player_object, record, 1, 1};
+    GuestResult r;
+    if (!guest_call(cpu, ACTION_PC, submit, 4, NULL, 0, &r)) return 0;
+    LOG("native: stand-still attack power %d at (%.2f,%.2f,%.2f) -> %d\n", (int)ATTACK_POWER,
+        aim.x, aim.y, aim.z, (int)(u32)r.x0);
+    return (u32)r.x0 == 1;
+}
