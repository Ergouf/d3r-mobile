-static int context(const CPU* cpu, u64* ctx) {
-    u64 holder, object, block;
-    u32 slot;
-    return read64(0x914F8D0, &holder) && read64(holder, &object) &&
-        read32(object + 12, &slot) && slot < 64 && read64(cpu->tpidrro + 0x1F8, &block) &&
-        read64(block + 0x80 + slot * 8, ctx) && *ctx;
-}
-static int lookup(u64 table, u32 handle, u32 stride, u64* entry) {
-    u32 limit, shift, found;
-    u64 buckets, bucket;
-    u32 index = handle & 0xFFFF;
-    if (handle == 0xFFFFFFFFu || !read32(table + 0x100, &limit) || index >= limit ||
-        !read32(table + 0x168, &shift) || shift > 16 || !read64(table + 0x120, &buckets) ||
-        !read64(buckets + ((u64)index >> shift) * 8, &bucket) || !bucket) return 0;
-    *entry = bucket + (index & ((1u << shift) - 1)) * (u64)stride;
-    return read32(*entry, &found) && found == handle;
-}
-static int local_player(const CPU* cpu, u32* actor, u64* entity, u64* controller, WorldPos* pos,
