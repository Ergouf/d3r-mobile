-/* Assisted target: let the game's own A targeting (0x80D5AF0) choose the
-   nearest usable interactable, then accept it only when its projection is
-   within a tight radius of the click and the ray reaches it before the
-   terrain.  This is a guard on the game's selection, never a projected-nearest
-   pick of its own; an empty click still becomes a walk, not a guessed action. */
-#define ASSIST_RADIUS 14.0f
-#define ASSIST_GATE_DISTANCE 8.0f
-/* A click on a thin object farther than the gate still names that object: walk
-   to it and ask the game once more when close.  The cap only limits how far a
-   click may name an object; whether a click names one at all is decided by the
-   gate below (interactive power, same place, and its projection within
-   ASSIST_RADIUS of the click). */
-#define ASSIST_RETRY_DISTANCE 120.0f
-
-/* Coarse gate before calling the game's A selection: a writable, interactive
-   actor must be within `distance_limit` world units and ASSIST_RADIUS screen
-   pixels of the click, must not be the local player, and must have a positive
-   operate power.  The gate only decides whether to ask the game; it never picks
-   the target.  The nearest such candidate (screen distance) is returned in
-   `found`. */
-static int assist_candidate_near(const CPU* cpu, u64 table, const WorldPos* pos,
-                                 const int pixel[2], float distance_limit, WorldPos* found,
-                                 u32* found_id, u32 player_actor) {
-    u32 limit, shift;
-    u64 buckets;
-    float best = ASSIST_RADIUS;
-    int hit = 0;
-    if (!read32(table + 0x100, &limit) || !read32(table + 0x168, &shift) || shift > 16 ||
-        limit > 65536 || !read64(table + 0x120, &buckets)) return 0;
-    for (u32 i = 0; i < limit; i++) {
-        u64 bucket, entry;
-        u32 id, place, cid;
-        float p[3], base[2], top[2];
-        if (!read64(buckets + ((u64)i >> shift) * 8, &bucket) || !bucket) continue;
-        entry = bucket + (u64)(i & ((1u << shift) - 1)) * ENTITY_STRIDE;
-        if (!read32(entry, &id) || !id || id == 0xFFFFFFFFu || id == player_actor ||
-            !read32(entry + 0xA0, &place) || place != pos->place ||
-            !read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu || !readable(entry + 0x60, 12))
-            continue;
-        memcpy(p, GP(entry + 0x60), sizeof p);
-        if (hypotf(p[0] - pos->x, p[1] - pos->y) > distance_limit) continue;
-        /* Only an actor the game itself gives an operate power to can be a
-           retry target; a decoration or the player never arms one. */
-        u64 cap_args[1] = {entry};
-        GuestResult cap;
-        if (!guest_call(cpu, CAP_POWER_PC, cap_args, 1, NULL, 0, &cap) || (i32)cap.x0 <= 0 ||
-            (u32)cap.x0 == ASSIST_ACTION) continue;
-        if (!project_point(cpu, place, p[0], p[1], p[2], base)) continue;
-        float height = 0;
-        if (readable(entry + 0x80, 20)) {
-            float cylinder[5];
-            memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
-            if (isfinite(cylinder[4]) && cylinder[4] > 0 && cylinder[4] < 4) height = cylinder[4];
-        }
-        if (!project_point(cpu, place, p[0], p[1], p[2] + height, top)) {
-            top[0] = base[0]; top[1] = base[1];
-        }
-        float y0 = fminf(base[1], top[1]), y1 = fmaxf(base[1], top[1]);
-        float cy = pixel[1] < y0 ? y0 : (pixel[1] > y1 ? y1 : pixel[1]);
-        float dx = pixel[0] - (base[0] + top[0]) * 0.5f;
-        float d = hypotf(dx, pixel[1] - cy);
-        if (d > best) continue;
-        best = d;
-        if (found) *found = (WorldPos){p[0], p[1], p[2], place};
-        if (found_id) *found_id = id;
-        hit = 1;
-    }
-    return hit;
-}
