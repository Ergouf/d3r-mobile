-static int ui_close_tick(const CPU* cpu, u64 map, u64 manager) {
-    UiCloseTarget current = {0}, pending;
-    int scope = ui_close_target(cpu, map, manager, &current);
-    pm_lock(&g_pointer_lock);
-    pending = g_close_pending;
-    g_close_pending = (UiCloseTarget){0};
-    g_close_target = current;
-    g_close_scope = scope;
-    pm_unlock(&g_pointer_lock);
-    if (!pending.kind || (u32)((u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED) - pending.frame) > 4 ||
-        pending.kind != current.kind || pending.owner != current.owner ||
-        pending.context != current.context || pending.model != current.model ||
-        pending.generation != current.generation || pending.mode != current.mode) return 0;
-    u64 callback, args[2] = {0, 0};
-    unsigned count;
-    if (current.kind == UI_CLOSE_SERVICE) {
-        /* Native navigation-stack close, also used by the service's Back branch. */
-        callback = 0x816BB90; args[0] = 1; count = 2;
-    } else if (current.kind == UI_CLOSE_CONVERSATION) {
-        /* Native cancel hides both conversation roots and sends end-conversation. */
-        callback = 0x820EF90; args[0] = current.owner + 0x30; count = 2;
-    } else {
-        /* Native prompt cancel; never invoke its accept callback 0x816AAB0. */
-        callback = 0x816A9C0; count = 0;
-    }
-    int complete = guest_call(cpu, callback, args, count, NULL, 0, NULL);
-    LOG("native: UI Space close kind=%u owner=%llx -> %s\n", current.kind,
-        (unsigned long long)current.owner, complete ? "returned" : "incomplete");
-    native_world_cancel();
-    return 1; /* A close attempt consumes this frame's stale clicks and motion. */
-}
