-/* Screen pixel -> engine camera ray, through the renderer's presentation rect. */
-static int pointer_pixel(const CPU* cpu, const PointerPress* p, int pixel[2]) {
-    const u64 rect_address = g_stack_top - 0x20000;
-    int rect[4];
-    u64 args[3] = {rect_address, 0, 0};
-    if (!guest_call(cpu, 0x8042940, args, 1, NULL, 0, NULL)) return 0;
-    memcpy(rect, GP(rect_address), sizeof rect);
-    if (rect[2] <= rect[0] || rect[3] <= rect[1]) return 0;
-    /* Match the renderer's centered, aspect-preserving presentation rectangle. */
-    u32 dw = p->width, dh = (u32)((u64)p->width * (rect[3] - rect[1]) / (rect[2] - rect[0]));
-    if (dh > p->height) {
-        dh = p->height;
-        dw = (u32)((u64)p->height * (rect[2] - rect[0]) / (rect[3] - rect[1]));
-    }
-    if (!dw || !dh) return 0;
-    float x = (p->x * p->width - (p->width - dw) / 2) / dw;
-    float y = (p->y * p->height - (p->height - dh) / 2) / dh;
-    if (x < 0 || y < 0 || x >= 1 || y >= 1) return 0;
