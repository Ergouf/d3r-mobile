-                !read64(owner + 0x118, &callbacks) ||
-                !read64(callbacks + 0x20, &callback) || callback != 0x816AAB0) continue;
-            *target = (UiCloseTarget){owner, navigation, model, UI_CLOSE_PROMPT, generation, style, 0};
