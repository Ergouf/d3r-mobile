+static int ui_service_action_click(UiPick* p, u32 serial) {
+    static const char craft[] = "\xE6\x89\x93\xE9\x80\xA0";
+    static const char salvage[] = "\xE5\x88\x86\xE8\xA7\xA3";
+    static const char repair[] = "\xE4\xBF\xAE\xE5\xA4\x8D";
+    static const char train[] = "\xE8\xAE\xAD\xE7\xBB\x83";
+    static const char select[] = "\xE9\x80\x89\xE6\x8B\xA9";
+    static const char combine[] = "\xE5\x90\x88\xE6\x88\x90";
+    static const char socket[] = "\xE9\x95\xB6\xE5\xAD\x94";
+    static const char remove[] = "\xE7\xA7\xBB\xE9\x99\xA4";
+    static const char cont[] = "\xE7\xBB\xA7\xE7\xBB\xAD";
+    static const char affix_list[] = "\xE6\x9F\xA5\xE7\x9C\x8B\xE5\x8F\xAF\xE6\x9B\xBF\xE6\x8D\xA2\xE7\x9A\x84\xE5\xB1\x9E\xE6\x80\xA7";
+    static const char enchant[] = "\xE9\x99\x84\xE9\xAD\x94";
+    static const char accept[] = "\xE6\x8E\xA5\xE5\x8F\x97";
+    static const char cancel[] = "\xE5\x8F\x96\xE6\xB6\x88";
+    static const char transmog[] = "\xE5\xB9\xBB\xE5\x8C\x96";
+    UiServiceState service = {0};
+    u64 global, world, manager, footer, vtable, method, thunk, expected_method, focus_key, focus;
+    const char* label;
+    const char* name;
+    u32 player, action, group;
+    int pick_label = 0, mystic_enchant = 0, mystic_transmog = 0;
+    float rect[4];
+    GuestResult r;
+    if (!ui_service_state(p->map, &service) || !kbm_read64(service.controller, &vtable) ||
+        !kbm_read32(service.controller + 0xC, &player) || player != 0 ||
+        !kbm_read64(0x914F840, &global) || !kbm_read64(global + 0x10, &world) ||
+        !kbm_read64(world + 0xB80, &manager) || !ui_wheel_allowed(p, manager)) return 0;
+    group = service.spec->group;
+    if (group == 5) {
+        thunk = 0x8419000; expected_method = 0x84154A0; name = "blacksmith";
+        if (service.current == 0) { label = craft; action = 0; }
+        else if (service.current == 2) { label = salvage; action = 0; }
+        else if (service.current == 3) { label = repair; action = 0; } /* A: repair */
+        else if (service.current == 4) { label = train; action = 0; }
+        else return 0;
+    } else if (group == 6 && service.current == 3) {
+        thunk = 0x8427580; expected_method = 0x8425970; name = "jeweler";
+        label = train; action = 0;
+    } else if (group == 6 && service.current <= 2) {
+        /* The combine/socket/remove pages change their first footer action
+           with the UI state: pick a gem, confirm, then apply/continue. */
+        thunk = 0x8427580; expected_method = 0x8425970; name = "jeweler";
+        label = select; action = 0; pick_label = 1;
+    } else if (group == 7 && service.current == 0) {
+        /* Item selection uses the controller thunk; the affix list and the
+           final prompt only expose native A. */
+        thunk = 0x81DF930; expected_method = 0x81DCA90; name = "mystic";
+        label = select; action = 0; mystic_enchant = 1;
+    } else if (group == 7 && service.current == 1) {
+        /* The transmog page exposes its item/appearance selection and the
+           final confirm only through native A (keyboard Down moves the list). */
+        thunk = 0x81DF930; expected_method = 0x81DCA90; name = "mystic";
+        label = select; action = 0; mystic_transmog = 1;
+    } else if (group == 7 && service.current == 3) {
+        thunk = 0x81DF930; expected_method = 0x81DCA90; name = "mystic";
+        label = train; action = 0;
+    } else return 0;
+    if (!kbm_read64(vtable + 0x48, &method) || method != expected_method) return 0;
+    footer = ui_object(p->map, ui_path_key(
+        "root.normallayer.consolebuttonlegend_main.layoutroot.buttonlegend"));
+    if (!footer || !ui_visible(p->map, footer) || !ui_inside(p, footer) ||
+        !kbm_readable(footer + 0x88, sizeof rect)) return 0;
+    memcpy(rect, GP(footer + 0x88), sizeof rect);
+    if (p->point[0] > rect[0] + 240.0f) return 0;
+    if (mystic_enchant) {
+        if (ui_text_contains(footer, affix_list) || ui_text_contains(footer, enchant) ||
+            ui_text_contains(footer, accept) || ui_text_contains(footer, cancel)) {
+            int queued = native_action_press(1);
+            LOG("native: UI mystic enchant footer %u -> %s\n", serial,
+                queued ? "queued" : "rejected");
+            return queued ? 1 : 0;
+        }
+        if (!ui_text_contains(footer, select)) return 0;
+    }
+    if (mystic_transmog) {
+        if (ui_text_contains(footer, select) || ui_text_contains(footer, transmog) ||
+            ui_text_contains(footer, accept) || ui_text_contains(footer, cancel)) {
+            int queued = native_action_press(1);
+            LOG("native: UI mystic transmog footer %u -> %s\n", serial,
+                queued ? "queued" : "rejected");
+            return queued ? 1 : 0;
+        }
+        return 0;
+    }
+    if (pick_label) {
+        /* Each jeweller page exposes only its own first-action labels. */
+        if (ui_text_contains(footer, select)) label = select;
+        else if (ui_text_contains(footer, cont)) label = cont;
+        else if (service.current == 0 && ui_text_contains(footer, combine)) label = combine;
+        else if (service.current == 1 && ui_text_contains(footer, socket)) label = socket;
+        else if (service.current == 2 && ui_text_contains(footer, remove)) label = remove;
+        else return 0;
+    } else if (!ui_text_contains(footer, label)) return 0;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !kbm_read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX &&
+        (!(focus = ui_object(p->map, focus_key)) || !ui_visible(p->map, focus) ||
+         !ui_within(p->map, focus, service.page))) return 0;
+    u64 args[3] = {service.page, player, action};
+    int complete = guest_call(p->cpu, thunk, args, 3, NULL, 0, NULL);
+    LOG("native: UI %s footer page=%u action=%u %u -> %s\n", name, service.current, action,
+        serial, complete ? "returned" : "incomplete");
+    return 1;
+}
