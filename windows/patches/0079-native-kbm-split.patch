-static int ui_tab_state(u64 map, UiTabState* state) {
-    static const char* paths[5] = {
-        "root.normallayer.consoleinventoryring_main",
-        "root.normallayer.consoleskillselection_main",
-        "root.normallayer.consoleparagon_main",
-        "root.normallayer.consoleparty_main",
-        "root.normallayer.consolejournal_main",
-    };
-    u64 holder, navigation, first, data, count;
-    u32 selected, player;
-    if (!read64(0x9152080, &holder) || !read64(holder, &navigation) ||
-        !read64(navigation, &first) || !read64(navigation + 0x108, &state->group) ||
-        !first || state->group != first || !read64(first, &data) ||
-        !read64(first + 8, &count) || count != 6 ||
-        !read32(first + 0x18, &selected) || selected >= 6 ||
-        !read32(first + 0x1C, &player) || player != 0) return 0;
-    for (unsigned i = 0; i < 6; i++)
-        if (!read32(data + i * 0x18 + 0x10, &state->enabled[i]) || state->enabled[i] > 1) return 0;
-    int visible = 0;
-    state->current = -1;
-    for (unsigned i = 0; i < 5; i++) {
-        u64 open, close, page;
-        const UiTabSpec* tab = &g_ui_tabs[i];
-        if (!read64(data + tab->slot * 0x18, &open) || open != tab->open ||
-            !read64(data + tab->slot * 0x18 + 8, &close) || close != tab->close) return 0;
-        page = ui_object(map, ui_path_key(paths[i]));
-        if (page && ui_visible(map, page)) {
-            visible++;
-            if (selected != tab->slot) return 0;
-            state->current = (int)i;
-            state->page = page;
-        }
-    }
-    return visible == 1 && state->current >= 0;
-}
