-static void ui_build_children(u64 map) {
-    u32 mask, total;
-    u64 buckets, node;
-    g_ui_child_count = 0;
-    if (!read32(map, &mask) || mask > 262143 || !read64(map + 0x10, &buckets) ||
-        !read32(map + 4, &total) || total > 262143) return;
-    for (u32 i = 0; i <= mask; i++) {
-        if (!read64(buckets + (u64)i * 8, &node) || !node) continue;
-        for (unsigned g = 0; node && g < 1024; g++) {
-            u64 next, obj, parent;
-            if (!read64(node, &next)) break;
-            if (read64(node + 0x10, &obj) && obj && read64(obj + 0x38, &parent) &&
-                parent != UINT64_MAX && g_ui_child_count < UI_CHILD_MAX)
-                g_ui_children[g_ui_child_count++] = (UiChild){parent, obj};
-            node = next;
-        }
-    }
-    if (g_ui_child_count)
-        qsort(g_ui_children, g_ui_child_count, sizeof(UiChild), ui_child_cmp);
-    if (g_ui_child_count == UI_CHILD_MAX)
-        LOG("native: UI child index truncated at %u\n", UI_CHILD_MAX);
-}
