-static int ui_tab_click(UiPick* p) {
-    UiTabState state = {0};
-    GuestResult result;
-    u64 parent = 0;
-    unsigned seen = 0, entries = 0;
-    int target = -1;
-    if (!ui_tab_state(p->map, &state)) return 0;
-    for (u32 i = 0; i < g_ui_child_count; i++) {
-        u64 obj = g_ui_children[i].obj, vt;
-        float r[4];
-        if (!read64(obj, &vt) || vt != 0x90ABB48 || !ui_visible(p->map, obj) ||
-            !ui_within(p->map, obj, state.page) || !readable(obj + 0x88, sizeof r)) continue;
-        memcpy(r, GP(obj + 0x88), sizeof r);
-        if (!isfinite(r[0]) || !isfinite(r[1]) || !isfinite(r[2]) || !isfinite(r[3]) ||
-            fabsf(r[1] - 39.0f) > 1.0f || r[2] - r[0] < 150.0f || r[2] - r[0] > 162.0f ||
-            r[3] - r[1] < 20.0f || r[3] - r[1] > 28.0f || r[0] < 89.0f || r[0] > 715.0f) continue;
-        int idx = (int)lroundf((r[0] - 90.0f) / 156.0f);
-        if (idx < 0 || idx > 4 || fabsf(r[0] - (90.0f + 156.0f * idx)) > 1.0f) continue;
-        if ((seen & (1u << idx)) || (parent && parent != g_ui_children[i].parent)) return 0;
-        parent = g_ui_children[i].parent;
-        seen |= 1u << idx;
-        entries++;
-        if (p->point[0] >= r[0] && p->point[0] < r[2] &&
-            p->point[1] >= r[1] && p->point[1] < r[3]) target = idx;
-    }
-    if (entries != 5 || seen != 0x1F || target < 0) return 0;
-    /* A modal with its own focus owns the pointer even if the page behind it
-       remains visible. Never redirect such a click into the character group. */
-    u64 focus_key, focus;
-    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &result) ||
-        !read64(result.x0, &focus_key)) return 0;
-    if (focus_key != UINT64_MAX && (!(focus = ui_object(p->map, focus_key)) ||
-        !ui_visible(p->map, focus) || !ui_within(p->map, focus, state.page))) return 0;
-    return ui_tab_select_slot(p->cpu, p->map, &state, target);
-}
