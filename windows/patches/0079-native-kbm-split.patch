+    u64 ring, ring_key, vt, holder, controller, focus_key, focus;
+    u64 selector, entries, nentries, selector_ring, cursor_key, binding;
+    u64 global, world, manager;
+    u32 count, selected, active, native_selected, enabled, rotates, group = 0;
+    GuestResult r;
+    char path[192];
+    if (ui_tab_state(p->map, &state)) {
+        if (state.current != 0 || !kbm_read64(0x9157F58, &holder) ||
+            !kbm_read64(holder, &controller) || !kbm_read64(controller, &vt) || vt != 0x90AAEE0) return 0;
+    } else {
+        UiServiceState service = {0};
+        if (!ui_service_state(p->map, &service)) return 0;
+        state.page = service.page;
+        controller = service.controller;
+        group = service.spec->group;
+        if (group == 5 && service.current < 2) {
+            active_slots = service.current == 0 ? weapons : armor;
+            nslots = service.current == 0 ? sizeof weapons / sizeof weapons[0] : sizeof armor / sizeof armor[0];
+            prefix = service.current == 0 ?
+                "root.normallayer.consoleinventoryring_main.layoutroot.artisan.blacksmithweaponsring" :
+                "root.normallayer.consoleinventoryring_main.layoutroot.artisan.blacksmitharmorring";
+        }
+    }
+    if (!(ring = ui_object(p->map, ui_path_key(prefix))) ||
+        !ui_visible(p->map, ring) || !ui_within(p->map, ring, state.page) ||
+        !kbm_read64(ring, &vt) || vt != 0x90AF208 ||
+        !kbm_read64(ring + 0x48, &binding) || binding != controller ||
+        !kbm_read64(ring + 0x30, &ring_key) ||
+        !kbm_read32(ring + 0x68, &count) || count != nslots + 1 ||
+        !kbm_read64(0x914F840, &global) || !kbm_read64(global + 0x10, &world) ||
+        !kbm_read64(world + 0xB80, &manager) || !ui_wheel_allowed(p, manager)) return 0;
+    /* The inventory page can remain visible behind another modal. */
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !kbm_read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX &&
+        (!(focus = ui_object(p->map, focus_key)) || !ui_visible(p->map, focus) ||
+         !ui_within(p->map, focus, state.page))) return 0;
+    selector = controller + 0xD0;
+    snprintf(path, sizeof path, "%s.ringglow.cursor", prefix);
+    if (!kbm_read64(selector, &entries) || !kbm_read64(selector + 8, &nentries) || nentries != nslots ||
+        !kbm_read64(selector + 0x18, &selector_ring) || selector_ring != ring_key ||
+        !kbm_read64(selector + 0x20, &cursor_key) || cursor_key != ui_path_key(path) ||
+        !kbm_read32(selector + 0x28, &native_selected) || native_selected >= nentries ||
+        !kbm_read32(selector + 0x2C, &enabled) || enabled != 1 ||
+        !kbm_read32(selector + 0x30, &rotates) || rotates != 1) return 0;
+    for (unsigned i = 0; i < nslots; i++) {
+        u64 button, parent_key, key;
+        snprintf(path, sizeof path, "%s.%s", prefix, active_slots[i].name);
+        button = ui_object(p->map, ui_path_key(path));
+        if (!button || !kbm_read64(button, &vt) || vt != 0x90AF208 ||
+            !kbm_read64(button + 0x38, &parent_key) || parent_key != ring_key ||
+            !ui_visible(p->map, button) || !ui_inside(p, button) ||
+            !kbm_read64(button + 0x30, &key)) continue;
+        if (!kbm_read32(controller + 0x18, &active) || active != 1 ||
+            !kbm_read32(controller + 0x150, &selected) || selected < active_slots[0].slot ||
+            selected > active_slots[nslots - 1].slot) {
+            LOG("native: UI equipment icon %u blocked (%s), fall through\n", serial, active_slots[i].name);
+            return 0;
+        }
+        u32 native_slot = UINT32_MAX;
+        for (u32 j = 0; j < nentries; j++) {
+            u64 entry_key;
+            if (!kbm_read64(entries + (u64)j * 16 + 8, &entry_key)) return 0;
+            if (entry_key == key) {
+                if (native_slot != UINT32_MAX) return 0;
+                native_slot = j;
+            }
+        }
+        if (native_slot == UINT32_MAX) return 0;
+        if (selected == active_slots[i].slot && native_selected == native_slot) {
+            if (!p->hover) LOG("native: UI equipment icon %u unchanged (%s)\n", serial, active_slots[i].name);
+            return 1;
+        }
+        /* The native callback clears the old icon, highlights the new icon and
+           dispatches its mapped category through this ring's bound controller. */
+        u64 args[3] = {selector, button + 0x30, 0x81FC6C0};
+        int complete = guest_call(p->cpu, 0x838F650, args, 3, NULL, 0, NULL);
+        int changed = complete && kbm_read32(selector + 0x28, &native_selected) &&
+            native_selected == native_slot && kbm_read32(controller + 0x150, &selected) &&
+            selected == active_slots[i].slot;
+        LOG("native: UI %sequipment icon %u %s group=%u slot=%u -> %s\n", p->hover ? "hover " : "", serial,
+            active_slots[i].name, group, active_slots[i].slot, changed ? "selected" : "incomplete");
+        return 1;
+    }
+    return 0;
+}
+
+/* The skill wheel's category icons have no click callback.  The game's
+   angular selector at controller+0x168 owns the wheel; 0x838F4D0(selector,
+   &child_key, 0) changes the selector's +0x28 immediately; controller+0x1CC
+   is a deferred mirror and is not checked.  The right-side
+   category title/description follows the selector; the equipped skill
+   name/info pane is not the selector's state. */
+static int ui_skill_icon(UiPick* p, u32 serial) {
+    UiTabState state = {0};
+    GuestResult r;
+    u64 ring, ring_key, vt, children, holder, controller, selector;
+    u64 entries, nentries, focus_key, focus, callback;
+    u32 count, selected;
+    if (!ui_tab_state(p->map, &state) || state.current != 1 ||
+        !(ring = ui_object(p->map, ui_path_key(
+            "root.normallayer.consoleskillselection_main.layoutroot.skillloadout"))) ||
+        !ui_visible(p->map, ring) || !ui_within(p->map, ring, state.page) ||
+        !kbm_read64(ring, &vt) || vt != 0x90AF208 ||
+        !kbm_read64(ring + 0x30, &ring_key) ||
+        !kbm_read64(ring + 0x60, &children) ||
+        !kbm_read32(ring + 0x68, &count) || count != 14) return 0;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !kbm_read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX &&
+        (!(focus = ui_object(p->map, focus_key)) || !ui_visible(p->map, focus) ||
+         !ui_within(p->map, focus, state.page))) return 0;
+    if (!kbm_read64(0x9158040, &holder) || !kbm_read64(holder, &controller) ||
+        !kbm_read64(0x9158068, &callback) || callback != 0x83848A0) return 0;
+    selector = controller + 0x168;
+    if (!kbm_read64(selector, &entries) || !kbm_read64(selector + 8, &nentries) ||
+        nentries != 11 || !kbm_read32(selector + 0x28, &selected) || selected >= nentries)
+        return 0;
+    for (u32 i = 3; i < 14; i++) {
+        u64 child, parent_key, key;
+        if (!kbm_read64(children + (u64)i * 24 + 8, &child) || !child ||
+            !kbm_read64(child, &vt) || (vt != 0x90ABB48 && vt != 0x90AF208) ||
+            !kbm_read64(child + 0x38, &parent_key) || parent_key != ring_key ||
+            !ui_visible(p->map, child) || !ui_inside(p, child) ||
+            !kbm_read64(child + 0x30, &key)) continue;
+        for (u32 j = 0; j < nentries; j++) {
+            u64 entry_key;
+            if (!kbm_read64(entries + (u64)j * 16 + 8, &entry_key) ||
+                entry_key != key) continue;
+            if (selected == j) {
+                if (!p->hover) LOG("native: UI skill icon %u unchanged slot=%u\n", serial, j);
+                return 1;
+            }
+            u64 args[3] = {selector, child + 0x30, callback};
+            int complete = guest_call(p->cpu, 0x838F650, args, 3, NULL, 0, NULL);
+            int changed = complete && kbm_read32(selector + 0x28, &selected) &&
+                selected == j;
+            LOG("native: UI %sskill icon %u slot=%u -> %s\n", p->hover ? "hover " : "", serial, j,
+                changed ? "selected" : "incomplete");
+            return 1;
+        }
+        LOG("native: UI skill icon %u blocked child=%u\n", serial, i);
+        return 1;
+    }
+    return 0;
+}
+
+/* A wheel can stay visible behind a modal. Require its own subscribed callback
+   owner and reject other input layers/owners before checking the selector. */
+
+
+/* Motion selects only the hovered wheel icon. Lists, buttons and page tabs keep
+   their click semantics. No full-registry child index is needed for a wheel. */
+static int ui_item_hover(UiPick* p);
+
+void ui_hover(const CPU* cpu, const HoverPoint* hover) {
+    UiPick p = {.cpu = cpu, .hover = 1};
+    PointerPress press = {hover->x, hover->y, hover->width, hover->height, 0, 0, hover->frame};
+    const u64 scratch = g_stack_top - 0x1A000;
+    u64 global, world, manager;
+    int pixel[2];
+    if ((u32)((u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED) - hover->frame) > 4 ||
+        !pointer_pixel(cpu, &press, pixel) || !kbm_read64(0x914F840, &global) ||
+        !kbm_read64(global + 0x10, &world) || !kbm_read64(world + 0xB80, &manager) ||
+        !kbm_read64(manager, &p.map) || !ui_wheel_allowed(&p, manager)) return;
+    memcpy(GP(scratch), pixel, sizeof pixel);
+    u64 args[3] = {scratch, scratch + 0x20};
+    if (!guest_call(cpu, 0x8350BF0, args, 2, NULL, 0, NULL)) return;
+    memcpy(p.point, GP(scratch + 0x20), sizeof p.point);
+    if (!isfinite(p.point[0]) || !isfinite(p.point[1])) return;
+    if (ui_item_hover(&p)) return;
+    if (ui_equipment_icon(&p, 0)) return;
+    ui_skill_icon(&p, 0);
+}
+
+/* A prompt button carries its own label; 取消 is not always the right-hand
+   button, so the pad bit follows the text when it is kbm_readable. */
+static int ui_button_bit(u64 obj) {
+    static const char accept_lbl[] = "\xE6\x8E\xA5\xE5\x8F\x97"; /* 接受 */
+    static const char cancel_lbl[] = "\xE5\x8F\x96\xE6\xB6\x88"; /* 取消 */
+    u64 ptr;
+    u32 cap;
+    char txt[128];
+    unsigned len;
+    if (!kbm_read64(obj + 0x398, &ptr) || !kbm_read32(obj + 0x3A0, &cap) || !ptr || !cap || cap > 256 ||
+        !kbm_readable(ptr, cap)) return -1;
+    len = cap < sizeof txt - 1 ? cap : sizeof txt - 1;
+    memcpy(txt, GP(ptr), len);
+    txt[len] = 0;
+    if (strstr(txt, accept_lbl)) return 0;
+    if (strstr(txt, cancel_lbl)) return 1;
+    return -1;
+}
+
+/* The console prompt's two buttons are text widgets without a +0x118
+   callback; the game handles the prompt through A/B. A pointer click on the
+   observed fixed-shape button bar forwards to the game's own B/A action. */
+static int ui_dialog_buttons(UiPick* p, u32 serial) {
+    for (size_t i = 0; i < g_ui_child_count; i++) {
+        u64 bar = g_ui_children[i].obj, vt, data, parent_key, root, rvt;
+        u32 count;
+        float br[4], rr[4];
+        if (!bar || !kbm_read64(bar, &vt) || vt != 0x90AE3D8) continue;
+        if (!kbm_read32(bar + 0x68, &count) || count != 2 || !kbm_read64(bar + 0x60, &data)) continue;
+        if (!ui_visible(p->map, bar) || !kbm_readable(bar + 0x88, 16)) continue;
+        memcpy(br, GP(bar + 0x88), sizeof br);
+        if (!(br[2] - br[0] >= 120 && br[2] - br[0] <= 150 &&
+              br[3] - br[1] >= 50 && br[3] - br[1] <= 80)) continue;
+        if (!kbm_read64(bar + 0x38, &parent_key) || !(root = ui_object(p->map, parent_key)) ||
+            !kbm_read64(root, &rvt) || rvt != 0x90AF208 || !kbm_readable(root + 0x88, 16)) continue;
+        memcpy(rr, GP(root + 0x88), sizeof rr);
+        if (!(rr[2] - rr[0] >= 540 && rr[2] - rr[0] <= 580 &&
+              rr[3] - rr[1] >= 110 && rr[3] - rr[1] <= 145)) continue;
+        /* Only the prompt that owns the input focus may answer the click.  A
+           stale prompt keeps its widgets on screen; forwarding A/B there would
+           reply to a question the player is no longer being asked. */
+        {
+            u64 focus_key, focus;
+            GuestResult fr;
+            if (guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &fr) &&
+                kbm_read64(fr.x0, &focus_key) && focus_key != UINT64_MAX &&
+                (focus = ui_object(p->map, focus_key)) && !ui_within(p->map, focus, root))
+                continue;
+        }
+        u64 button[2] = {0, 0};
+        int seen = 0;
+        for (u32 j = 0; j < 2; j++) {
+            u64 child, cvt;
+            u32 flags;
+            if (!kbm_read64(data + (u64)j * 24ull + 8, &child) || !child ||
+                !kbm_read64(child, &cvt) || cvt != 0x90ABB48 ||
+                !kbm_read32(child + 0x18, &flags) || !(flags & 4) ||
+                !kbm_readable(child + 0x88, 16)) continue;
+            button[seen++] = child;
+        }
+        if (seen != 2) continue;
+        float ax = *(float*)GP(button[0] + 0x88);
+        float bx = *(float*)GP(button[1] + 0x88);
+        u64 left = ax <= bx ? button[0] : button[1];
+        u64 right = ax <= bx ? button[1] : button[0];
+        int left_inside = ui_inside(p, left);
+        int right_inside = ui_inside(p, right);
+        if (!left_inside && !right_inside) continue;
+        int left_bit = ui_button_bit(left), right_bit = ui_button_bit(right);
+        u64 pad;
+        const char* how;
+        if (left_bit >= 0 && right_bit >= 0 && left_bit != right_bit)
+            pad = 1ull << (right_inside ? right_bit : left_bit), how = "label";
+        else
+            pad = right_inside ? (1ull << 0) : (1ull << 1), how = "side";
+        int queued = native_action_press(pad);
+        LOG("native: UI dialog button %u %s bar=%llx root=%llx via %s -> %s\n",
+            serial, (pad & 1) ? "confirm(A)" : "cancel(B)",
+            (unsigned long long)bar, (unsigned long long)root, how,
+            queued ? "queued" : "rejected");
+        return 1;
+    }
+    return 0;
+}
+
+
+static int ui_footer_legend_click(UiPick* p, u32 serial) {
+    u64 footer, pointer;
+    u32 capacity;
+    char text[512];
+    char names[8][12];
+    unsigned hints = 0;
+    float rect[4];
+    footer = ui_object(p->map, ui_path_key(
+        "root.normallayer.consolebuttonlegend_main.layoutroot.buttonlegend"));
+    if (!footer || !ui_visible(p->map, footer) || !ui_inside(p, footer) ||
+        !kbm_readable(footer + 0x88, sizeof rect) ||
+        !kbm_read64(footer + 0x398, &pointer) || !kbm_read32(footer + 0x3A0, &capacity) ||
+        !pointer || !capacity || capacity > 1024 || !kbm_readable(pointer, capacity)) return 0;
+    memcpy(rect, GP(footer + 0x88), sizeof rect);
+    unsigned length = capacity < sizeof text - 1 ? capacity : sizeof text - 1;
+    memcpy(text, GP(pointer), length);
+    text[length] = 0;
+    if (footer == g_footer_object && !strcmp(text, g_footer_display))
+        memcpy(text, g_footer_original, strlen(g_footer_original) + 1);
+    for (const char* at = text; hints < 8 && (at = strstr(at, "{icon:"));) {
+        unsigned n = 0;
+        at += 6;
+        while (*at && *at != ',' && *at != '}' && n + 1 < sizeof names[0]) names[hints][n++] = *at++;
+        names[hints][n] = 0;
+        while (*at && *at != '}') at++;
+        if (*at == '}') at++;
+        if (!n || strstr(names[hints], "_label")) continue;
+        hints++;
+    }
+    if (!hints) return 0;
+    int cell = (int)((p->point[0] - rect[0]) / 240.0f);
+    if (cell < 0) return 0;
+    if ((float)hints * 240.0f > (rect[2] - rect[0]) + 8.0f) {
+        /* Geometry not understood: keep the original leftmost-hint behaviour. */
+        if (cell) return 0;
+        cell = 0;
+    } else if ((unsigned)cell >= hints) {
+        return 0;
+    }
+    const char* name = names[cell];
+    u64 pad = 0;
+    if (!strcmp(name, "button1")) pad = 1ull << 0;
+    else if (!strcmp(name, "button2")) pad = 1ull << 1;
+    else if (!strcmp(name, "button3")) pad = 1ull << 2;
+    else if (!strcmp(name, "button4")) pad = 1ull << 3;
+    else if (!strcmp(name, "l3")) pad = 1ull << 4;
+    else if (!strcmp(name, "l2")) pad = 1ull << 8;
+    else if (!strcmp(name, "r2")) pad = 1ull << 9;
+    if (!pad) return 0;
+    int queued = native_action_press(pad);
+    LOG("native: UI footer legend %u %s -> %s\n", serial, name,
+        queued ? "queued" : "rejected");
+    return queued ? 1 : 0;
+}
+
+/* The console maps have no generic button callback at their nodes. Their
+   controller owns a {point,index,UIReference} vector (stride 0x18). Select the
+   clicked node through that vector and the native detail/highlight refresh. */
+static int ui_map_click(UiPick* p, u32 serial) {
+    const u64 local = ui_object(p->map, ui_path_key("root.normallayer.map_dialog_mainpage"));
+    const u64 waypoint = ui_object(p->map, ui_path_key("root.normallayer.waypointmap_main"));
+    const int local_on = local && ui_visible(p->map, local);
+    const int waypoint_on = waypoint && ui_visible(p->map, waypoint);
+    if (!local_on && !waypoint_on) return 0;
+    GuestResult r;
+    u64 focus_key, focus;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) || !kbm_read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX && (!(focus = ui_object(p->map, focus_key)) ||
+        !ui_visible(p->map, focus) ||
+        !((local_on && ui_within(p->map, focus, local)) ||
+          (waypoint_on && ui_within(p->map, focus, waypoint))))) return 0;
+
+    /* Region / Act / World tabs are navigation group 8, not character tabs. */
+    if (p->point[1] >= 39 && p->point[1] < 63) {
+        static const float rects[3][2] = {{125,375},{357,607},{636,792}};
+        static const u64 opens[3] = {0x83EC6C0,0x823E1E0,0x823E7A0};
+        static const u64 closes[3] = {0x83EC8E0,0x823E760,0x823E9D0};
+        int target = -1;
+        float best = FLT_MAX;
+        for (unsigned i = 0; i < 3; i++) {
+            float d = fabsf(p->point[0] - (rects[i][0] + rects[i][1]) * .5f);
+            if (p->point[0] >= rects[i][0] && p->point[0] < rects[i][1] && d < best) {
+                best = d; target = (int)i;
+            }
+        }
+        u64 holder, nav, group, active, data, n;
+        u32 player, enabled;
+        if (target >= 0 && kbm_read64(0x9152080, &holder) && kbm_read64(holder, &nav) &&
+            kbm_read64(nav + 8 * 8, &group) && kbm_read64(nav + 0x108, &active) && group == active &&
+            kbm_read64(group, &data) && kbm_read64(group + 8, &n) && n == 3 &&
+            kbm_read32(group + 0x1C, &player) && player == 0) {
+            for (unsigned i = 0; i < 3; i++) {
+                u64 open, close;
+                if (!kbm_read64(data + i * 24, &open) || open != opens[i] ||
+                    !kbm_read64(data + i * 24 + 8, &close) || close != closes[i]) return 0;
+            }
+            if (!kbm_read32(data + target * 24 + 16, &enabled) || enabled != 1) return 1;
+            const u64 args[] = {8, (unsigned)target, 0, 0};
+            int ok = guest_call(p->cpu, 0x816F550, args, 4, NULL, 0, NULL);
+            LOG("native: map tab %u target=%d -> %s\n", serial, target, ok ? "returned" : "incomplete");
+            return 1;
+        }
+    }
+    if (!waypoint_on) return 0;
+    u64 state, data, count;
+    u32 player;
+    if (!kbm_read64(0x9154E30, &state) || !kbm_read64(state + 0x28, &data) ||
+        !kbm_read64(state + 0x30, &count) || !count || count > 256 ||
+        !kbm_read32(state + 0x20, &player) || player != 0) return 0;
+    const u64 world_tab = ui_object(p->map, ui_path_key(
+        "root.normallayer.waypointmap_main.layoutroot.navigation.map.worldtab"));
+    const u64 world_map = ui_object(p->map, ui_path_key(
+        "root.normallayer.waypointmap_main.layoutroot.overlaycontainer.worldmap"));
+    if (world_tab && world_map && ui_visible(p->map, world_tab) &&
+        ui_visible(p->map, world_map)) {
+        if (count != 5 || !ui_inside(p, world_map)) return 0;
+        unsigned chapters = 0;
+        int chapter_row = -1;
+        float nearest = 40.0f;
+        for (unsigned index = 0; index < count; index++) {
+            const u64 row = data + index * 24;
+            u32 chapter;
+            float point[2];
+            if (!kbm_readable(row, 24) || !kbm_read32(row + 8, &chapter) ||
+                chapter > 400 || chapter % 100) return 0;
+            const unsigned mask = 1u << (chapter / 100);
+            if (chapters & mask) return 0;
+            chapters |= mask;
+            memcpy(point, GP(row), sizeof point);
+            if (!isfinite(point[0]) || !isfinite(point[1])) return 0;
+            const float distance = hypotf(p->point[0] - point[0], p->point[1] - point[1]);
+            if (distance < nearest) { nearest = distance; chapter_row = (int)index; }
+        }
+        if (chapters != 31 || chapter_row < 0) return 0;
+        *(u32*)GP(state + 0x44) = (u32)chapter_row;
+        const u64 select[] = {0, player};
+        int complete = guest_call(p->cpu, 0x823EB50, select, 2, NULL, 0, NULL);
+        LOG("native: world map chapter %u row=%d -> %s\n", serial, chapter_row,
+            complete ? "returned" : "incomplete");
+        return 1;
+    }
+    int target = -1;
+    float best = 32.0f;
+    for (unsigned i = 0; i < count; i++) {
+        u64 key, obj, vt;
+        u32 index;
+        float point[2];
+        const u64 row = data + i * 24;
+        /* +8 is the global waypoint id (Act V starts at 58), while the
+           controller selection and detail refresh use this act's row index. */
+        if (!kbm_readable(row, 24) || !kbm_read32(row + 8, &index) || index >= 256 ||
+            !kbm_read64(row + 16, &key) || !(obj = ui_object(p->map, key)) ||
+            !kbm_read64(obj, &vt) || vt != 0x90AF208 || !ui_visible(p->map, obj) ||
+            !ui_within(p->map, obj, waypoint) || !ui_inside(p, obj)) continue;
+        memcpy(point, GP(row), sizeof point);
+        if (!isfinite(point[0]) || !isfinite(point[1])) continue;
+        const float distance = hypotf(p->point[0] - point[0], p->point[1] - point[1]);
+        if (distance < best) { best = distance; target = (int)i; }
+    }
+    if (target < 0) return 0;
+    /* These are controller selection fields, not the UI focus. They mirror
+       the native map navigation branch at 0x823DF98..0x823DFE0. */
+    const u64 args[] = {(unsigned)target};
+    if (!guest_call(p->cpu, 0x800F9F0, NULL, 0, NULL, 0, &r)) return 1;
+    *(u32*)GP(state + 0x44) = (u32)target;
+    *(u32*)GP(state + 0x50) = (u32)r.x0;
+    *(u32*)GP(state + 0x48) = 1;
+    int ok = guest_call(p->cpu, 0x823EF60, args, 1, NULL, 0, NULL);
+    if (guest_call(p->cpu, 0x8170BD0, NULL, 0, NULL, 0, &r)) {
+        const u64 dirty[] = {r.x0, 1};
+        guest_call(p->cpu, 0x81C0B80, dirty, 2, NULL, 0, NULL);
+    }
+    LOG("native: map node %u index=%d distance=%.2f -> %s\n", serial, target, best,
+        ok ? "returned" : "incomplete");
+    return 1;
+}
+
+typedef struct {
+    u64 owner, page, player, hero, table, side[2];
+    u32 actor, category;
+    int stash;
+} UiItemContext;
+typedef struct { u32 handle, location[4]; u64 entity, control; u32 index; int side; } UiItem;
+static struct {
+    UiItem item;
+    u64 owner;
+    u32 frame;
+    float point[2];
+    int ctrl;
+} g_item_drag;
+
+/* Inventory and stash share a layout, but have separate active controllers. */
+static int ui_item_context(UiPick* p, UiItemContext* c) {
+    u64 holder, vt, nav, group, active, focus_key, focus;
+    u32 enabled, player_index;
+    GuestResult r;
+    c->stash = 0;
+    if (kbm_read64(0x9159950, &holder) && kbm_read64(holder, &c->owner) &&
+        kbm_read32(c->owner + 0x18, &enabled) && enabled == 1) c->stash = 1;
+    else if (!kbm_read64(0x9157F58, &holder) || !kbm_read64(holder, &c->owner)) return 0;
+    c->page = ui_object(p->map, ui_path_key("root.normallayer.consoleinventoryring_main"));
+    if (!c->page || !ui_visible(p->map, c->page) || !kbm_read64(c->owner, &vt) ||
+        vt != (c->stash ? 0x90B0060ull : 0x90AAEE0ull) ||
+        !kbm_read32(c->owner + 0x18, &enabled) || enabled != 1 ||
+        !kbm_read32(c->owner + 0xC, &player_index) || player_index != 0 ||
+        !kbm_read64(c->owner + 0x138, &c->side[0]) || !c->side[0] ||
+        !kbm_read64(c->owner + 0x140, &c->side[1]) || !c->side[1] ||
+        !kbm_read32(c->owner + 0x150, &c->category) || c->category > 13 ||
+        !kbm_read64(0x9152080, &holder) || !kbm_read64(holder, &nav) ||
+        !kbm_read64(nav + (c->stash ? 8 : 0), &group) ||
+        !kbm_read64(nav + 0x108, &active) || group != active) return 0;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !kbm_read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX && (!(focus = ui_object(p->map, focus_key)) ||
+        !ui_visible(p->map, focus) || !ui_within(p->map, focus, c->page))) return 0;
+    /* Reject a separate subscribed modal even if it has no focused control. */
+    u64 global, world, manager, subs, entries, normal;
+    u32 count;
+    if (!kbm_read64(0x914F840, &global) || !kbm_read64(global + 0x10, &world) ||
+        !kbm_read64(world + 0xB80, &manager) || !kbm_read64(manager + 0x10, &subs) ||
+        !kbm_read64(subs, &entries) || !kbm_read32(subs + 8, &count) || count > 1024 ||
+        !(normal = ui_object(p->map, 1))) return 0;
+    for (unsigned i = 0; i < count; i++) {
+        u64 obj, method, callbacks, cb;
+        if (!kbm_read64(entries + i * 8ull, &obj)) return 0;
+        if (!obj || !ui_visible(p->map, obj)) continue;
+        if (!ui_within(p->map, obj, normal)) return 0;
+        if (kbm_read64(obj, &vt) && kbm_read64(vt + 0xB0, &method) && method == 0x83B81F0 &&
+            kbm_read64(obj + 0x118, &callbacks) && kbm_read64(callbacks + 0x20, &cb) &&
+            ui_code(cb) && !ui_within(p->map, obj, c->page)) return 0;
+    }
+    u64 controller;
+    WorldPos pos;
+    return kbm_local_player(p->cpu, &c->actor, &c->hero, &controller, &pos, &c->player, &c->table) &&
+           kbm_actor_alive(p->cpu, c->hero);
+}
+
+static u64 ui_item_container(UiPick* p, u64 selection) {
+    u64 ref, key, obj;
+    if (!kbm_read64(selection + 0x10, &ref) || !kbm_read64(ref, &key) ||
+        !(obj = ui_object(p->map, key)) || !ui_visible(p->map, obj)) return 0;
+    return obj;
+}
+
+/* Resolve the clicked row from the native list and its real item model.
+   Neither focus nor the controller's selected item is changed here. */
+static int ui_item_pick(UiPick* p, const UiItemContext* c, UiItem* item) {
+    GuestResult r;
+    for (int side = 0; side < 2; side++) {
+        u64 selection = c->side[side], container = ui_item_container(p, selection);
+        u64 vt, model, method, array, data, count, control = 0;
+        u32 model_mode, index = UINT32_MAX;
+        if (!container || !ui_inside(p, container) || !kbm_read64(selection, &vt)) continue;
+        if (vt != 0x90A4468 && vt != 0x90A3F08) continue;
+        if (!kbm_read64(selection + 0x68, &model) || !kbm_read64(model, &vt) ||
+            !kbm_read64(vt + 0x30, &method) || !ui_code(method) ||
+            !kbm_read32(model + 8, &model_mode)) continue;
+        const u64 args[] = {model, model_mode};
+        if (!guest_call(p->cpu, method, args, 2, NULL, 0, &r) || !(array = r.x0) ||
+            !kbm_read64(array, &data) || !kbm_read64(array + 8, &count) || count > 4096) continue;
+        if (!c->stash && side == 1 && count == 1) index = 0;
+        else for (size_t i = 0; i < g_ui_child_count; i++) {
+            u64 obj = g_ui_children[i].obj;
+            if (!ui_visible(p->map, obj) || !ui_within(p->map, obj, container) ||
+                !kbm_read64(obj, &vt) || !kbm_read64(vt + 0xE0, &method) ||
+                method != 0x838C6C0 || !ui_inside(p, obj)) continue;
+            UiPick hit = *p;
+            hit.owner = container; hit.focused = 0; hit.root_mode = 1; hit.visited = 0;
+            if (ui_visit(&hit, obj, 0) && hit.kind == 2 && hit.index < count &&
+                ui_visible(p->map, hit.row)) { index = hit.index; control = hit.control; break; }
+        }
+        if (index >= count || !kbm_read32(data + index * 4ull, &item->handle) ||
+            !kbm_lookup(c->table, item->handle, ENTITY_STRIDE, &item->entity)) continue;
+        const u64 loc_args[] = {item->entity};
+        if (!guest_call(p->cpu, 0x847CD50, loc_args, 1, NULL, 0, &r) ||
+            !kbm_readable(r.x0, sizeof item->location)) continue;
+        memcpy(item->location, GP(r.x0), sizeof item->location);
+        if (item->location[0] != c->actor ||
+            item->location[1] != (side ? (c->stash ? 15u : item->location[1]) : 0u) ||
+            (!c->stash && side && (item->location[1] < 1 || item->location[1] > 13))) continue;
+        item->side = side;
+        item->control = control;
+        item->index = index;
+        return 1;
+    }
+    return 0;
+}
+
+/* The list's native selection setter calls its registered selection-change
+   callback. Never invoke the row's accept/equip callback for a hover. */
+static int ui_item_hover(UiPick* p) {
+    UiItemContext c = {0};
+    UiItem item = {0};
+    u64 binding;
+    u32 selected;
+    if (!ui_item_context(p, &c)) return 0;
+    ui_build_children(p->map);
+    if (!ui_item_pick(p, &c, &item) || !item.control ||
+        !kbm_read64(item.control + 0x48, &binding) || binding != c.side[item.side] ||
+        !kbm_read32(item.control + 0x1E0, &selected)) return 0;
+    if (selected == item.index) return 1;
+    const u64 args[] = {item.control, item.index};
+    int complete = guest_call(p->cpu, 0x838A6E0, args, 2, NULL, 0, NULL);
+    u32 handle;
+    int changed = complete && kbm_read32(item.control + 0x1E0, &selected) && selected == item.index &&
+                  kbm_read32(binding + 0x48, &handle) && handle == item.handle;
+    LOG("native: UI hover item %08x side=%d row=%u -> %s\n", item.handle, item.side,
+        item.index, changed ? "selected" : "incomplete");
+    return 1;
+}
+
+void ui_compare_tick(const CPU* cpu, u64 map) {
+    int held = __atomic_load_n(&g_compare_requested, __ATOMIC_ACQUIRE);
+    if (!held && !g_compare_owner) return;
+    UiPick p = {.cpu = cpu, .map = map};
+    UiItemContext c = {0};
+    u32 mode, item;
+    if (!ui_item_context(&p, &c)) return; /* A covering modal owns the input. */
+    if (c.stash || (g_compare_owner && g_compare_owner != c.owner)) {
+        g_compare_owner = 0;
+        return;
+    }
+    if (!kbm_read32(c.owner + 0x154, &mode) || mode > 1) return;
+    if (!g_compare_owner) {
+        if (!held) return;
+        g_compare_owner = c.owner;
+        g_compare_restore = mode;
+    }
+    u32 desired = held ? 1 : g_compare_restore;
+    if (mode == desired) {
+        if (!held) g_compare_owner = 0;
+        return;
+    }
+    /* 9 = Compare, 10 = return from Compare. Other button3 contexts include
+       unrelated inventory actions and must not receive this modifier. */
+    GuestResult r;
+    if (held) {
+        if (!kbm_read32(c.side[0] + 0x48, &item) || item == UINT32_MAX ||
+            !guest_call(cpu, 0x8170BD0, NULL, 0, NULL, 0, &r) || !r.x0) return;
+        const u64 context_args[] = {r.x0, 5};
+        if (!guest_call(cpu, 0x81C0820, context_args, 2, NULL, 0, &r) ||
+            r.x0 != (mode ? 10u : 9u)) return;
+    }
+    /* Use the complete native Compare branch: it switches the item models,
+       preserves the selected item and refreshes their detail callbacks. */
+    /* Release uses the native model setter even when the pointer has moved to
+       an empty/non-equipment row whose button3 action is no longer Compare. */
+    const u64 args[] = {c.owner, held ? 0u : desired};
+    int complete = guest_call(cpu, held ? 0x8373750 : 0x81FC220, args, 2, NULL, 0, NULL);
+    int changed = complete && kbm_read32(c.owner + 0x154, &mode) && mode == desired;
+    LOG("native: UI Alt compare owner=%llx held=%d -> %s\n", (unsigned long long)c.owner,
+        held, changed ? "changed" : "incomplete");
+    if (!held && changed) g_compare_owner = 0;
+}
+
+static int ui_item_move(UiPick* p, const UiItemContext* c, const UiItem* item,
+                        int equip_category, int destination, int drop, u32 serial) {
+    GuestResult r;
+    int ok;
+    if (drop) {
+        const u64 args[] = {item->handle, c->player};
+        ok = guest_call(p->cpu, 0x836E360, args, 2, NULL, 0, NULL);
+    } else if (equip_category >= 0 && equip_category < 13) {
+        const u64 category[] = {(unsigned)equip_category};
+        if (!guest_call(p->cpu, 0x81F4F00, category, 1, NULL, 0, &r) ||
+            r.x0 < 1 || r.x0 > 13) return 1;
+        const u64 scratch = g_stack_top - 0x1B000;
+        *(u32*)GP(scratch) = 1; *(u32*)GP(scratch + 4) = (u32)r.x0;
+        const u64 args[] = {c->hero, item->entity, scratch, scratch + 4, 0, c->player};
+        ok = guest_call(p->cpu, 0x83EB690, args, 6, NULL, 0, NULL);
+    } else {
+        const u64 args[] = {c->hero, item->entity, (unsigned)destination};
+        ok = guest_call(p->cpu, 0x83EBB40, args, 3, NULL, 0, NULL);
+    }
+    const u64 dirty[] = {c->owner, 1};
+    guest_call(p->cpu, 0x81FC560, dirty, 2, NULL, 0, NULL);
+    LOG("native: item pointer %u handle=%08x from=%u equip=%d destination=%d drop=%d -> %s\n",
+        serial, item->handle, item->location[1], equip_category, destination, drop,
+        ok ? "returned" : "incomplete");
+    return 1;
+}
+
+static int ui_item_pointer(UiPick* p, const PointerPress* press) {
+    const u64 flags = press->fallback;
+    if (!(flags & NATIVE_POINTER_UI_EVENTS)) return 0;
+    if ((flags & NATIVE_POINTER_UI_UP) &&
+        !__atomic_exchange_n(&g_item_drag_active, 0, __ATOMIC_ACQ_REL)) return 1;
+    UiItemContext c = {0};
+    UiItem item = {0};
+    if (!ui_item_context(p, &c)) {
+        __atomic_store_n(&g_item_drag_active, 0, __ATOMIC_RELEASE);
+        return (flags & NATIVE_POINTER_UI_UP) != 0;
+    }
+    if (flags & NATIVE_POINTER_UI_UP) {
+        GuestResult r;
+        item = g_item_drag.item;
+        u64 entity;
+        if (g_item_drag.owner != c.owner ||
+            (u32)(press->frame - g_item_drag.frame) > 3600 ||
+            !kbm_lookup(c.table, item.handle, ENTITY_STRIDE, &entity) || entity != item.entity) return 1;
+        const u64 args[] = {entity};
+        if (!guest_call(p->cpu, 0x847CD50, args, 1, NULL, 0, &r) ||
+            !kbm_readable(r.x0, sizeof item.location) ||
+            memcmp(GP(r.x0), item.location, sizeof item.location)) return 1;
+        const int dragged = hypotf(p->point[0] - g_item_drag.point[0],
+                                    p->point[1] - g_item_drag.point[1]) >= 5;
+        if (!dragged && !g_item_drag.ctrl) return 0;
+        if (c.stash) {
+            u64 target = ui_item_container(p, c.side[!item.side]);
+            if (!dragged || (target && ui_inside(p, target)))
+                return ui_item_move(p, &c, &item, -1, item.side ? 0 : 15, 0, press->serial);
+            return 1;
+        }
+        if (!dragged) return 1; /* Ctrl transfers only while storage is open. */
+        u64 target = ui_item_container(p, c.side[!item.side]);
+        if (target && ui_inside(p, target))
+            return ui_item_move(p, &c, &item, item.side ? -1 : (int)c.category, 0, 0, press->serial);
+        static const char* icons[13] = {"armleft","armright","fingerright","neck","fingerleft",
+            "hands","shoulder","torso","head","waist","legs","feet","bracers"};
+        char path[160];
+        if (!item.side) for (unsigned i = 0; i < 13; i++) {
+            snprintf(path, sizeof path, "root.normallayer.consoleinventoryring_main.layoutroot.inventoryring.button_%s", icons[i]);
+            u64 obj = ui_object(p->map, ui_path_key(path));
+            if (obj && ui_visible(p->map, obj) && ui_inside(p, obj))
+                return ui_item_move(p, &c, &item, (int)i, 0, 0, press->serial);
+        }
+        if (p->point[0] < 27 || p->point[0] >= 916 || p->point[1] >= 615)
+            return ui_item_move(p, &c, &item, -1, 0, 1, press->serial);
+        return 1;
+    }
+    if (!ui_item_pick(p, &c, &item)) return 0;
+    if (flags & NATIVE_POINTER_UI_RIGHT)
+        return ui_item_move(p, &c, &item, c.stash || item.side ? -1 : (int)c.category,
+                            c.stash && !item.side ? 15 : 0, 0, press->serial);
+    g_item_drag.item = item; g_item_drag.owner = c.owner; g_item_drag.frame = press->frame;
+    memcpy(g_item_drag.point, p->point, sizeof p->point);
+    g_item_drag.ctrl = (flags & NATIVE_POINTER_CTRL) != 0;
+    __atomic_store_n(&g_item_drag_active, 1, __ATOMIC_RELEASE);
+    return 1;
+}
+
+void ui_click(const CPU* cpu, const PointerPress* press) {
+    UiPick p = {.cpu = cpu};
+    GuestResult r;
+    const u64 scratch = g_stack_top - 0x1A000;
+    u64 global, world, manager, key, vt, method, table, subs, entries = 0;
+    u32 sub_count = 0;
+    int pixel[2];
+    if ((u32)((u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED) - press->frame) > 120 ||
+        !pointer_pixel(cpu, press, pixel) || !kbm_read64(0x914F840, &global) ||
+        !kbm_read64(global + 0x10, &world) || !kbm_read64(world + 0xB80, &manager) ||
+        !kbm_read64(manager, &p.map)) return;
+    memcpy(GP(scratch), pixel, sizeof pixel);
+    u64 args[3] = {scratch, scratch + 0x20};
+    if (!guest_call(cpu, 0x8350BF0, args, 2, NULL, 0, NULL)) return;
+    memcpy(p.point, GP(scratch + 0x20), sizeof p.point);
+    if (!isfinite(p.point[0]) || !isfinite(p.point[1])) return;
+    ui_build_children(p.map);
+    if (ui_item_pointer(&p, press)) return;
+    if (press->fallback & NATIVE_POINTER_UI_RIGHT) { native_action_press(1ull << 1); return; }
+    if (ui_map_click(&p, press->serial)) return;
+    if (ui_tab_click(&p)) return;
+    if (ui_settings_tab_click(&p, press->serial)) return;
+    if (ui_equipment_icon(&p, press->serial)) return;
+    if (ui_service_action_click(&p, press->serial)) return;
+    if (ui_stash_action_click(&p, press->serial)) return;
+    if (ui_options_toggle_click(&p, press->serial)) return;
+    if (ui_kadala_action_click(&p, press->serial)) return;
+    if (ui_skill_icon(&p, press->serial)) return;
+    if (ui_dialog_buttons(&p, press->serial)) return;
+    if (ui_footer_legend_click(&p, press->serial)) return;
+    if (!kbm_read64(manager + 0x10, &subs) || !kbm_read64(subs, &entries) ||
+        !kbm_read32(subs + 8, &sub_count) || sub_count > 1024) sub_count = 0;
+    if (ui_service_tab_click(&p, press->serial, entries, sub_count)) return;
+    if (ui_vendor_tab_click_fallback(&p, press->serial)) return;
+    int focused = 0, menu_owner = 0;
+    if (guest_call(cpu, 0x832D180, NULL, 0, NULL, 0, &r) && kbm_read64(r.x0, &key)) {
+        u64 obj = ui_object(p.map, key);
+        if (obj && ui_visible(p.map, obj)) { p.focused = obj; focused = 1; }
+    }
+    if (focused) {
+        p.owner = p.focused;
+    } else {
+        /* No input focus (main menu, options page): choose the active
+           subscribed page that contains the click, smallest rectangle first. */
+        float best = FLT_MAX;
+        for (u32 i = 0; i < sub_count; i++) {
+            u64 root;
+            float* rect;
+            float area;
+            if (!kbm_read64(entries + (u64)i * 8, &root) || !root || !ui_visible(p.map, root) ||
+                !kbm_readable(root + 0x88, 16)) continue;
+            rect = (float*)GP(root + 0x88);
+            area = (rect[2] - rect[0]) * (rect[3] - rect[1]);
+            if (!(area > 0) || area >= best || !ui_inside(&p, root)) continue;
+            best = area;
+            p.focused = root;
+        }
+        if (!p.focused) {
+            LOG("native: UI pointer %u no active page at (%d,%d)\n", press->serial, pixel[0], pixel[1]);
+            return;
+        }
+        p.root_mode = 1;
+        p.owner = p.focused;
+    }
+    for (unsigned i = 0; p.owner && i < 64; i++) {
+        u32 flags;
+        if (!kbm_read32(p.owner + 0x18, &flags)) return;
+        if (!(flags & 4)) {
+            if (!p.root_mode) return;
+            p.owner = ui_parent(p.map, p.owner);
+            continue;
+        }
+        if (p.root_mode && !ui_visible(p.map, p.owner)) {
+            p.owner = ui_parent(p.map, p.owner);
+            continue;
+        }
+        if (kbm_read64(p.owner, &vt) && kbm_read64(vt + 0xB0, &method) && method == 0x83B81F0 &&
+            kbm_read64(p.owner + 0x118, &table) && kbm_read64(table + 0x20, &p.callback) && ui_code(p.callback)) break;
+        p.owner = ui_parent(p.map, p.owner);
+    }
+    if ((!p.owner || !ui_code(p.callback)) && focused && !p.root_mode && sub_count) {
+        p.owner = ui_main_menu_owner(&p, entries, sub_count);
+        menu_owner = p.owner != 0;
+    }
+    if (!p.owner || !ui_code(p.callback)) {
+        LOG("native: UI pointer %u no callback owner (root %llx)\n", press->serial,
+            (unsigned long long)p.focused);
+        return;
+    }
+    if (!ui_visit(&p, menu_owner ? p.focused : p.owner, 0)) {
+        /* A focused button only covers its own subtree.  A click elsewhere in
+           the same page must search from the page root, not from the focused
+           leaf (main menu, dialogs). */
+        u64 root = p.focused, parent;
+        while (root && (parent = ui_parent(p.map, root)) && ui_visible(p.map, parent))
+            root = parent;
+        if (root && root != p.owner && ui_visible(p.map, root)) {
+            u64 owner2 = root;
+            p.callback = 0;
+            for (unsigned i = 0; owner2 && i < 64; i++) {
+                if (!ui_visible(p.map, owner2)) { owner2 = ui_parent(p.map, owner2); continue; }
+                if (kbm_read64(owner2, &vt) && kbm_read64(vt + 0xB0, &method) && method == 0x83B81F0 &&
+                    kbm_read64(owner2 + 0x118, &table) && kbm_read64(table + 0x20, &p.callback) &&
+                    ui_code(p.callback)) break;
+                owner2 = ui_parent(p.map, owner2);
+            }
+            if (owner2 && ui_code(p.callback)) {
+                p.owner = owner2;
+                p.hit_owner = 0; p.hit_callback = 0; p.kind = 0; p.visited = 0;
+                p.root_mode = 1;
+                if (ui_visit(&p, owner2, 0)) goto hit;
+            }
+        }
+        LOG("native: UI pointer %u missed (%d,%d)\n", press->serial, pixel[0], pixel[1]);
+        return;
+    }
+hit:
+    if (menu_owner) {
+        /* The callback reads the game's current focus.  Require it to still
+           be the hit list; never set focus or synthesize a confirm event. */
+        u64 focus_key, control_key;
+        if (p.kind != 2 || p.control != p.focused ||
+            !guest_call(cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+            !kbm_read64(r.x0, &focus_key) || !kbm_read64(p.control + 0x30, &control_key) ||
+            focus_key != control_key) return;
+    }
+    if (p.kind == 3) {
+        LOG("native: UI pointer %u disabled control %llx\n", press->serial, (unsigned long long)p.control);
+        return;
+    }
+    if (p.kind == 2) {
+        args[0] = p.control; args[1] = p.index;
+        u32 selected;
+        if (!guest_call(cpu, 0x838A6E0, args, 2, NULL, 0, NULL) ||
+            !kbm_read32(p.control + 0x1E0, &selected) || selected != p.index) return;
+    }
+    /* Invoke this hit control's callback, never a global A/confirm event. */
+    args[0] = p.hit_owner + 0x30; args[1] = 0;
+    int complete = guest_call(cpu, p.hit_callback, args, 2, NULL, 0, NULL);
+    LOG("native: UI pointer %u kind %d control %llx row %u callback %llx -> %s\n", press->serial,
+        p.kind, (unsigned long long)p.control, p.index, (unsigned long long)p.hit_callback,
+        complete ? "returned" : "incomplete");
+}
+
+/* World point -> engine screen pixel through the game's own camera. */
+
+/* The pointer queue is shared by the world and UI frames; the lock stays in the
+   world module so click routing and cancellation are one critical section. */
+int native_ui_queue_locked(const PointerPress* p) {
+    if (g_ui_count == 16) {
+        g_ui_read = g_ui_count = 0;
+        __atomic_store_n(&g_item_drag_active, 0, __ATOMIC_RELEASE);
+        return 0;
+    }
+    g_ui_pointers[(g_ui_read + g_ui_count++) % 16] = *p;
+    return 1;
+}
+void native_ui_cancel_locked(void) {
+    g_ui_read = g_ui_count = 0;
+    g_have_hover = 0;
+    g_close_target = (UiCloseTarget){0};
+    g_close_pending = (UiCloseTarget){0};
+    g_close_scope = 0;
+    __atomic_store_n(&g_item_drag_active, 0, __ATOMIC_RELEASE);
+}
+int native_ui_take_pointer(PointerPress* p) {
+    int have;
+    pm_lock(&g_pointer_lock);
+    have = g_ui_count != 0;
+    if (have) {
+        *p = g_ui_pointers[g_ui_read];
+        g_ui_read = (g_ui_read + 1) % 16;
+        g_ui_count--;
+    }
+    pm_unlock(&g_pointer_lock);
+    return have;
+}
+int native_ui_take_hover(HoverPoint* h) {
+    int have;
+    pm_lock(&g_pointer_lock);
+    have = g_have_hover;
+    if (have) { *h = g_hover; g_have_hover = 0; }
+    pm_unlock(&g_pointer_lock);
+    return have;
+}
+void native_ui_hover_point(HoverPoint* h) {
+    pm_lock(&g_pointer_lock);
+    g_hover = *h;
+    g_have_hover = 1;
+    pm_unlock(&g_pointer_lock);
+}
+void native_ui_hover_clear(void) {
+    pm_lock(&g_pointer_lock);
+    g_have_hover = 0;
+    pm_unlock(&g_pointer_lock);
+}
