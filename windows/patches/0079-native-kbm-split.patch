-        !read64(b + 0x140, &c) || !c || !read64(b + 0x198, &c) || !read64(c, &tab) ||
-        !guest_call(cpu, PLAYER_PC, args, 1, NULL, 0, &r) || !r.x0 ||
-        !read32(r.x0 + 4, actor) || !read32(r.x0 + 8, &controller_id) ||
