+        WorldPos aim = *ground;
+        aim.z = pos->z + 4.37f;
+        memcpy(GP(record + 0x60), &aim, sizeof aim);
+        const u64 args[] = {path, record + 0x60};
+        if (!guest_call(cpu, PATH_POS_PC, args, 2, NULL, 0, NULL)) return 0;
+    }
+    const u64 args[] = {player, record, 1, 1};
+    if (!guest_call(cpu, ACTION_PC, args, 4, NULL, 0, &r)) return 0;
+    LOG("native: mouse skill slot=%u power=%u path=%u target=%08x -> %u\n",
+        slot, power, actor_target ? 1u : 2u, actor_target ? picked->handle : UINT32_MAX, (u32)r.x0);
+    return r.x0 == 1;
+}
+
+/* The attack record a natural A press builds when nothing is interactable:
+   +0 controller 0xFFFFFFFF, +4/+8 the attack power, +0xC 0, +0x10 -1, +0x14 a
+   type-2 position path built by 0x866D580(path, world_pos). */
+static int submit_attack(const CPU* cpu, u64 player_object, const WalkGoal* goal, u64 target) {
+    const u64 record = g_stack_top - 0x1CB00, path = record + 0x14;
+    u32* words = (u32*)GP(record);
+    u32 actor_type;
+    if (!kbm_read32(target + 0x14C, &actor_type)) return 0;
+    memset(GP(record), 0, 0x80);
+    words[0] = actor_type == 1 ? goal->controller : 0xFFFFFFFFu;
+    words[1] = words[2] = ATTACK_POWER;
+    words[3] = 0;
+    words[4] = 0xFFFFFFFFu;
+    if (actor_type == 1) {
+        /* An alive hero attacking an actual monster naturally submits its
+           controller and a type-1 actor path, not an empty ground swing. */
+        if (!kbm_actor_alive(cpu, target)) return 0;
+        u64 build[] = {path, goal->handle, 0, 0};
+        if (!guest_call(cpu, PATH_ACTOR_PC, build, 4, NULL, 0, NULL)) return 0;
+    } else {
+        /* Aim a prop swing at the clicked object, with the real world place.
+           Using the hero position discards the mouse direction. */
+        const u64 point = record + 0x60;
+        WorldPos aim = goal->entity;
+        aim.z = goal->previous.z + 4.37f;
+        memcpy(GP(point), &aim, sizeof aim);
+        u64 build[] = {path, point};
+        if (!guest_call(cpu, PATH_POS_PC, build, 2, NULL, 0, NULL)) return 0;
+    }
+    u32 type, id;
+    if (!kbm_read32(path, &type) || !kbm_read32(path + 4, &id) ||
+        type != (actor_type == 1 ? 1u : 2u) ||
+        id != (actor_type == 1 ? goal->handle : 0xFFFFFFFFu)) {
+        LOG("native: attack path mismatch type %u id %08x\n", type, id);
+        return 0;
+    }
+    u64 submit[] = {player_object, record, 1, 1};
+    GuestResult r;
+    if (!guest_call(cpu, ACTION_PC, submit, 4, NULL, 0, &r)) return 0;
+    LOG("native: attack %08x power %d path %u controller %08x at (%.2f,%.2f,%.2f) -> %d\n",
+        goal->handle, (int)ATTACK_POWER, type, words[0], goal->entity.x,
+        goal->entity.y, goal->entity.z, (int)(u32)r.x0);
+    return (u32)r.x0 == 1;
+}
+
+/* The native operate record the game builds for a natural A press on an actor
+   (0x80D5AF0 -> 0x840A4F0 -> 0x80CBA30).  Its header is four words and the
+   path starts at +0x14:
+     +0 controller handle, +4 power, +8 power, +0xC 0, +0x10 -1 */
+static int submit_interact(const CPU* cpu, u64 player_object, const WalkGoal* goal) {
+    const u64 record = g_stack_top - 0x1CD00, path = record + 0x14;
+    u32* words = (u32*)GP(record);
+    memset(GP(record), 0, 0x80);
+    words[0] = goal->controller;
+    words[1] = words[2] = goal->power;
+    words[3] = 0;
+    words[4] = 0xFFFFFFFFu;
+    u64 build[4] = {path, goal->handle, 0, 0};
+    if (!guest_call(cpu, PATH_ACTOR_PC, build, 4, NULL, 0, NULL)) {
+        LOG("native: operate path build failed for %08x\n", goal->handle);
+        return 0;
+    }
+    u32 type, id;
+    if (!kbm_read32(path, &type) || !kbm_read32(path + 4, &id) || type != 1 || id != goal->handle) {
+        LOG("native: operate path mismatch type %u id %08x (want %08x)\n", type, id, goal->handle);
+        return 0;
+    }
+    u64 submit[4] = {player_object, record, 1, 1};
+    GuestResult r;
+    if (!guest_call(cpu, ACTION_PC, submit, 4, NULL, 0, &r)) {
+        LOG("native: operate call incomplete for %08x\n", goal->handle);
+        return 0;
+    }
+    LOG("native: operate %08x record %08x/%d/%d -> %d\n", goal->handle, words[0], (int)words[1],
+        (int)words[2], (int)(u32)r.x0);
+    return (u32)r.x0 == 1;
+}
+
+/* UIReference holds a name key, not a pointer. +0x20/+0x28 are intrusive
+   sibling links; +0x38 is the parent reference used by the native UI code. */
+typedef struct {
+    const CPU* cpu;
+    u64 map, focused, owner, callback;
+    float point[2];
+    unsigned visited;
+    u64 control, row, hit_owner, hit_callback;
+    u32 index;
+    int kind; /* 1 = button, 2 = list row, 3 = disabled/blocked */
+    int root_mode; /* no input focus: the click chose an active subscriber root */
+    int hover; /* select wheel categories only; never activate a control */
+} UiPick;
+
+/* Registry children by parent key.  The registry is the only tree the live UI
+   exposes when a page is open without an input focus (options, main menu). */
+typedef struct {
+    u64 parent, obj;
+} UiChild;
+#define UI_CHILD_MAX 32768u
+static UiChild g_ui_children[UI_CHILD_MAX];
+static unsigned g_ui_child_count;
+
+
+static int project_point(const CPU* cpu, u32 place, float x, float y, float z, float out[2]) {
+    const u64 scratch = g_stack_top - 0x1B400;
+    float* loc = (float*)GP(scratch);
+    loc[0] = x; loc[1] = y; loc[2] = z;
+    memcpy(GP(scratch + 12), &place, 4);
+    u64 args[3] = {scratch, scratch + 0x20, 0xFFFFFFFFu};
+    if (!guest_call(cpu, PROJECT_PC, args, 3, NULL, 0, NULL)) return 0;
+    memcpy(out, GP(scratch + 0x20), 8);
+    return isfinite(out[0]) && isfinite(out[1]);
+}
+
+/* Assisted target: let the game's own A targeting (0x80D5AF0) choose the
+   nearest usable interactable, then accept it only when its projection is
+   within a tight radius of the click and the ray reaches it before the
+   terrain.  This is a guard on the game's selection, never a projected-nearest
+   pick of its own; an empty click still becomes a walk, not a guessed action. */
+#define ASSIST_RADIUS 14.0f
+#define ASSIST_GATE_DISTANCE 8.0f
+/* A click on a thin object farther than the gate still names that object: walk
+   to it and ask the game once more when close.  The cap only limits how far a
+   click may name an object; whether a click names one at all is decided by the
+   gate below (interactive power, same place, and its projection within
+   ASSIST_RADIUS of the click). */
+#define ASSIST_RETRY_DISTANCE 120.0f
+
+/* Coarse gate before calling the game's A selection: a writable, interactive
+   actor must be within `distance_limit` world units and ASSIST_RADIUS screen
+   pixels of the click, must not be the local player, and must have a positive
+   operate power.  The gate only decides whether to ask the game; it never picks
+   the target.  The nearest such candidate (screen distance) is returned in
+   `found`. */
+static int assist_candidate_near(const CPU* cpu, u64 table, const WorldPos* pos,
+                                 const int pixel[2], float distance_limit, WorldPos* found,
+                                 u32* found_id, u32 player_actor) {
+    u32 limit, shift;
+    u64 buckets;
+    float best = ASSIST_RADIUS;
+    int hit = 0;
+    if (!kbm_read32(table + 0x100, &limit) || !kbm_read32(table + 0x168, &shift) || shift > 16 ||
+        limit > 65536 || !kbm_read64(table + 0x120, &buckets)) return 0;
+    for (u32 i = 0; i < limit; i++) {
+        u64 bucket, entry;
+        u32 id, place, cid;
+        float p[3], base[2], top[2];
+        if (!kbm_read64(buckets + ((u64)i >> shift) * 8, &bucket) || !bucket) continue;
+        entry = bucket + (u64)(i & ((1u << shift) - 1)) * ENTITY_STRIDE;
+        if (!kbm_read32(entry, &id) || !id || id == 0xFFFFFFFFu || id == player_actor ||
+            !kbm_read32(entry + 0xA0, &place) || place != pos->place ||
+            !kbm_read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu || !kbm_readable(entry + 0x60, 12))
+            continue;
+        memcpy(p, GP(entry + 0x60), sizeof p);
+        if (hypotf(p[0] - pos->x, p[1] - pos->y) > distance_limit) continue;
+        /* Only an actor the game itself gives an operate power to can be a
+           retry target; a decoration or the player never arms one. */
+        u64 cap_args[1] = {entry};
+        GuestResult cap;
+        if (!guest_call(cpu, CAP_POWER_PC, cap_args, 1, NULL, 0, &cap) || (i32)cap.x0 <= 0 ||
+            (u32)cap.x0 == ASSIST_ACTION) continue;
+        if (!project_point(cpu, place, p[0], p[1], p[2], base)) continue;
+        float height = 0;
+        if (kbm_readable(entry + 0x80, 20)) {
+            float cylinder[5];
+            memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
+            if (isfinite(cylinder[4]) && cylinder[4] > 0 && cylinder[4] < 4) height = cylinder[4];
+        }
+        if (!project_point(cpu, place, p[0], p[1], p[2] + height, top)) {
+            top[0] = base[0]; top[1] = base[1];
+        }
+        float y0 = fminf(base[1], top[1]), y1 = fmaxf(base[1], top[1]);
+        float cy = pixel[1] < y0 ? y0 : (pixel[1] > y1 ? y1 : pixel[1]);
+        float dx = pixel[0] - (base[0] + top[0]) * 0.5f;
+        float d = hypotf(dx, pixel[1] - cy);
+        if (d > best) continue;
+        best = d;
+        if (found) *found = (WorldPos){p[0], p[1], p[2], place};
+        if (found_id) *found_id = id;
+        hit = 1;
+    }
+    return hit;
+}
+
+static int assist_target(const CPU* cpu, u64 table, u64 player_object, const WorldRay* ray,
+                         const int pixel[2], float occlusion, const WorldPos* pos, WalkGoal* goal,
+                         u32 want) {
+    const u64 record = g_stack_top - 0x1C900;
+    const u64 scratch6 = g_stack_top - 0x1C800, scratch7 = g_stack_top - 0x1C804;
+    GuestResult r;
+    u32* words = (u32*)GP(record);
+    u64 args[8] = {ASSIST_ACTION, record, player_object, 0, 1, 1, scratch6, scratch7};
+    memset(GP(record), 0, 0x80);
+    memset(GP(scratch6), 0, 8);
+    if (!guest_call(cpu, ASSIST_PC, args, 8, NULL, 0, &r)) return 0;
+    u32 type, id, power = words[1], cid = words[0];
+    if (!kbm_read32(record + 0x14, &type) || !kbm_read32(record + 0x18, &id) ||
+        type != 1 || id == 0 || id == 0xFFFFFFFFu || power == 0 || power == 0xFFFFFFFFu ||
+        power == ASSIST_ACTION || cid == 0 || cid == 0xFFFFFFFFu) {
+        LOG("native: assist miss (path %u id %08x power %08x cid %08x)\n", type, id, power, cid);
+        return 0;
+    }
+    if (want && id != want) {
+        LOG("native: assist miss (game chose %08x, click named %08x)\n", id, want);
+        return 0;
+    }
+    u64 entry;
+    u32 place;
+    float p[3], base[2], top[2];
+    if (!kbm_lookup(table, id, ENTITY_STRIDE, &entry) || !kbm_read32(entry + 0xA0, &place) ||
+        place != pos->place || !kbm_readable(entry + 0x60, 12)) {
+        LOG("native: assist miss (target %08x not in table/place)\n", id);
+        return 0;
+    }
+    memcpy(p, GP(entry + 0x60), sizeof p);
+    float t = (p[0] - ray->origin[0]) * ray->direction[0] +
+              (p[1] - ray->origin[1]) * ray->direction[1] +
+              (p[2] - ray->origin[2]) * ray->direction[2];
+    if (!isfinite(t) || t > occlusion + 2.0f) {
+        LOG("native: assist miss (target %08x behind terrain %.2f > %.2f)\n", id, t, occlusion);
+        return 0;
+    }
+    if (!project_point(cpu, place, p[0], p[1], p[2], base)) return 0;
+    float height = 0;
+    if (kbm_readable(entry + 0x80, 20)) {
+        float cylinder[5];
+        memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
+        if (isfinite(cylinder[4]) && cylinder[4] > 0 && cylinder[4] < 4) height = cylinder[4];
+    }
+    if (!project_point(cpu, place, p[0], p[1], p[2] + height, top)) {
+        top[0] = base[0]; top[1] = base[1];
+    }
+    float y0 = fminf(base[1], top[1]), y1 = fmaxf(base[1], top[1]);
+    float cy = pixel[1] < y0 ? y0 : (pixel[1] > y1 ? y1 : pixel[1]);
+    float dx = pixel[0] - (base[0] + top[0]) * 0.5f;
+    float screen_distance = hypotf(dx, pixel[1] - cy);
+    /* The click-time guard proves the click pointed at this object.  A retry
+       happens after walking, when the camera has moved, so it proves identity
+       with the handle instead and keeps the occlusion check. */
+    if (!want && !(screen_distance <= ASSIST_RADIUS)) {
+        LOG("native: assist miss (target %08x screen %.2f > %.2f)\n", id, screen_distance, ASSIST_RADIUS);
+        return 0;
+    }
+    goal->handle = id;
+    goal->controller = cid;
+    goal->entity = (WorldPos){p[0], p[1], p[2], place};
+    goal->power = power;
+    u32 sno = 0;
+    kbm_read32(entry + 0x18, &sno);
+    goal->sno = sno;
+    /* Portals accept the operate from farther than a normal prop (the natural
+       A at the inn door was accepted at 4.3), and their doorway blocks the
+       last step; approach and submit at 3.6.  The town waypoint is the one
+       verified walk-into exception. */
+    goal->approach = walk_into_sno(sno) ? 0.9f : 3.6f;
+    LOG("native: assisted target %08x power %d screen %.2f terrain %.2f\n", id, (int)power,
+        screen_distance, occlusion);
+    return 1;
+}
+
+
+/* Known door/portal SNOs and the click-time projection fallback.  The camera
+   ray sometimes misses a doorway's thin collider even when the click is right
+   on the door; this gate accepts a click within 24 px of the projected door
+   and 120 world units of the player. A valid click-time terrain depth must
+   place the door in front of the occluder before it can become an operate goal.
+   It only covers the listed SNOs; ordinary props/NPCs keep the ray/assist path. */
+int native_world_map_open(void) {
+    u64 global, world, manager, map, local, waypoint;
+    if (!kbm_read64(0x914F840, &global) || !kbm_read64(global + 0x10, &world) ||
+        !kbm_read64(world + 0xB80, &manager) || !kbm_read64(manager, &map)) return 0;
+    local = ui_object(map, ui_path_key("root.normallayer.map_dialog_mainpage"));
+    waypoint = ui_object(map, ui_path_key("root.normallayer.waypointmap_main"));
+    return (local && ui_visible(map, local)) || (waypoint && ui_visible(map, waypoint));
+}
+
+static int door_sno(u32 sno) {
+    return sno == 178293u || /* inn door */
+           sno == 90419u ||  /* trOut_NewTristram_Gate_Town */
+           portal_sno(sno);
+}
+
+static int door_candidate_near(const CPU* cpu, u64 table, const WorldPos* pos,
+                               const WorldRay* ray, float occlusion, int ground_ok,
+                               const int pixel[2], WorldPos* found, u32* found_handle,
+                               u32* found_controller, u32* found_power, u32* found_sno) {
+    u32 limit, shift;
+    u64 buckets;
+    float best = 24.0f;
+    int hit = 0;
+    /* ground_target leaves FLT_MAX on failure; it is not an unobstructed ray. */
+    if (!ground_ok || !isfinite(occlusion) || occlusion < 0 || occlusion == FLT_MAX ||
+        !isfinite(ray->length) || ray->length <= 0) return 0;
+    if (!kbm_read32(table + 0x100, &limit) || !kbm_read32(table + 0x168, &shift) || shift > 16 ||
+        limit > 65536 || !kbm_read64(table + 0x120, &buckets)) return 0;
+    for (u32 i = 0; i < limit; i++) {
+        u64 bucket, entry;
+        u32 id, place, cid, sno;
+        float p[3], cylinder[5], base[2], top[2];
+        if (!kbm_read64(buckets + ((u64)i >> shift) * 8, &bucket) || !bucket) continue;
+        entry = bucket + (u64)(i & ((1u << shift) - 1)) * ENTITY_STRIDE;
+        if (!kbm_read32(entry, &id) || !id || id == 0xFFFFFFFFu || (id & 0xFFFF) != i ||
+            !kbm_read32(entry + 0xA0, &place) || place != pos->place ||
+            !kbm_read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu ||
+            !kbm_read32(entry + 0x18, &sno) || !door_sno(sno) ||
+            !kbm_readable(entry + 0x60, 12) || !kbm_readable(entry + 0x80, sizeof cylinder)) continue;
+        memcpy(p, GP(entry + 0x60), sizeof p);
+        memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
+        LOG("native: door probe %08x sno %u dist %.2f cylinder %.2f\n", id, sno,
+            hypotf(p[0] - pos->x, p[1] - pos->y), cylinder[4]);
+        if (!isfinite(cylinder[4]) || cylinder[4] < 0 || cylinder[4] > 64 ||
+            !isfinite(cylinder[3]) || cylinder[3] < 0 || cylinder[3] > 128) {
+            LOG("native: door skip %08x cylinder %.2f\n", id, cylinder[4]);
+            continue;
+        }
+        if (hypotf(p[0] - pos->x, p[1] - pos->y) > 120.0f) continue;
+        if (!project_point(cpu, place, p[0], p[1], p[2], base)) continue;
+        float height = cylinder[3] > 0 ? fminf(cylinder[3], 24.0f) : 2.0f;
+        if (!project_point(cpu, place, p[0], p[1], p[2] + height, top)) {
+            top[0] = base[0]; top[1] = base[1];
+        }
+        float y0 = fminf(base[1], top[1]), y1 = fmaxf(base[1], top[1]);
+        float cy = pixel[1] < y0 ? y0 : (pixel[1] > y1 ? y1 : pixel[1]);
+        float dx = pixel[0] - (base[0] + top[0]) * 0.5f;
+        float d = hypotf(dx, pixel[1] - cy);
+        if (d > best) continue;
+        float depth = (p[0] - ray->origin[0]) * ray->direction[0] +
+                      (p[1] - ray->origin[1]) * ray->direction[1] +
+                      (p[2] - ray->origin[2]) * ray->direction[2];
+        if (!isfinite(depth) || depth < 0 || depth > ray->length || depth > occlusion + 2.0f) {
+            LOG("native: door skip %08x depth %.2f terrain %.2f\n", id, depth, occlusion);
+            continue;
+        }
+        u64 cap_args[1] = {entry};
+        GuestResult cap;
+        int cap_ok = guest_call(cpu, CAP_POWER_PC, cap_args, 1, NULL, 0, &cap);
+        LOG("native: door measure %08x sno %u screen %.2f cap_ok %d cap %d\n", id, sno, d,
+            cap_ok, cap_ok ? (int)(i32)cap.x0 : -999);
+        if (!cap_ok || (i32)cap.x0 <= 0 || (u32)cap.x0 == ASSIST_ACTION) continue;
+        best = d;
+        *found = (WorldPos){p[0], p[1], p[2], place};
+        *found_handle = id;
+        *found_controller = cid;
+        *found_power = (u32)cap.x0;
+        *found_sno = sno;
+        hit = 1;
+    }
+    return hit;
+}
+
+static void world_tick(CPU* cpu) {
+    PointerPress p;
+    u32 actor;
+    u64 entity, controller, player_object, table;
+    WorldPos pos;
+    int pending;
+    if (__atomic_exchange_n(&g_cancel, 0, __ATOMIC_ACQ_REL)) g_goal.active = 0;
+    if (__atomic_load_n(&g_ui_blocked, __ATOMIC_ACQUIRE)) return;
+    pending = take_pointer(&p);
+    if (pending && (p.fallback & NATIVE_POINTER_UI_EVENTS)) {
+        __atomic_store_n(&g_item_drag_active, 0, __ATOMIC_RELEASE);
+        return;
+    }
+    if (!pending && !g_goal.active) return;
+    if (pending && (u32)((u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED) - p.frame) > 120) {
+        g_goal.active = 0; return;
+    }
+    if (!kbm_local_player(cpu, &actor, &entity, &controller, &pos, &player_object, &table)) {
+        g_goal.active = 0;
+        return;
+    }
+    if (!kbm_actor_alive(cpu, entity)) {
+        if (pending) LOG("native: world pointer %u blocked (hero dead)\n", p.serial);
+        g_goal.active = 0;
+        return;
+    }
+    if (pending) {
+        WorldRay ray;
+        int pixel[2];
+        float occlusion;
+        WorldPos ground;
+        int stand_still = (p.fallback & 1u) != 0;
+        g_goal.active = 0;
+        if (!pointer_ray(cpu, &p, &ray, pixel)) return;
+        memset(&g_goal, 0, sizeof g_goal);
+        int ground_ok = ground_target(cpu, pixel, &pos, &ground, &occlusion);
+        int picked = pick_entity(cpu, table, &ray, occlusion, &pos, actor, &g_goal);
+        if (p.fallback & NATIVE_POINTER_SKILL) {
+            submit_mouse_skill(cpu, player_object, &pos, &ground, ground_ok,
+                               &g_goal, picked > 0, table, (unsigned)((p.fallback >> 8) & 0xFF));
+            __atomic_store_n(&g_hold_kind, 2, __ATOMIC_RELEASE);
+            return;
+        }
+        WorldPos candidate;
+        WorldPos door;
+        u32 door_handle = 0, door_controller = 0, door_power = 0, door_sno_value = 0;
+        if (picked == 0 &&
+            assist_candidate_near(cpu, table, &pos, pixel, ASSIST_GATE_DISTANCE, &candidate, NULL,
+                                  actor))
+            picked = assist_target(cpu, table, player_object, &ray, pixel, occlusion, &pos, &g_goal, 0);
+        if (picked < 0) return;
+        if (picked > 0) {
+            if (stand_still && !g_goal.attack) {
+                LOG("native: stand still ignores interactable %08x\n", g_goal.handle);
+                return;
+            }
+            g_goal.active = 1;
+            g_goal.entity_goal = 1;
+            g_goal.stand_still = stand_still;
+            __atomic_store_n(&g_hold_kind, g_goal.attack ? 2 : 3, __ATOMIC_RELEASE);
+            g_goal.actor = actor;
+            g_goal.serial = p.serial;
+            g_goal.previous = pos;
+            /* stand just outside the target, on the line back to the player */
+            float dx = pos.x - g_goal.entity.x, dy = pos.y - g_goal.entity.y;
+            float d = hypotf(dx, dy);
+            if (d > 0.001f) {
+                g_goal.target = (WorldPos){g_goal.entity.x + dx / d * g_goal.approach,
+                    g_goal.entity.y + dy / d * g_goal.approach, g_goal.entity.z, g_goal.entity.place};
+            } else {
+                g_goal.target = g_goal.entity;
+            }
+            LOG("native: entity goal %u handle %08x power %d (%.2f,%.2f,%.2f) distance %.2f\n",
+                p.serial, g_goal.handle, (int)g_goal.power, g_goal.entity.x, g_goal.entity.y,
+                g_goal.entity.z, hypotf(g_goal.entity.x - pos.x, g_goal.entity.y - pos.y));
+        } else if (door_candidate_near(cpu, table, &pos, &ray, occlusion, ground_ok,
+                                       pixel, &door, &door_handle,
+                                       &door_controller, &door_power, &door_sno_value)) {
+            if (stand_still) {
+                LOG("native: stand still ignores door %08x sno %u\n", door_handle, door_sno_value);
+                return;
+            }
+            __atomic_store_n(&g_hold_kind, 3, __ATOMIC_RELEASE);
+            g_goal.handle = door_handle;
+            g_goal.controller = door_controller;
+            g_goal.power = door_power;
+            g_goal.sno = door_sno_value;
+            g_goal.entity = door;
+            g_goal.entity_goal = 1;
+            g_goal.approach = portal_sno(door_sno_value) ? 0.9f : 3.6f;
+            float ddx = pos.x - door.x, ddy = pos.y - door.y;
+            float dd = hypotf(ddx, ddy);
+            if (dd > 0.001f)
+                g_goal.target = (WorldPos){door.x + ddx / dd * g_goal.approach,
+                    door.y + ddy / dd * g_goal.approach, door.z, door.place};
+            else
+                g_goal.target = door;
+            g_goal.active = 1; g_goal.actor = actor; g_goal.serial = p.serial;
+            g_goal.ticks = g_goal.stuck = 0; g_goal.previous = pos;
+            LOG("native: door candidate %u handle %08x sno %u power %d (%.2f,%.2f,%.2f) distance %.2f\n",
+                p.serial, door_handle, door_sno_value, (int)door_power, door.x, door.y, door.z,
+                hypotf(door.x - pos.x, door.y - pos.y));
+        } else {
+            if (!ground_ok) return;
+            if (stand_still) {
+                submit_ground_attack(cpu, player_object, &pos, &ground);
+                __atomic_store_n(&g_hold_kind, 2, __ATOMIC_RELEASE);
+                return;
+            }
+            g_goal.target = ground;
+            g_goal.active = 1; g_goal.actor = actor; g_goal.serial = p.serial;
+            g_goal.ticks = g_goal.stuck = 0; g_goal.previous = pos;
+            /* The click still named an interactable that is merely too far for
+               the game's A selection: walk to it and retry there, keeping this
+               click's pixel/ray/depth so the retry can only accept it. */
+            float candidate_distance = 0;
+            if (assist_candidate_near(cpu, table, &pos, pixel, ASSIST_RETRY_DISTANCE, &candidate,
+                                      &g_goal.assist_handle, actor) &&
+                (candidate_distance = hypotf(candidate.x - pos.x, candidate.y - pos.y)) >
+                    ASSIST_GATE_DISTANCE) {
+                float dx = pos.x - candidate.x, dy = pos.y - candidate.y;
+                float d = hypotf(dx, dy);
+                if (d > 0.001f) {
+                    g_goal.target = (WorldPos){candidate.x + dx / d * 3.6f, candidate.y + dy / d * 3.6f,
+                        candidate.z, candidate.place};
+                } else {
+                    g_goal.target = candidate;
+                }
+                g_goal.assist_pending = 1;
+                g_goal.assist_pixel[0] = pixel[0];
+                g_goal.assist_pixel[1] = pixel[1];
+                g_goal.assist_pos = candidate;
+                LOG("native: assist pending %u handle %08x (%.1f,%.1f) distance %.2f\n",
+                    p.serial, g_goal.assist_handle, candidate.x, candidate.y, candidate_distance);
+            }
+            __atomic_store_n(&g_hold_kind, g_goal.assist_pending ? 3 : 1, __ATOMIC_RELEASE);
+            LOG("native: world goal %u actor %08x (%.3f,%.3f,%.3f) -> (%.3f,%.3f,%.3f)\n",
+                p.serial, actor, pos.x, pos.y, pos.z, g_goal.target.x, g_goal.target.y, g_goal.target.z);
+        }
+    }
+    if (g_goal.actor != actor || g_goal.target.place != pos.place) { g_goal.active = 0; return; }
+    if (g_goal.assist_pending) {
+        u64 current;
+        u32 place;
+        if (!kbm_lookup(table, g_goal.assist_handle, ENTITY_STRIDE, &current) ||
+            !kbm_read32(current + 0xA0, &place) || place != pos.place ||
+            !kbm_readable(current + 0x60, 12)) {
+            LOG("native: assist pending %u target %08x expired\n", g_goal.serial,
+                g_goal.assist_handle);
+            g_goal.assist_pending = 0;
+            g_goal.active = 0;
+            return;
+        }
+        memcpy(&g_goal.assist_pos, GP(current + 0x60), 12);
+        g_goal.assist_pos.place = place;
+        /* A moving NPC would otherwise leave the arm-time walk point behind and
+           the goal would "arrive" outside the retry radius. */
+        float adx = pos.x - g_goal.assist_pos.x, ady = pos.y - g_goal.assist_pos.y;
+        float ad = hypotf(adx, ady);
+        if (ad > 0.001f)
+            g_goal.target = (WorldPos){g_goal.assist_pos.x + adx / ad * 3.6f,
+                g_goal.assist_pos.y + ady / ad * 3.6f, g_goal.assist_pos.z, place};
+        else
+            g_goal.target = g_goal.assist_pos;
+        float gap = hypotf(g_goal.assist_pos.x - pos.x, g_goal.assist_pos.y - pos.y);
+        if (gap <= ASSIST_GATE_DISTANCE) {
+            g_goal.assist_pending = 0;
+            WalkGoal retry = {0};
+            WorldRay ray;
+            WorldPos ground;
+            float occlusion = FLT_MAX;
+            if (!ground_target(cpu, g_goal.assist_pixel, &pos, &ground, &occlusion) ||
+                occlusion == FLT_MAX) {
+                LOG("native: assist retry %u no terrain depth\n", g_goal.serial);
+            } else if (ray_at_pixel(cpu, g_goal.assist_pixel, &ray) &&
+                assist_target(cpu, table, player_object, &ray, g_goal.assist_pixel, occlusion,
+                              &pos, &retry, g_goal.assist_handle)) {
+                g_goal.handle = retry.handle;
+                g_goal.controller = retry.controller;
+                g_goal.power = retry.power;
+                g_goal.approach = retry.approach;
+                g_goal.sno = retry.sno;
+                g_goal.entity = retry.entity;
+                g_goal.entity_goal = 1;
+                g_goal.ticks = g_goal.stuck = 0;
+                LOG("native: assist retry %u accepted %08x (same handle) at %.2f\n",
+                    g_goal.serial, g_goal.handle, gap);
+            } else {
+                LOG("native: assist retry %u rejected at %.2f\n", g_goal.serial, gap);
+            }
+        }
+    }
+    if (g_goal.entity_goal) {
+        u64 current, global, world, controllers, target_controller;
+        u32 place, cid, owner;
+        if (!kbm_lookup(table, g_goal.handle, ENTITY_STRIDE, &current) ||
+            !kbm_read32(current + 0xA0, &place) || place != pos.place ||
+            !kbm_read32(current + 0x14, &cid) || cid != g_goal.controller ||
+            !kbm_read64(0x914F840, &global) || !kbm_read64(global + 0x10, &world) ||
+            !kbm_read64(world + 0xA98, &controllers) ||
+            !kbm_lookup(controllers, cid, CONTROLLER_STRIDE, &target_controller) ||
+            !kbm_read32(target_controller + 8, &owner) || owner != g_goal.handle ||
+            !kbm_readable(current + 0x60, 12)) {
+            LOG("native: entity goal %u target expired\n", g_goal.serial);
+            g_goal.active = 0; return;
+        }
+        memcpy(&g_goal.entity, GP(current + 0x60), 12);
+        if (g_goal.stand_still) {
+            int ok = submit_attack(cpu, player_object, &g_goal, current);
+            LOG("native: entity goal %u stand-still attack %08x at %.2f -> %s\n", g_goal.serial,
+                g_goal.handle, hypotf(g_goal.entity.x - pos.x, g_goal.entity.y - pos.y),
+                ok ? "accepted" : "rejected");
+            g_goal.active = 0;
+            return;
+        }
+        float dx = pos.x - g_goal.entity.x, dy = pos.y - g_goal.entity.y;
+        float d = hypotf(dx, dy);
+        if (!isfinite(d)) { g_goal.active = 0; return; }
+        if (d > 0.001f) g_goal.target = (WorldPos){g_goal.entity.x + dx / d * g_goal.approach,
+            g_goal.entity.y + dy / d * g_goal.approach, g_goal.entity.z, place};
+        float reached = hypotf(g_goal.entity.x - pos.x, g_goal.entity.y - pos.y);
+        /* Some props are walled in so the player cannot get closer than ~3 units
+           even though the game accepts their operate from farther (4.79 measured
+           on SNO 341800).  Submit at up to OPERATE_RANGE; the game still rejects
+           a genuinely out-of-range request. */
+        float reach = g_goal.attack ? g_goal.approach + 0.5f
+                                    : (walk_into_sno(g_goal.sno)
+                                           ? g_goal.approach + 0.2f
+                                           : fmaxf(long_interact_sno(g_goal.sno) ? 6.2f : OPERATE_RANGE,
+                                                    g_goal.approach + 0.8f));
+        if (reached <= reach) {
+            int ok = g_goal.attack ? submit_attack(cpu, player_object, &g_goal, current)
+                                   : submit_interact(cpu, player_object, &g_goal);
+            LOG("native: entity goal %u %s %08x power %d at %.2f -> %s\n", g_goal.serial,
+                g_goal.attack ? "attack" : "operate", g_goal.handle, (int)g_goal.power, reached,
+                ok ? "accepted" : "rejected");
+            if (!ok && g_goal.attack && !g_goal.attack_retry &&
+                g_goal.approach > ATTACK_APPROACH + 0.1f) {
+                /* A wide static prop (crafting backbone and similar) reports no
+                   operate power, so the pick becomes an attack standing outside
+                   its collision radius.  The game refuses that attack; keep the
+                   click and walk up to melee range, then submit once more. */
+                g_goal.approach = ATTACK_APPROACH;
+                g_goal.attack_retry = 1;
+                g_goal.ticks = g_goal.stuck = 0;
+                LOG("native: entity goal %u retry at attack range %.2f\n", g_goal.serial,
+                    g_goal.approach);
+                return;
+            }
+            g_goal.active = 0;
+            return;
+        }
+    }
+    float distance = hypotf(g_goal.target.x - pos.x, g_goal.target.y - pos.y);
+    if (!g_goal.entity_goal && distance <= 0.12f) {
+        LOG("native: world goal %u arrived (error %.4f, %u ticks)\n", g_goal.serial, distance, g_goal.ticks);
+        g_goal.active = 0; return;
+    }
+    if (hypotf(pos.x - g_goal.previous.x, pos.y - g_goal.previous.y) < 0.002f) g_goal.stuck++;
+    else g_goal.stuck = 0;
+    g_goal.previous = pos;
+    g_goal.ticks++;
+    if (g_goal.stuck > 90 && !g_goal.entity_goal && !g_goal.assist_pending &&
+        g_goal.retries < 2) {
+        /* A ground click can land on a point the nav mesh cannot reach (inside
+           a fence, behind a wall).  Pull the target toward the player and try
+           again instead of dropping the whole click.  An assist goal rewrites
+           its target every tick, so a pull there would be undone immediately. */
+        float dx = g_goal.target.x - pos.x, dy = g_goal.target.y - pos.y;
+        float pull = hypotf(dx, dy) * 0.4f;
+        if (isfinite(dx) && isfinite(dy) && pull > 1.0f) {
+            g_goal.target = (WorldPos){pos.x + dx * 0.4f, pos.y + dy * 0.4f,
+                                       g_goal.target.z, g_goal.target.place};
+            g_goal.stuck = 0; g_goal.ticks = 0; g_goal.retries++;
+            LOG("native: world goal %u retry nearer (%.2f)\n", g_goal.serial, pull);
+            distance = hypotf(g_goal.target.x - pos.x, g_goal.target.y - pos.y);
+        } else {
+            LOG("native: world goal %u stopped (too near)\n", g_goal.serial);
+            g_goal.active = 0; return;
+        }
+    } else if (g_goal.ticks > 600 || g_goal.stuck > 90) {
+        LOG("native: world goal %u stopped (blocked/timeout)\n", g_goal.serial);
+        g_goal.active = 0; return;
+    }
+    GuestResult speed;
+    u64 args[9] = {entity, 0x11060};
+    if (!guest_call(cpu, SPEED_PC, args, 2, NULL, 0, &speed) ||
+        !isfinite(speed.f0) || speed.f0 <= 0 || speed.f0 > 10) { g_goal.active = 0; return; }
+    float floats[2] = {0, fminf(speed.f0, fmaxf(0.02f, distance * 0.25f))};
+    const u64 pos_address = g_stack_top - 0x1F000, path_address = g_stack_top - 0x1E000;
+    memcpy(GP(pos_address), &g_goal.target, sizeof g_goal.target);
+    memset(GP(path_address), 0, 32);
+    args[0] = path_address; args[1] = pos_address;
+    if (!guest_call(cpu, PATH_POS_PC, args, 2, NULL, 0, NULL)) { g_goal.active = 0; return; }
+    args[0] = controller; args[1] = args[2] = WALK_SNO; args[3] = path_address;
+    for (unsigned i = 4; i < 9; i++) args[i] = 0;
+    if (!guest_call(cpu, WALK_PC, args, 9, floats, 2, NULL)) g_goal.active = 0;
+}
+
+static int primary_event(CPU* cpu, u64* event) {
+    u32 type, player;
+    *event = cpu->x[0];
+    return kbm_read32(*event, &type) && type == 0x19 && kbm_read32(*event + 0x28, &player) && player == 0;
+}
+static void world_ui(CPU* cpu, u64 entry) {
+    u64 event, lr = cpu->x[30];
+    int primary = entry == UI_PC && primary_event(cpu, &event);
+    g_ui_original(cpu, entry);
+    if (!primary || cpu->pc != lr) return;
+    int blocked = cpu->x[0] != 0;
+    __atomic_store_n(&g_ui_blocked, blocked, __ATOMIC_RELEASE);
+    if (blocked) {
+        UiTabState state = {0};
+        u64 global, world, manager, map;
+        int page = kbm_read64(0x914F840, &global) && kbm_read64(global + 0x10, &world) &&
+                   kbm_read64(world + 0xB80, &manager) && kbm_read64(manager, &map) &&
+                   ui_tab_state(map, &state);
+        __atomic_store_n(&g_char_page, page, __ATOMIC_RELEASE);
+        __atomic_store_n(&g_char_tab, page ? state.current : -1, __ATOMIC_RELEASE);
+        if (page && __atomic_load_n(&g_hotkey_tab, __ATOMIC_ACQUIRE) < 0) {
+            /* the page changed: a pending request for another page is stale */
+        }
+    } else {
+        __atomic_store_n(&g_char_page, 0, __ATOMIC_RELEASE);
+        __atomic_store_n(&g_char_tab, -1, __ATOMIC_RELEASE);
+    }
+    if (blocked && __atomic_load_n(&g_hotkey_tab, __ATOMIC_ACQUIRE) >= 0) {
+        int tab = __atomic_load_n(&g_hotkey_tab, __ATOMIC_ACQUIRE);
+        int frames = __atomic_add_fetch(&g_hotkey_frames, 1, __ATOMIC_ACQ_REL);
+        UiTabState state = {0};
+        u64 global, world, manager, map;
+        int done = 0;
+        if (frames > 240) {
+            LOG("native: UI hotkey tab %d gave up (no character page)\n", tab);
+            done = 1;
+        } else if (kbm_read64(0x914F840, &global) && kbm_read64(global + 0x10, &world) &&
+                   kbm_read64(world + 0xB80, &manager) && kbm_read64(manager, &map) &&
+                   ui_tab_state(map, &state)) {
+            done = ui_tab_select_slot(cpu, map, &state, tab);
+        }
+        if (done) __atomic_store_n(&g_hotkey_tab, -1, __ATOMIC_RELEASE);
+    }
+    if (blocked) {
+        u64 legend_global, legend_world, legend_manager = 0, legend_map = 0;
+        if (kbm_read64(0x914F840, &legend_global) && kbm_read64(legend_global + 0x10, &legend_world) &&
+            kbm_read64(legend_world + 0xB80, &legend_manager) && kbm_read64(legend_manager, &legend_map))
+            ui_footer_relabel(cpu, legend_map);
+        if (ui_close_tick(cpu, legend_map, legend_manager)) return;
+        pm_lock(&g_pointer_lock);
+        g_skill_read = g_skill_count = 0;
+        pm_unlock(&g_pointer_lock);
+        PointerPress p;
+        g_goal.active = 0;
+        __atomic_store_n(&g_cancel, 1, __ATOMIC_RELEASE);
+        HoverPoint h;
+        if (native_ui_take_pointer(&p)) {
+            if (!__atomic_exchange_n(&g_busy, 1, __ATOMIC_ACQ_REL)) {
+                ui_click(cpu, &p);
+                __atomic_store_n(&g_busy, 0, __ATOMIC_RELEASE);
+            }
+            /* A click may change pages. Never apply old motion to the new page. */
+            native_ui_take_hover(&h);
+        } else if (native_ui_take_hover(&h) && !__atomic_exchange_n(&g_busy, 1, __ATOMIC_ACQ_REL)) {
+            ui_hover(cpu, &h);
+            __atomic_store_n(&g_busy, 0, __ATOMIC_RELEASE);
+        }
+        ui_compare_tick(cpu, legend_map);
+    } else {
+        g_compare_owner = 0;
+        pm_lock(&g_pointer_lock);
+        g_close_scope = 0;
+        g_close_target = g_close_pending = (UiCloseTarget){0};
+        pm_unlock(&g_pointer_lock);
+        HoverPoint h;
+        native_ui_take_hover(&h);
+    }
+}
+static void world_game(CPU* cpu, u64 entry) {
+    u64 event, lr = cpu->x[30];
+    int primary = entry == GAME_PC && primary_event(cpu, &event);
+    float axes[2] = {0, 0};
+    if (primary && kbm_readable(event + 0x30, sizeof axes)) memcpy(axes, GP(event + 0x30), sizeof axes);
+    g_game_original(cpu, entry);
+    if (!primary || cpu->pc != lr) return;
+    if (__atomic_exchange_n(&g_busy, 1, __ATOMIC_ACQ_REL)) return;
+    world_command_tick(cpu);
+    if (fabsf(axes[0]) > 0.05f || fabsf(axes[1]) > 0.05f) native_world_cancel();
+    else world_tick(cpu);
+    __atomic_store_n(&g_busy, 0, __ATOMIC_RELEASE);
+}
+
+void native_world_init(void) {
+    g_stack_top = kmem_alloc(WORLD_STACK_SIZE, MS_STACK, PERM_RW) + WORLD_STACK_SIZE - 0x100;
+}
+void native_world_install(void) {
+    if (!g_stack_top || !g_disp || UI_PC < g_code_lo || GAME_PC < g_code_lo ||
+        UI_PC >= g_code_hi || GAME_PC >= g_code_hi || WALK_PC >= g_code_hi) return;
+    /* D3 2.6.2.52309 entry: sub sp,#0xc0; stp d13,d12; stp d11,d10. */
+    if (gr32(WALK_PC) != 0xD10303FFu || gr32(WALK_PC + 4) != 0x6D0333EDu) return;
+    if (!g_ui_original) {
+        GuestFn* slot = &g_disp[(UI_PC - g_code_lo) / 4];
+        GuestFn f = __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+        if (f && f != world_ui) { g_ui_original = f; __atomic_store_n(slot, world_ui, __ATOMIC_RELEASE); }
+    }
+    if (!g_game_original) {
+        GuestFn* slot = &g_disp[(GAME_PC - g_code_lo) / 4];
+        GuestFn f = __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+        if (f && f != world_game) { g_game_original = f; __atomic_store_n(slot, world_game, __ATOMIC_RELEASE); }
+    }
+    native_labels_install();
+    if (g_ui_original && g_game_original && !__atomic_exchange_n(&g_enabled, 1, __ATOMIC_ACQ_REL))
+        LOG("native: world pointer installed (camera ray -> client Walk / actor operate)\n");
+}
