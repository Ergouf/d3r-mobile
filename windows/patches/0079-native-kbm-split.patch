-    static const float left[4] = {126.0f, 303.0f, 505.0f, 682.0f};
-    u64 holder, nav, group, entry, holder2, controller, vt, data, count64;
-    u32 current, player, active, mode;
-    int target = -1;
-    if (!read64(0x9152080, &holder) || !holder ||
-        !read64(holder, &nav) || !nav ||
-        !read64(nav + 0x108, &group) || !group ||
-        !read64(nav + 2 * 8, &entry) || entry != group) return 0;
