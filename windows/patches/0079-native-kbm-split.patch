-    /* Region / Act / World tabs are navigation group 8, not character tabs. */
-    if (p->point[1] >= 39 && p->point[1] < 63) {
-        static const float rects[3][2] = {{125,375},{357,607},{636,792}};
-        static const u64 opens[3] = {0x83EC6C0,0x823E1E0,0x823E7A0};
-        static const u64 closes[3] = {0x83EC8E0,0x823E760,0x823E9D0};
