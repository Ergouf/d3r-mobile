-/* Resolve the clicked row from the native list and its real item model.
-   Neither focus nor the controller's selected item is changed here. */
-static int ui_item_pick(UiPick* p, const UiItemContext* c, UiItem* item) {
-    GuestResult r;
-    for (int side = 0; side < 2; side++) {
-        u64 selection = c->side[side], container = ui_item_container(p, selection);
-        u64 vt, model, method, array, data, count, control = 0;
-        u32 model_mode, index = UINT32_MAX;
-        if (!container || !ui_inside(p, container) || !read64(selection, &vt)) continue;
-        if (vt != 0x90A4468 && vt != 0x90A3F08) continue;
-        if (!read64(selection + 0x68, &model) || !read64(model, &vt) ||
-            !read64(vt + 0x30, &method) || !ui_code(method) ||
-            !read32(model + 8, &model_mode)) continue;
-        const u64 args[] = {model, model_mode};
-        if (!guest_call(p->cpu, method, args, 2, NULL, 0, &r) || !(array = r.x0) ||
-            !read64(array, &data) || !read64(array + 8, &count) || count > 4096) continue;
-        if (!c->stash && side == 1 && count == 1) index = 0;
-        else for (size_t i = 0; i < g_ui_child_count; i++) {
-            u64 obj = g_ui_children[i].obj;
-            if (!ui_visible(p->map, obj) || !ui_within(p->map, obj, container) ||
-                !read64(obj, &vt) || !read64(vt + 0xE0, &method) ||
-                method != 0x838C6C0 || !ui_inside(p, obj)) continue;
-            UiPick hit = *p;
-            hit.owner = container; hit.focused = 0; hit.root_mode = 1; hit.visited = 0;
-            if (ui_visit(&hit, obj, 0) && hit.kind == 2 && hit.index < count &&
-                ui_visible(p->map, hit.row)) { index = hit.index; control = hit.control; break; }
-        }
-        if (index >= count || !read32(data + index * 4ull, &item->handle) ||
-            !lookup(c->table, item->handle, ENTITY_STRIDE, &item->entity)) continue;
-        const u64 loc_args[] = {item->entity};
-        if (!guest_call(p->cpu, 0x847CD50, loc_args, 1, NULL, 0, &r) ||
-            !readable(r.x0, sizeof item->location)) continue;
