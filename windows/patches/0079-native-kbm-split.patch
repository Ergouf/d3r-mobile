diff --git a/src/nx/runtime/native_guest.c b/src/nx/runtime/native_guest.c
new file mode 100644
index 0000000..d53b097
--- /dev/null
+++ b/src/nx/runtime/native_guest.c
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Native KBM bridge: guest memory access and guest calls */
+#include "nx/runtime/native_kbm.h"
+
+u64 g_stack_top;
+unsigned g_guest_call_depth;
+
+int kbm_readable(u64 address, u64 size) {
+    MemBlock b;
+    if (!address || address >= AS_END || size > AS_END - address) return 0;
+    mem_query(address, &b);
+    return (b.perm & PERM_R) && address >= b.addr && address + size <= b.addr + b.size;
+}
+int kbm_read64(u64 address, u64* out) {
+    if (!kbm_readable(address, 8)) return 0;
+    memcpy(out, GP(address), 8);
+    return 1;
+}
+int kbm_read32(u64 address, u32* out) {
+    if (!kbm_readable(address, 4)) return 0;
+    memcpy(out, GP(address), 4);
+    return 1;
+}
+
+int guest_call(const CPU* source, u64 pc, const u64* args, unsigned count,
+                      const float* floats, unsigned float_count, GuestResult* result) {
+    CPU n = *source;
+    unsigned steps = 0;
+    __atomic_add_fetch(&g_guest_call_depth, 1, __ATOMIC_ACQ_REL);
+    n.pc = pc;
+    n.x[30] = 0;
+    n.x[31] = g_stack_top;
+    n.poll = 0;
+    for (unsigned i = 0; i < 8; i++) n.x[i] = i < count ? args[i] : 0;
+    n.x[8] = 0;
+    for (unsigned i = 8; i < count; i++) memcpy(GP(g_stack_top + (i - 8) * 8), &args[i], 8);
+    for (unsigned i = 0; i < float_count; i++) {
+        memset(&n.v[i], 0, sizeof n.v[i]);
+        memcpy(&n.v[i], &floats[i], sizeof(float));
+    }
+    while (n.pc && steps++ < 16384) {
+        GuestFn f = snx_lookup(&n, n.pc);
+        if (!f) break;
+        f(&n, n.pc);
+    }
+    if (n.pc) {
+        WARN("native: world call %llx incomplete at %llx (%u steps)\n",
+             (unsigned long long)pc, (unsigned long long)n.pc, steps);
+        __atomic_sub_fetch(&g_guest_call_depth, 1, __ATOMIC_ACQ_REL);
+        return 0;
+    }
+    if (result) { result->x0 = n.x[0]; memcpy(&result->f0, &n.v[0], 4); }
+    __atomic_sub_fetch(&g_guest_call_depth, 1, __ATOMIC_ACQ_REL);
+    return 1;
+}
+
+/* The world HUD has its own KeyBinding labels. Its virtual text-setter call
+   supplies a real skill-slot binding, independently of the menu footer. */
+
+int kbm_context(const CPU* cpu, u64* ctx) {
+    u64 holder, object, block;
+    u32 slot;
+    return kbm_read64(0x914F8D0, &holder) && kbm_read64(holder, &object) &&
+        kbm_read32(object + 12, &slot) && slot < 64 && kbm_read64(cpu->tpidrro + 0x1F8, &block) &&
+        kbm_read64(block + 0x80 + slot * 8, ctx) && *ctx;
+}
+int kbm_lookup(u64 table, u32 handle, u32 stride, u64* entry) {
+    u32 limit, shift, found;
+    u64 buckets, bucket;
+    u32 index = handle & 0xFFFF;
+    if (handle == 0xFFFFFFFFu || !kbm_read32(table + 0x100, &limit) || index >= limit ||
+        !kbm_read32(table + 0x168, &shift) || shift > 16 || !kbm_read64(table + 0x120, &buckets) ||
+        !kbm_read64(buckets + ((u64)index >> shift) * 8, &bucket) || !bucket) return 0;
+    *entry = bucket + (index & ((1u << shift) - 1)) * (u64)stride;
+    return kbm_read32(*entry, &found) && found == handle;
+}
+int kbm_local_player(const CPU* cpu, u32* actor, u64* entity, u64* controller, WorldPos* pos,
+                        u64* player_object, u64* table) {
+    GuestResult r;
+    u64 ctx, a, b, c, tab, global, world;
+    u32 controller_id, controller_actor;
+    const u64 args[] = {0};
+    if (!kbm_context(cpu, &ctx) || !kbm_read64(ctx, &a) || !kbm_read64(a, &b) ||
+        !kbm_read64(b + 0x140, &c) || !c || !kbm_read64(b + 0x198, &c) || !kbm_read64(c, &tab) ||
+        !guest_call(cpu, PLAYER_PC, args, 1, NULL, 0, &r) || !r.x0 ||
+        !kbm_read32(r.x0 + 4, actor) || !kbm_read32(r.x0 + 8, &controller_id) ||
+        !kbm_lookup(tab, *actor, ENTITY_STRIDE, entity) || !kbm_readable(*entity + 0x60, 12) ||
+        !kbm_read32(*entity + 0xA0, &pos->place)) return 0;
+    memcpy(pos, GP(*entity + 0x60), 12);
+    if (!isfinite(pos->x) || !isfinite(pos->y) || !isfinite(pos->z)) return 0;
+    *table = tab;   /* entity table: keep it before the controller kbm_lookup reuses tab */
+    if (!kbm_read64(0x914F840, &global) || !kbm_read64(global + 0x10, &world) ||
+        !kbm_read64(world + 0xA98, &tab) || !kbm_lookup(tab, controller_id, CONTROLLER_STRIDE, controller) ||
+        !kbm_read32(*controller + 8, &controller_actor) || controller_actor != *actor) return 0;
+    *player_object = r.x0;
+    return 1;
+}
+
+/* Live descriptor 0x9923AD8 + 0x73*64 names this Hitpoints_Cur. */
+int kbm_actor_alive(const CPU* cpu, u64 entity) {
+    const u64 args[] = {entity, 0xFFFFF073u};
+    GuestResult r;
+    return guest_call(cpu, 0x8474B30ull, args, 2, NULL, 0, &r) &&
+           isfinite(r.f0) && r.f0 > 0;
+}
+
+/* Screen pixel -> engine camera ray, through the renderer's presentation rect. */
diff --git a/src/nx/runtime/native_kbm.h b/src/nx/runtime/native_kbm.h
new file mode 100644
index 0000000..b9bbfc2
--- /dev/null
+++ b/src/nx/runtime/native_kbm.h
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Internal interfaces of the native KBM bridge, split by job:
+   native_guest  guest memory access and guest calls
+   native_ui     UI click dispatch and page handlers
+   native_labels HUD and footer key labels
+   native_world  camera ray, movement, interaction and hook installation */
+#ifndef SNX_NATIVE_KBM_H
+#define SNX_NATIVE_KBM_H
+
+#include "nx/runtime/native_world.h"
+#include "nx/runtime/native_input.h"
+#include "nx/runtime/loader.h"
+#include "nx/runtime/rtapi.h"
+#include "nx/runtime/main.h"
+#include "nx/runtime/platform/log.h"
+#include "nx/memory/mem.h"
+#include "common/filesystem/host.h"
+#include "common/cpu/aarch64/cpu.h"
+#include <math.h>
+#include <string.h>
+#include <float.h>
+#include <stdlib.h>
+
+#define UI_PC 0x8331490ull
+#define GAME_PC 0x804F9C0ull
+#define LABEL_PC 0x83AD9D0ull
+#define HUD_LABEL_RETURN 0x841D050ull
+#define PLAYER_PC 0x8525360ull
+#define RAY_PC 0x826C7B0ull
+#define GROUND_PC 0x813E6A0ull
+#define CYLINDER_PC 0x8A35250ull
+#define PROJECT_PC 0x826CA70ull
+#define ASSIST_PC 0x80D5AF0ull
+#define WALK_PC 0x80D21F0ull
+#define SPEED_PC 0x8489AE0ull
+#define PATH_POS_PC 0x866D580ull
+#define PATH_ACTOR_PC 0x866D5C0ull
+#define CAP_POWER_PC 0x84D8790ull
+#define ACTION_PC 0x80CBA30ull
+#define ASSIST_ACTION 0x45CCFu
+#define ATTACK_POWER 0x45CCFu
+#define ATTACK_APPROACH 1.5f
+#define WORLD_STACK_SIZE 0x40000u
+#define WALK_SNO 0x777Cu
+#define PICK_MAX_DISTANCE 200.0f
+#define INTERACT_RANGE 2.8f
+#define OPERATE_RANGE 4.8f
+#define INTERACT_APPROACH 1.6f
+#define ENTITY_STRIDE 0x360u
+#define CONTROLLER_STRIDE 0x410u
+
+typedef struct { float x, y, z; u32 place; } WorldPos;
+typedef struct { float origin[3], direction[3], length; } WorldRay;
+typedef struct { float x, y; u32 width, height; u64 fallback; u32 serial, frame; } PointerPress;
+typedef struct { u64 x0; float f0; } GuestResult;
+typedef struct {
+    int active, entity_goal, submitted, attack, retries;
+    int attack_retry;
+    int stand_still;
+    u32 actor, serial, ticks, stuck;
+    WorldPos target, previous;
+    u32 handle, controller, power;
+    u32 sno;
+    WorldPos entity;
+    float approach;
+    int assist_pending;
+    int assist_pixel[2];
+    WorldPos assist_pos;
+    u32 assist_handle;
+} WalkGoal;
+typedef struct { float x, y; u32 width, height, frame; } HoverPoint;
+typedef struct { u64 owner, context, model; u32 kind, generation, mode, frame; } UiCloseTarget;
+enum { UI_CLOSE_SERVICE = 1, UI_CLOSE_CONVERSATION = 2, UI_CLOSE_PROMPT = 3 };
+typedef struct { u64 group, page; u32 enabled[6]; int current; } UiTabState;
+
+/* Shared state, one definition per owning module. */
+extern PMutex g_pointer_lock;
+extern PointerPress g_pointer;
+extern PointerPress g_skill_pointers[8];
+extern unsigned g_skill_read, g_skill_count;
+extern int g_have_pointer, g_cancel, g_enabled, g_busy;
+extern u32 g_serial;
+extern WalkGoal g_goal;
+extern int g_hold_kind;
+extern unsigned g_world_command;
+extern u32 g_command_frame;
+extern u64 g_stack_top;
+extern unsigned g_guest_call_depth;
+extern GuestFn g_label_original;
+extern GuestFn g_ui_original, g_game_original;
+
+extern PointerPress g_ui_pointers[16];
+extern unsigned g_ui_read, g_ui_count;
+extern int g_item_drag_active;
+extern HoverPoint g_hover;
+extern int g_have_hover;
+extern int g_ui_blocked;
+extern int g_hotkey_tab, g_hotkey_frames;
+extern int g_char_page;
+extern int g_char_tab;
+extern UiCloseTarget g_close_target, g_close_pending;
+extern int g_close_scope;
+extern int g_compare_requested;
+extern u64 g_compare_owner;
+extern u32 g_compare_restore;
+
+extern u64 g_footer_object;
+extern char g_footer_original[512], g_footer_display[512];
+
+/* guest */
+int kbm_readable(u64 address, size_t size);
+int kbm_read64(u64 address, u64* value);
+int kbm_read32(u64 address, u32* value);
+int guest_call(const CPU* source, u64 pc, const u64* args, unsigned arg_count,
+               const float* floats, unsigned float_count, GuestResult* result);
+int kbm_context(const CPU* cpu, u64* ctx);
+int kbm_lookup(u64 table, u32 handle, u32 stride, u64* entry);
+int kbm_local_player(const CPU* cpu, u32* actor, u64* entity, u64* controller,
+                     WorldPos* pos, u64* player_object, u64* table);
+int kbm_actor_alive(const CPU* cpu, u64 entity);
+
+/* ui: shared helpers and the frame entry points */
+u64 ui_object(u64 map, u64 key);
+u64 ui_parent(u64 map, u64 obj);
+int ui_visible(u64 map, u64 obj);
+u64 ui_path_key(const char* path);
+int ui_tab_state(u64 map, UiTabState* state);
+int ui_tab_select_slot(const CPU* cpu, u64 map, const UiTabState* state, int target);
+int ui_close_tick(const CPU* cpu, u64 map, u64 manager);
+void ui_click(const CPU* cpu, const PointerPress* press);
+void ui_hover(const CPU* cpu, const HoverPoint* hover);
+void ui_compare_tick(const CPU* cpu, u64 map);
+void ui_footer_relabel(const CPU* cpu, u64 map);
+int native_ui_queue_locked(const PointerPress* press);
+void native_ui_cancel_locked(void);
+int native_ui_take_pointer(PointerPress* press);
+int native_ui_take_hover(HoverPoint* hover);
+void native_ui_hover_point(HoverPoint* hover);
+void native_ui_hover_clear(void);
+void native_labels_install(void);
+int native_world_map_open(void);
+int pointer_pixel(const CPU* cpu, const PointerPress* p, int pixel[2]);
+
+#endif
diff --git a/src/nx/runtime/native_labels.c b/src/nx/runtime/native_labels.c
new file mode 100644
index 0000000..c5066d2
--- /dev/null
+++ b/src/nx/runtime/native_labels.c
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Native KBM bridge: HUD and footer key labels */
+#include "nx/runtime/native_kbm.h"
+
+u64 g_footer_object;
+char g_footer_original[512], g_footer_display[512];
+GuestFn g_label_original;
+
+static void world_label(CPU* cpu, u64 entry) {
+    u64 vt, setter;
+    u32 player, label_player, input_player, binding;
+    if (entry == LABEL_PC && cpu->x[30] == HUD_LABEL_RETURN && cpu->x[2] == 0 &&
+        __atomic_load_n(&g_enabled, __ATOMIC_ACQUIRE) &&
+        !__atomic_load_n(&g_guest_call_depth, __ATOMIC_ACQUIRE) &&
+        cpu->x[22] >= 0x28 && g_stack_top >= 0x17000 &&
+        kbm_read32(cpu->x[19], &player) && player == 0 &&
+        kbm_read32(cpu->x[19] + 0xDB74, &input_player) &&
+        kbm_read32(cpu->x[0] + 0x3E0, &label_player) && label_player == input_player &&
+        kbm_read64(cpu->x[0], &vt) && kbm_read64(vt + 0x110, &setter) && setter == LABEL_PC &&
+        kbm_read32(cpu->x[22] - 0x28, &binding) && binding < 8) {
+        GuestResult r;
+        const u64 args[] = {binding, cpu->x[19]};
+        /* Use the game's inverse binding kbm_lookup, including a loaded control
+           profile; the six visual HUD positions are not loadout order. */
+        if (guest_call(cpu, 0x840C650, args, 2, NULL, 0, &r) && r.x0 < 6) {
+            static const char* labels[] = {
+                "\xE5\xB7\xA6\xE9\x94\xAE", "\xE5\x8F\xB3\xE9\x94\xAE", "1", "2", "3", "4"
+            };
+            const char* text = labels[r.x0];
+            u64 replacement = g_stack_top - 0x17000;
+            size_t length = strlen(text) + 1;
+            if (kbm_readable(replacement, length)) {
+                memcpy(GP(replacement), text, length);
+                cpu->x[1] = replacement;
+            }
+        }
+    }
+    /* The real setter copies, tokenizes and lays out this string as usual. */
+    g_label_original(cpu, entry);
+}
+
+
+
+void ui_footer_relabel(const CPU* cpu, u64 map) {
+    static const struct { const char* icon; const char* label; } map_label[] = {
+        {"button1", "[\xE5\xB7\xA6\xE9\x94\xAE]"},
+        {"button2", "[Esc]"},
+        {"button3", "[Alt]"},
+        {"button4", "[\xE7\x82\xB9\xE5\x87\xBB]"},
+        {"l3", "[\xE7\x82\xB9\xE5\x87\xBB]"},
+        {"l2", "[1]"},
+        {"r2", "[3]"},
+    };
+    u64 footer, pointer;
+    u32 capacity;
+    char text[512], out[512];
+    unsigned length, o = 0;
+    int changed = 0;
+    footer = ui_object(map, ui_path_key(
+        "root.normallayer.consolebuttonlegend_main.layoutroot.buttonlegend"));
+    if (!footer || !ui_visible(map, footer) ||
+        !kbm_read64(footer + 0x398, &pointer) || !kbm_read32(footer + 0x3A0, &capacity) ||
+        !pointer || capacity < 2 || capacity > 1024 || !kbm_readable(pointer, capacity)) return;
+    length = capacity < sizeof text - 1 ? capacity : (unsigned)sizeof text - 1;
+    memcpy(text, GP(pointer), length);
+    if (!memchr(text, 0, length)) return;
+    length = (unsigned)strlen(text);
+    for (unsigned i = 0; i < length; ) {
+        if (length - i >= 7 && !strncmp(text + i, "{icon:", 6)) {
+            unsigned j = i + 6, n = 0;
+            char name[12];
+            const char* label = NULL;
+            while (text[j] && text[j] != ',' && text[j] != '}' && n + 1 < sizeof name)
+                name[n++] = text[j++];
+            name[n] = 0;
+            while (text[j] && text[j] != '}') j++;
+            if (text[j] != '}') return;
+            j++;
+            for (unsigned k = 0; n && k < sizeof map_label / sizeof map_label[0]; k++)
+                if (!strcmp(name, map_label[k].icon)) label = map_label[k].label;
+            if (label) {
+                size_t ln = strlen(label);
+                if (o + ln >= sizeof out) return;
+                memcpy(out + o, label, ln);
+                o += (unsigned)ln;
+                changed = 1;
+                i = j;
+                continue;
+            }
+        }
+        if (o + 1 >= sizeof out) return;
+        out[o++] = text[i++];
+    }
+    out[o] = 0;
+    if (!changed || o + 1 > capacity) return;
+    const u64 replacement = g_stack_top - 0x19000;
+    memcpy(GP(replacement), out, o + 1);
+    const u64 args[] = {footer, replacement, 1};
+    if (guest_call(cpu, 0x83AD9D0, args, 3, NULL, 0, NULL)) {
+        g_footer_object = footer;
+        memcpy(g_footer_original, text, length + 1);
+        memcpy(g_footer_display, out, o + 1);
+    }
+}
+
+/* The footer legend names the pad button behind each hint.  Hints are laid
+   out left to right in equal cells across the legend bar, so the click's cell
+   selects the hint and that hint's icon tag names the pad button.  Besides the
+   ABXY hints this carries the stick hints the console UI uses for actions that
+   have no child button (dye removal is L3; the party/friend hints are L1/R1). */
+
+/* Installs the HUD text hook.  The setter's entry signature is validated first,
+   so a different game build leaves the original label path untouched. */
+void native_labels_install(void) {
+    if (g_label_original || LABEL_PC < g_code_lo || LABEL_PC >= g_code_hi ||
+        HUD_LABEL_RETURN >= g_code_hi || gr32(LABEL_PC) != 0xD10303FFu ||
+        gr32(LABEL_PC + 4) != 0xA9066FFCu ||
+        gr32(HUD_LABEL_RETURN - 4) != 0xD63F0100u ||
+        gr32(HUD_LABEL_RETURN - 8) != 0x2A1F03E2u) return;
+    GuestFn* slot = &g_disp[(LABEL_PC - g_code_lo) / 4];
+    GuestFn f = __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+    if (f && f != world_label) {
+        g_label_original = f;
+        __atomic_store_n(slot, world_label, __ATOMIC_RELEASE);
+        LOG("native: HUD skill key labels installed (native text setter)\n");
+    }
+}
diff --git a/src/nx/runtime/native_ui.c b/src/nx/runtime/native_ui.c
new file mode 100644
index 0000000..e5af9ad
--- /dev/null
+++ b/src/nx/runtime/native_ui.c
@@ -0,0 +1,1930 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Native KBM bridge: UI click dispatch and page handlers */
+#include "nx/runtime/native_kbm.h"
+
+PointerPress g_ui_pointers[16];
+unsigned g_ui_read, g_ui_count;
+int g_item_drag_active;
+HoverPoint g_hover;
+int g_have_hover;
+int g_ui_blocked = 1;
+int g_hotkey_tab = -1, g_hotkey_frames;
+int g_char_page;
+int g_char_tab = -1;
+UiCloseTarget g_close_target, g_close_pending;
+int g_close_scope;
+int g_compare_requested;
+u64 g_compare_owner;
+u32 g_compare_restore;
+
+int native_ui_close_request(void) {
+    int consume;
+    pm_lock(&g_pointer_lock);
+    consume = g_close_scope;
+    if (consume && !g_close_pending.kind) {
+        g_close_pending = g_close_target;
+        g_close_pending.frame = (u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED);
+    }
+    pm_unlock(&g_pointer_lock);
+    return consume;
+}
+
+void native_ui_compare_set(int held) {
+    __atomic_store_n(&g_compare_requested, held != 0, __ATOMIC_RELEASE);
+}
+
+int native_ui_char_page(void) {
+    return __atomic_load_n(&g_char_page, __ATOMIC_ACQUIRE);
+}
+
+int native_ui_char_tab(void) {
+    return __atomic_load_n(&g_char_tab, __ATOMIC_ACQUIRE);
+}
+
+void native_ui_hotkey(int tab) {
+    if (tab < 0 || tab > 4) return;
+    __atomic_store_n(&g_hotkey_frames, 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&g_hotkey_tab, tab, __ATOMIC_RELEASE);
+    LOG("native: UI hotkey tab %d queued\n", tab);
+}
+
+
+/* UIReference holds a name key, not a pointer. +0x20/+0x28 are intrusive
+   sibling links; +0x38 is the parent reference used by the native UI code. */
+typedef struct {
+    const CPU* cpu;
+    u64 map, focused, owner, callback;
+    float point[2];
+    unsigned visited;
+    u64 control, row, hit_owner, hit_callback;
+    u32 index;
+    int kind; /* 1 = button, 2 = list row, 3 = disabled/blocked */
+    int root_mode; /* no input focus: the click chose an active subscriber root */
+    int hover; /* select wheel categories only; never activate a control */
+} UiPick;
+
+/* Registry children by parent key.  The registry is the only tree the live UI
+   exposes when a page is open without an input focus (options, main menu). */
+typedef struct {
+    u64 parent, obj;
+} UiChild;
+#define UI_CHILD_MAX 32768u
+static UiChild g_ui_children[UI_CHILD_MAX];
+static unsigned g_ui_child_count;
+
+
+static int ui_child_cmp(const void* a, const void* b) {
+    u64 pa = ((const UiChild*)a)->parent, pb = ((const UiChild*)b)->parent;
+    return pa < pb ? -1 : pa > pb;
+}
+
+static void ui_build_children(u64 map) {
+    u32 mask, total;
+    u64 buckets, node;
+    g_ui_child_count = 0;
+    if (!kbm_read32(map, &mask) || mask > 262143 || !kbm_read64(map + 0x10, &buckets) ||
+        !kbm_read32(map + 4, &total) || total > 262143) return;
+    for (u32 i = 0; i <= mask; i++) {
+        if (!kbm_read64(buckets + (u64)i * 8, &node) || !node) continue;
+        for (unsigned g = 0; node && g < 1024; g++) {
+            u64 next, obj, parent;
+            if (!kbm_read64(node, &next)) break;
+            if (kbm_read64(node + 0x10, &obj) && obj && kbm_read64(obj + 0x38, &parent) &&
+                parent != UINT64_MAX && g_ui_child_count < UI_CHILD_MAX)
+                g_ui_children[g_ui_child_count++] = (UiChild){parent, obj};
+            node = next;
+        }
+    }
+    if (g_ui_child_count)
+        qsort(g_ui_children, g_ui_child_count, sizeof(UiChild), ui_child_cmp);
+    if (g_ui_child_count == UI_CHILD_MAX)
+        LOG("native: UI child index truncated at %u\n", UI_CHILD_MAX);
+}
+
+u64 ui_object(u64 map, u64 key);
+u64 ui_parent(u64 map, u64 obj);
+int ui_visible(u64 map, u64 obj);
+
+/* Console_NextScreen (0x83C7A90) uses this navigation controller. Its first
+   group has six native slots: inventory, skills, paragon, follower, party,
+   journal. The top strip omits follower; disabled slots stay disabled. */
+typedef struct {
+    u64 open, close;
+    u32 slot;
+} UiTabSpec;
+static const UiTabSpec g_ui_tabs[5] = {
+    {0x8375340, 0x83752C0, 0},
+    {0x8386500, 0x8386AF0, 1},
+    {0x8216BF0, 0x8217490, 2},
+    {0x82224B0, 0x82224D0, 4},
+    {0x820D870, 0x820E100, 5},
+};
+
+u64 ui_path_key(const char* path) {
+    u64 key = 14695981039346656037ull;
+    for (; *path; path++) { key ^= (u8)*path; key *= 1099511628211ull; }
+    return key;
+}
+
+static int ui_within(u64 map, u64 obj, u64 ancestor) {
+    for (unsigned i = 0; obj && i < 64; i++, obj = ui_parent(map, obj))
+        if (obj == ancestor) return 1;
+    return 0;
+}
+
+int ui_tab_state(u64 map, UiTabState* state) {
+    static const char* paths[5] = {
+        "root.normallayer.consoleinventoryring_main",
+        "root.normallayer.consoleskillselection_main",
+        "root.normallayer.consoleparagon_main",
+        "root.normallayer.consoleparty_main",
+        "root.normallayer.consolejournal_main",
+    };
+    u64 holder, navigation, first, data, count;
+    u32 selected, player;
+    if (!kbm_read64(0x9152080, &holder) || !kbm_read64(holder, &navigation) ||
+        !kbm_read64(navigation, &first) || !kbm_read64(navigation + 0x108, &state->group) ||
+        !first || state->group != first || !kbm_read64(first, &data) ||
+        !kbm_read64(first + 8, &count) || count != 6 ||
+        !kbm_read32(first + 0x18, &selected) || selected >= 6 ||
+        !kbm_read32(first + 0x1C, &player) || player != 0) return 0;
+    for (unsigned i = 0; i < 6; i++)
+        if (!kbm_read32(data + i * 0x18 + 0x10, &state->enabled[i]) || state->enabled[i] > 1) return 0;
+    int visible = 0;
+    state->current = -1;
+    for (unsigned i = 0; i < 5; i++) {
+        u64 open, close, page;
+        const UiTabSpec* tab = &g_ui_tabs[i];
+        if (!kbm_read64(data + tab->slot * 0x18, &open) || open != tab->open ||
+            !kbm_read64(data + tab->slot * 0x18 + 8, &close) || close != tab->close) return 0;
+        page = ui_object(map, ui_path_key(paths[i]));
+        if (page && ui_visible(map, page)) {
+            visible++;
+            if (selected != tab->slot) return 0;
+            state->current = (int)i;
+            state->page = page;
+        }
+    }
+    return visible == 1 && state->current >= 0;
+}
+
+/* Select one verified character-page tab through the game's own page selector.
+   The caller already proved the page state with ui_tab_state. */
+int ui_tab_select_slot(const CPU* cpu, u64 map, const UiTabState* state, int target) {
+    GuestResult result;
+    u64 focus_key, focus;
+    if (target < 0 || target > 4) return 0;
+    /* A modal with its own focus owns the input even if the page behind it
+       remains visible. Never redirect a hotkey into the character group. */
+    if (!guest_call(cpu, 0x832D180, NULL, 0, NULL, 0, &result) ||
+        !kbm_read64(result.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX && (!(focus = ui_object(map, focus_key)) ||
+        !ui_visible(map, focus) || !ui_within(map, focus, state->page))) return 0;
+    u32 slot = g_ui_tabs[target].slot;
+    if (!state->enabled[slot]) {
+        LOG("native: UI tab disabled current=%d target=%d slot=%u\n", state->current, target, slot);
+        return 1;
+    }
+    if (state->current == target) {
+        LOG("native: UI tab unchanged current=%d target=%d\n", state->current, target);
+        return 1;
+    }
+    /* Native page selector: group 0, the native slot, player 0, ordinary
+       transition. No pending shoulder/confirm input is created. */
+    u64 args[4] = {0, slot, 0, 0};
+    int complete = guest_call(cpu, 0x816F550, args, 4, NULL, 0, NULL);
+    LOG("native: UI tab select current=%d target=%d slot=%u -> %s\n",
+        state->current, target, slot, complete ? "returned" : "incomplete");
+    return 1;
+}
+
+static int ui_tab_click(UiPick* p) {
+    UiTabState state = {0};
+    GuestResult result;
+    u64 parent = 0;
+    unsigned seen = 0, entries = 0;
+    int target = -1;
+    if (!ui_tab_state(p->map, &state)) return 0;
+    for (u32 i = 0; i < g_ui_child_count; i++) {
+        u64 obj = g_ui_children[i].obj, vt;
+        float r[4];
+        if (!kbm_read64(obj, &vt) || vt != 0x90ABB48 || !ui_visible(p->map, obj) ||
+            !ui_within(p->map, obj, state.page) || !kbm_readable(obj + 0x88, sizeof r)) continue;
+        memcpy(r, GP(obj + 0x88), sizeof r);
+        if (!isfinite(r[0]) || !isfinite(r[1]) || !isfinite(r[2]) || !isfinite(r[3]) ||
+            fabsf(r[1] - 39.0f) > 1.0f || r[2] - r[0] < 150.0f || r[2] - r[0] > 162.0f ||
+            r[3] - r[1] < 20.0f || r[3] - r[1] > 28.0f || r[0] < 89.0f || r[0] > 715.0f) continue;
+        int idx = (int)lroundf((r[0] - 90.0f) / 156.0f);
+        if (idx < 0 || idx > 4 || fabsf(r[0] - (90.0f + 156.0f * idx)) > 1.0f) continue;
+        if ((seen & (1u << idx)) || (parent && parent != g_ui_children[i].parent)) return 0;
+        parent = g_ui_children[i].parent;
+        seen |= 1u << idx;
+        entries++;
+        if (p->point[0] >= r[0] && p->point[0] < r[2] &&
+            p->point[1] >= r[1] && p->point[1] < r[3]) target = idx;
+    }
+    if (entries != 5 || seen != 0x1F || target < 0) return 0;
+    /* A modal with its own focus owns the pointer even if the page behind it
+       remains visible. Never redirect such a click into the character group. */
+    u64 focus_key, focus;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &result) ||
+        !kbm_read64(result.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX && (!(focus = ui_object(p->map, focus_key)) ||
+        !ui_visible(p->map, focus) || !ui_within(p->map, focus, state.page))) return 0;
+    return ui_tab_select_slot(p->cpu, p->map, &state, target);
+}
+
+/* The main-menu game settings page shows a four-entry tab strip with the
+   same native label class as the character page but its own 960-wide layout.
+   The page switches through 0x8186C90 instead of the character group setter.
+   Only visible tabs at the exact y=39 strip and the recorded x origins are
+   accepted, so the character page and world HUD cannot be redirected. */
+static int ui_settings_tab_click(UiPick* p, u32 serial) {
+    static const float origins[4] = {126.0f, 303.0f, 505.0f, 682.0f};
+    static const u64 tab_keys[4] = {
+        10326274740709475165ull, 10326271442174590532ull,
+        10326272541686218743ull, 10326269243151334110ull,
+    };
+    u64 settings, vt;
+    u32 page;
+    int seen = 0, target = -1;
+    if (!kbm_read64(0x9152940, &settings) || !settings ||
+        !kbm_read32(settings + 4, &page) || page > 4) return 0;
+    /* Vendor tab strips share the same class and geometry.  Require the four
+       registered settings labels themselves, or a vendor click would be
+       redirected into 0x8186C90. */
+    for (int k = 0; k < 4; k++) {
+        u64 tab = ui_object(p->map, tab_keys[k]);
+        if (!tab || !ui_visible(p->map, tab)) return 0;
+    }
+    for (u32 i = 0; i < g_ui_child_count; i++) {
+        u64 obj = g_ui_children[i].obj;
+        float r[4];
+        int idx = -1;
+        if (!kbm_read64(obj, &vt) || vt != 0x90ABB48 || !ui_visible(p->map, obj) ||
+            !kbm_readable(obj + 0x88, sizeof r)) continue;
+        memcpy(r, GP(obj + 0x88), sizeof r);
+        if (!isfinite(r[0]) || !isfinite(r[1]) || !isfinite(r[2]) || !isfinite(r[3]) ||
+            fabsf(r[1] - 39.0f) > 1.0f || r[2] - r[0] < 150.0f || r[2] - r[0] > 162.0f ||
+            r[3] - r[1] < 20.0f || r[3] - r[1] > 28.0f) continue;
+        for (int k = 0; k < 4; k++)
+            if (fabsf(r[0] - origins[k]) <= 1.5f) idx = k;
+        if (idx < 0 || (seen & (1 << idx))) continue;
+        seen |= 1 << idx;
+        if (p->point[0] >= r[0] && p->point[0] < r[2] &&
+            p->point[1] >= r[1] && p->point[1] < r[3]) target = idx;
+    }
+    if (seen != 0x0F || target < 0) return 0;
+    if ((u32)target == page) {
+        LOG("native: settings tab unchanged current=%u target=%d serial=%u\n",
+            page, target, serial);
+        return 1;
+    }
+    u64 args[4] = {0, (u32)target, 0, 0};
+    int complete = guest_call(p->cpu, 0x8186C90, args, 4, NULL, 0, NULL);
+    LOG("native: settings tab select current=%u target=%d serial=%u -> %s\n",
+        page, target, serial, complete ? "returned" : "incomplete");
+    return 1;
+}
+
+static int ui_code(u64 pc) {
+    return pc >= g_code_lo && pc < g_code_hi && !(pc & 3);
+}
+
+u64 ui_object(u64 map, u64 key) {
+    u32 mask, h = 0x811C9DC5u;
+    u64 buckets, node;
+    if (key == UINT64_MAX || !kbm_read32(map, &mask) || mask > 262143 ||
+        !kbm_read64(map + 0x10, &buckets)) return 0;
+    /* 0x8335350 hashes the low four bytes of the 64-bit name key. */
+    for (unsigned i = 0; i < 4; i++) h = (h ^ ((key >> (i * 8)) & 255)) * 0x1000193u;
+    if (!kbm_read64(buckets + (h & mask) * 8ull, &node)) return 0;
+    for (unsigned i = 0; node && i < 1024; i++) {
+        u64 actual, obj, identity;
+        if (!kbm_read64(node + 8, &actual)) return 0;
+        if (actual == key) {
+            if (!kbm_read64(node + 0x10, &obj) || !kbm_read64(obj + 0x30, &identity) || identity != key) return 0;
+            return obj;
+        }
+        if (!kbm_read64(node, &node)) return 0;
+    }
+    return 0;
+}
+
+u64 ui_parent(u64 map, u64 obj) {
+    u64 key;
+    return kbm_read64(obj + 0x38, &key) ? ui_object(map, key) : 0;
+}
+
+int ui_visible(u64 map, u64 obj) {
+    for (unsigned i = 0; obj && i < 64; i++) {
+        u32 flags;
+        u64 parent;
+        if (!kbm_read32(obj + 0x18, &flags) || !(flags & 4) || !kbm_read64(obj + 0x38, &parent)) return 0;
+        if (parent == UINT64_MAX) return 1;
+        obj = ui_object(map, parent);
+    }
+    return 0; /* missing parent, cycle or unbounded hierarchy */
+}
+
+static int ui_inside(UiPick* pick, u64 obj) {
+    const u64 scratch = g_stack_top - 0x1B000;
+    GuestResult r;
+    float clip[4], raw[4];
+    u64 args[3] = {obj};
+    if (!kbm_readable(obj + 0x88, 16)) return 0;
+    memcpy(raw, GP(obj + 0x88), sizeof raw);
+    for (unsigned i = 0; i < 4; i++) if (!isfinite(raw[i])) return 0;
+    if (raw[2] <= raw[0] || raw[3] <= raw[1]) return 0;
+    if (!guest_call(pick->cpu, 0x83B7EE0, args, 1, NULL, 0, &r) || !kbm_readable(r.x0, 16)) return 0;
+    args[0] = obj + 0x88; args[1] = r.x0; args[2] = scratch;
+    if (!guest_call(pick->cpu, 0x8A385B0, args, 3, NULL, 0, NULL)) return 0;
+    memcpy(clip, GP(scratch), sizeof clip);
+    for (unsigned i = 0; i < 4; i++) if (!isfinite(clip[i])) return 0;
+    return clip[2] > clip[0] && clip[3] > clip[1] &&
+           pick->point[0] >= clip[0] && pick->point[0] < clip[2] &&
+           pick->point[1] >= clip[1] && pick->point[1] < clip[3];
+}
+
+/* Service ABI whitelist shared by tabs and the service's equipment wheel. */
+typedef struct {
+    const char* name;
+    u32 group, count;
+    u64 holder, vtable;
+    u64 opens[5], closes[5];
+    u32 modes[5];
+    float left[5];
+    u64 opens_alt[5];
+    u32 modes_alt[5];
+} UiServiceSpec;
+typedef struct {
+    const UiServiceSpec* spec;
+    u64 controller, page;
+    u32 current, mode, enabled[5];
+} UiServiceState;
+
+static int ui_service_state(u64 map, UiServiceState* state) {
+    /* Every service page keeps its own navigation group, controller global,
+       controller vtable, per-slot callbacks and mode table.  The jeweller mixes
+       open-only and open+close slots, so the close callback is compared per
+       slot instead of being rejected or accepted for the whole service. */
+    static const UiServiceSpec services[] = {
+        {"vendor", 2, 4, 0x9158028, 0x90AB418,
+         {0x837DF30, 0x837DF60, 0x837DF90, 0x837DFC0},
+         {0, 0, 0, 0}, {1, 0, 2, 3},
+         {126, 303, 505, 682},
+         {0x8381E30, 0x8381E40, 0x8381E50, 0x8381E60},
+         {0, 0xFF, 0xFF, 0xFF}},
+        {"blacksmith", 5, 5, 0x91598B0, 0x90AFC60,
+         {0x8419140, 0x8419170, 0x84191A0, 0x84191D0, 0x8419200},
+         {0, 0, 0, 0, 0}, {0, 1, 2, 3, 4},
+         {90, 246, 402, 558, 714},
+         {0, 0, 0, 0, 0}, {0xFF, 0xFF, 0xFF, 0xFF, 0xFF}},
+        {"jeweler", 6, 4, 0x9159948, 0x90AFE78,
+         {0x84276A0, 0x84276D0, 0x8427720, 0x8427780},
+         {0, 0x8427700, 0x8427750, 0}, {0, 1, 2, 3},
+         {126, 303, 505, 682},
+         {0, 0, 0, 0}, {0xFF, 0xFF, 0xFF, 0xFF}},
+        {"mystic", 7, 4, 0x9153E68, 0x90A3750,
+         {0x81DFB00, 0x81DFB30, 0x81DFB60, 0x81DFB90},
+         {0, 0, 0, 0}, {0, 1, 2, 3},
+         {126, 303, 505, 682},
+         {0, 0, 0, 0}, {0xFF, 0xFF, 0xFF, 0xFF}},
+    };
+    const UiServiceSpec* service = NULL;
+    u64 holder, navigation, group, data, count, controller, page, vtable;
+    u32 current, player, active, mode, enabled[5];
+    if (!kbm_read64(0x9152080, &holder) || !holder ||
+        !kbm_read64(holder, &navigation) || !navigation ||
+        !kbm_read64(navigation + 0x108, &group) || !group) return 0;
+    for (unsigned i = 0; i < sizeof services / sizeof services[0]; i++) {
+        u64 candidate;
+        if (!kbm_read64(navigation + services[i].group * 8, &candidate) || candidate != group) continue;
+        /* Two whitelisted slots pointing at one group object would pick the
+           wrong service, so an ambiguous match is rejected instead. */
+        if (service) return 0;
+        service = &services[i];
+    }
+    if (!service || !kbm_read64(group, &data) || !kbm_read64(group + 8, &count) || count != service->count ||
+        !kbm_read32(group + 0x18, &current) || current >= service->count ||
+        !kbm_read32(group + 0x1C, &player) || player != 0 ||
+        !kbm_read64(service->holder, &holder) || !holder || !kbm_read64(holder, &controller) || !controller ||
+        !kbm_read64(controller, &vtable) || vtable != service->vtable ||
+        !kbm_read32(controller + 0xC, &player) || player != 0 ||
+        !kbm_read32(controller + 0x18, &active) || active != 1 ||
+        !kbm_read32(controller + 0x200, &mode) ||
+        (mode != service->modes[current] && mode != service->modes_alt[current])) return 0;
+    for (unsigned i = 0; i < service->count; i++) {
+        u64 open, close;
+        if (!kbm_read64(data + i * 0x18, &open) ||
+            (open != service->opens[i] && open != service->opens_alt[i]) ||
+            !kbm_read64(data + i * 0x18 + 8, &close) || close != service->closes[i] ||
+            !kbm_read32(data + i * 0x18 + 0x10, &enabled[i]) || enabled[i] > 1) return 0;
+    }
+    page = ui_object(map, ui_path_key("root.normallayer.consoleinventoryring_main"));
+    if (!page || !ui_visible(map, page)) return 0;
+    *state = (UiServiceState){.spec = service, .controller = controller, .page = page,
+                              .current = current, .mode = mode};
+    memcpy(state->enabled, enabled, sizeof enabled);
+    return 1;
+}
+
+static int ui_service_tab_click(UiPick* p, u32 serial, u64 subscribers, u32 sub_count) {
+    UiServiceState state = {0};
+    if (!sub_count || !ui_service_state(p->map, &state)) return 0;
+    const UiServiceSpec* service = state.spec;
+    u64 page = state.page;
+    u32 current = state.current;
+    const u32* enabled = state.enabled;
+    u64 parent = 0, target_obj = 0;
+    unsigned seen = 0;
+    int target = -1;
+    for (u32 i = 0; i < g_ui_child_count; i++) {
+        u64 obj = g_ui_children[i].obj, vt;
+        float rect[4];
+        if (!kbm_read64(obj, &vt) || vt != 0x90ABB48 || !ui_visible(p->map, obj) ||
+            !ui_within(p->map, obj, page) || !kbm_readable(obj + 0x88, sizeof rect)) continue;
+        memcpy(rect, GP(obj + 0x88), sizeof rect);
+        if (!isfinite(rect[0]) || !isfinite(rect[1]) || !isfinite(rect[2]) || !isfinite(rect[3]) ||
+            fabsf(rect[1] - 39.0f) > 1.0f || fabsf(rect[3] - 63.0f) > 1.0f ||
+            fabsf(rect[2] - rect[0] - 156.0f) > 1.0f) continue;
+        for (unsigned slot = 0; slot < service->count; slot++) {
+            if (fabsf(rect[0] - service->left[slot]) > 1.0f) continue;
+            if ((seen & (1u << slot)) || (parent && parent != g_ui_children[i].parent)) return 0;
+            seen |= 1u << slot;
+            parent = g_ui_children[i].parent;
+            if (p->point[0] >= rect[0] && p->point[0] < rect[2] &&
+                p->point[1] >= rect[1] && p->point[1] < rect[3]) {
+                target = (int)slot;
+                target_obj = obj;
+            }
+        }
+    }
+    if (seen != (1u << service->count) - 1 || target < 0 || !ui_inside(p, target_obj)) return 0;
+    /* Service labels have no callback table. Only the active inventory subscriber
+       authorizes their navigation group; a modal subscriber owns the click. */
+    u64 owner = ui_object(p->map, ui_path_key("root.normallayer.consoleinventoryring_main.layoutroot"));
+    /* Layer roots use reserved UIReference IDs, not FNV path keys. Normal is
+       1; the observed TopLayer root is 3. Reject every other input layer. */
+    u64 normal = ui_object(p->map, 1);
+    if (!normal || !ui_visible(p->map, normal)) return 1;
+    int subscribed = 0;
+    for (u32 i = 0; i < sub_count; i++) {
+        u64 obj, vt, method, table, callback;
+        if (!kbm_read64(subscribers + i * 8ull, &obj)) return 1;
+        if (!obj || !ui_visible(p->map, obj)) continue;
+        if (!ui_within(p->map, obj, normal)) {
+            LOG("native: UI %s tab %u blocked by other input layer\n", service->name, serial);
+            return 1;
+        }
+        if (!kbm_read64(obj, &vt) || !kbm_read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+            !kbm_read64(obj + 0x118, &table) || !table || !kbm_read64(table + 0x20, &callback) ||
+            !ui_code(callback)) continue;
+        if (!ui_within(p->map, obj, page)) {
+            LOG("native: UI %s tab %u blocked by other callback owner\n", service->name, serial);
+            return 1;
+        }
+        if (obj == owner && callback == 0x81FB910) subscribed = 1;
+    }
+    GuestResult result;
+    u64 focus_key, focus;
+    if (!subscribed || !guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &result) ||
+        !kbm_read64(result.x0, &focus_key)) return 1;
+    if (focus_key != UINT64_MAX && (!(focus = ui_object(p->map, focus_key)) ||
+        !ui_visible(p->map, focus) || !ui_within(p->map, focus, page))) {
+        LOG("native: UI %s tab %u blocked by focus\n", service->name, serial);
+        return 1;
+    }
+    if (!enabled[target] || current == (u32)target) {
+        LOG("native: UI %s tab %u %s current=%u target=%d\n", service->name, serial,
+            enabled[target] ? "unchanged" : "disabled", current, target);
+        return 1;
+    }
+    /* Select this service's exact group; never send a global confirm. */
+    u64 args[4] = {service->group, (u32)target, 0, 0};
+    int complete = guest_call(p->cpu, 0x816F550, args, 4, NULL, 0, NULL);
+    LOG("native: UI service %s tab %u group=%u current=%u target=%d -> %s\n", service->name,
+        serial, service->group, current, target, complete ? "returned" : "incomplete");
+    return 1;
+}
+
+static int ui_visit(UiPick* p, u64 obj, unsigned depth) {
+    u64 vt, method, data;
+    u32 flags, count;
+    GuestResult r;
+    if (!obj || ++p->visited > 20000 || depth > 48 || !kbm_read32(obj + 0x18, &flags) ||
+        !kbm_read64(obj, &vt)) return 0;
+    int visible = (flags & 4) != 0;
+    if (!kbm_read64(vt + 0xE0, &method)) return 0;
+    if (method == 0x838C6C0 && (obj == p->focused || p->root_mode) && ui_inside(p, obj)) {
+        u64 model, model_vt, size_pc, allow_pc;
+        u32 page, columns;
+        if (!kbm_read64(obj + 0x258, &model) || !kbm_read64(model, &model_vt) ||
+            !kbm_read64(model_vt + 0x10, &size_pc) || !ui_code(size_pc) ||
+            !kbm_read64(model_vt + 0x30, &allow_pc) || !ui_code(allow_pc) ||
+            !kbm_read64(obj + 0x210, &data) || !kbm_read32(obj + 0x218, &count) || count > 4096 ||
+            !kbm_read32(obj + 0x1E4, &page) || !kbm_read32(obj + 0x2A4, &columns)) return 0;
+        u64 args[3] = {model};
+        if (!guest_call(p->cpu, size_pc, args, 1, NULL, 0, &r) || r.x0 > 65536) return 0;
+        u32 size = (u32)r.x0;
+        for (u32 i = count; i-- > 0;) {
+            u64 key, row;
+            i64 index = (i32)page < 0 ? -1 : (i64)page * columns + i;
+            if (!kbm_read64(data + i * 8ull, &key) || !(row = ui_object(p->map, key)) ||
+                index < 0 || index >= size || !ui_inside(p, row)) continue;
+            args[0] = model; args[1] = obj; args[2] = (u32)index;
+            if (!guest_call(p->cpu, allow_pc, args, 3, NULL, 0, &r)) return 0;
+            p->kind = r.x0 ? 2 : 3;
+            p->control = obj; p->row = row; p->index = (u32)index;
+            p->hit_owner = p->owner; p->hit_callback = p->callback;
+            return 1;
+        }
+    }
+    if (!visible && !p->root_mode) return 0;
+    u64 key, parent_key;
+    if (!kbm_read64(obj + 0x30, &key)) return 0;
+    unsigned kids = 0;
+    size_t lo = 0, hi = g_ui_child_count;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        if (g_ui_children[mid].parent < key) lo = mid + 1; else hi = mid;
+    }
+    for (size_t j = lo; j < g_ui_child_count && g_ui_children[j].parent == key; j++) {
+        kids++;
+        if (ui_visit(p, g_ui_children[j].obj, depth + 1)) return 1;
+    }
+    if (!kids && kbm_read32(obj + 0x68, &count) && count <= 4096 && kbm_read64(obj + 0x60, &data)) {
+        for (u32 i = count; i-- > 0;) {
+            u64 child;
+            if (kbm_read64(data + i * 24ull + 8, &child) && ui_visit(p, child, depth + 1)) return 1;
+        }
+    }
+    if (kbm_read64(vt + 0x60, &method) && method == 0x8392410 && ui_inside(p, obj)) {
+        u32 enabled;
+        u64 table, cb, predicate;
+        if (!kbm_read32(obj + 0x3C8, &enabled) || !kbm_read64(obj + 0x118, &table) ||
+            !kbm_read64(table, &cb) || !ui_code(cb)) return 0;
+        p->kind = (enabled & 1) ? 1 : 3;
+        if (p->kind == 1 && kbm_read64(obj + 0x488, &predicate) && predicate) {
+            const u64 args[] = {obj + 0x30};
+            if (!ui_code(predicate) || !guest_call(p->cpu, predicate, args, 1, NULL, 0, &r) || !r.x0)
+                p->kind = 3;
+        }
+        p->control = p->hit_owner = obj; p->hit_callback = cb;
+        return 1;
+    }
+    return 0;
+}
+
+
+
+/* The main menu's confirm callback lives on a subscribed sibling proxy, not
+   on the list's parent chain.  Bind only this observed page/list/callback pair;
+   arbitrary page siblings may operate a different focused control. */
+static u64 ui_main_menu_owner(UiPick* p, u64 entries, u32 count) {
+    u64 reference, key, parent = ui_parent(p->map, p->focused), owner = 0;
+    if (!parent || !kbm_read64(0x91560D0, &reference) || !kbm_read64(reference, &key) ||
+        ui_object(p->map, key) != p->focused) return 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, table, callback, candidate_key;
+        if (!kbm_read64(entries + (u64)i * 8, &obj) || !obj ||
+            !kbm_read64(obj + 0x30, &candidate_key) || ui_object(p->map, candidate_key) != obj ||
+            ui_parent(p->map, obj) != parent || !ui_visible(p->map, obj) ||
+            !kbm_read64(obj, &vt) || !kbm_read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+            !kbm_read64(obj + 0x118, &table) || !kbm_read64(table + 0x20, &callback) ||
+            callback != 0x8366870) continue;
+        if (owner) return 0; /* ambiguous subscription: do not guess */
+        owner = obj;
+    }
+    if (owner) p->callback = 0x8366870;
+    return owner;
+}
+
+typedef struct {
+    const char* name;
+    u32 slot;
+} UiEquipSlot;
+
+/* The inventory ring's icon widgets have no click callback.  The game's
+   controller setter 0x81FCFD0 changes +0x150 and refreshes the item details
+   and prompt.  0x837CDA0 is navigation, not a slot setter: its second
+   argument is not the target slot.  +0x200 is 0xFFFF on a freshly opened
+   page and is not a selection gate; +0x204 is not updated by 0x81FCFD0. */
+static int ui_wheel_allowed(UiPick* p, u64 manager) {
+    UiTabState state = {0};
+    u64 subs, entries, normal, owner;
+    u32 count;
+    if (ui_tab_state(p->map, &state)) {
+        if (state.current != 0 && state.current != 1) return 0;
+    } else {
+        UiServiceState service = {0};
+        if (!ui_service_state(p->map, &service)) return 0;
+        state.page = service.page;
+        state.current = 0; /* services share the inventory page and callback */
+    }
+    if (!kbm_read64(manager + 0x10, &subs) || !kbm_read64(subs, &entries) ||
+        !kbm_read32(subs + 8, &count) || !count || count > 1024) return 0;
+    normal = ui_object(p->map, 1);
+    owner = ui_object(p->map, ui_path_key(state.current == 0 ?
+        "root.normallayer.consoleinventoryring_main.layoutroot" :
+        "root.normallayer.consoleskillselection_main.layoutroot"));
+    if (!normal || !owner || !ui_visible(p->map, normal)) return 0;
+    int subscribed = 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, table, callback;
+        if (!kbm_read64(entries + i * 8ull, &obj)) return 0;
+        if (!obj || !ui_visible(p->map, obj)) continue;
+        if (!ui_within(p->map, obj, normal)) return 0;
+        if (!kbm_read64(obj, &vt) || !kbm_read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+            !kbm_read64(obj + 0x118, &table) || !table || !kbm_read64(table + 0x20, &callback) ||
+            !ui_code(callback)) continue;
+        if (!ui_within(p->map, obj, state.page)) return 0;
+        if (obj == owner && callback == (state.current == 0 ? 0x81FB910ull : 0x8387180ull))
+            subscribed = 1;
+    }
+    return subscribed;
+}
+
+/* A normal page must own the focus and every visible callback subscription.
+   This keeps a service or conversation from closing behind another dialog. */
+static int ui_close_page_allowed(u64 map, u64 manager, u64 focus, u64 first, u64 second) {
+    u64 subs, entries, normal;
+    u32 count;
+    if (!focus || (!ui_within(map, focus, first) &&
+                   (!second || !ui_within(map, focus, second))) ||
+        !kbm_read64(manager + 0x10, &subs) || !kbm_read64(subs, &entries) ||
+        !kbm_read32(subs + 8, &count) || !count || count > 1024 ||
+        !(normal = ui_object(map, 1))) return 0;
+    int subscribed = 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, callbacks, callback;
+        if (!kbm_read64(entries + i * 8ull, &obj)) return 0;
+        if (!obj || !ui_visible(map, obj)) continue;
+        if (!ui_within(map, obj, normal)) return 0;
+        if (!kbm_read64(obj, &vt) || !kbm_read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+            !kbm_read64(obj + 0x118, &callbacks) || !kbm_read64(callbacks + 0x20, &callback) ||
+            !ui_code(callback)) continue;
+        if (!ui_within(map, obj, first) && (!second || !ui_within(map, obj, second))) return 0;
+        subscribed = 1;
+    }
+    return subscribed;
+}
+
+/* Return whether Space belongs to a known closeable UI, even when its focus
+   guard rejects the action. Rejection must never fall through to confirm. */
+static int ui_close_target(const CPU* cpu, u64 map, u64 manager, UiCloseTarget* target) {
+    u64 holder, navigation, focus_key, focus = 0, model;
+    u32 modal_count;
+    GuestResult r;
+    *target = (UiCloseTarget){0};
+    if (!map || !manager || !kbm_read64(0x9152080, &holder) ||
+        !kbm_read64(holder, &navigation) || !navigation ||
+        !kbm_read32(navigation + 0xAE8, &modal_count) || modal_count > 32) return 0;
+    if (guest_call(cpu, 0x832D180, NULL, 0, NULL, 0, &r) &&
+        kbm_read64(r.x0, &focus_key) && focus_key != UINT64_MAX) {
+        focus = ui_object(map, focus_key);
+        if (!focus || !ui_visible(map, focus)) focus = 0;
+    }
+    if (modal_count) {
+        u32 generation, style, player;
+        if (!focus || !kbm_read64(navigation + 0xAD8, &model) || !model ||
+            !kbm_read32(model, &generation) || !kbm_read32(model + 0xC, &player) ||
+            (player != 0 && player != UINT32_MAX) ||
+            !kbm_read32(model + 0xD0, &style) || style < 2 || style > 3) return 1;
+        for (u64 owner = focus, depth = 0; owner && depth < 64; depth++, owner = ui_parent(map, owner)) {
+            u64 vt, method, callbacks, callback;
+            if (!ui_visible(map, owner)) break;
+            if (!kbm_read64(owner, &vt) || !kbm_read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+                !kbm_read64(owner + 0x118, &callbacks) ||
+                !kbm_read64(callbacks + 0x20, &callback) || callback != 0x816AAB0) continue;
+            *target = (UiCloseTarget){owner, navigation, model, UI_CLOSE_PROMPT, generation, style, 0};
+            break;
+        }
+        return 1;
+    }
+    UiServiceState service = {0};
+    if (ui_service_state(map, &service)) {
+        UiPick p = {.cpu = cpu, .map = map};
+        u64 group;
+        if (ui_wheel_allowed(&p, manager) &&
+            ui_close_page_allowed(map, manager, focus, service.page, 0) &&
+            kbm_read64(navigation + 0x108, &group))
+            *target = (UiCloseTarget){service.controller, navigation, group, UI_CLOSE_SERVICE,
+                                     service.spec->group, service.current, 0};
+        return 1;
+    }
+    u64 options = ui_object(map, ui_path_key("root.normallayer.consoleconversationoptions_main"));
+    u64 dialog = ui_object(map, ui_path_key("root.normallayer.consoleconversationdialog_main"));
+    u32 player;
+    if (((options && ui_visible(map, options)) || (dialog && ui_visible(map, dialog))) &&
+        kbm_read32(manager + 0x58, &player) && player == 0) {
+        u64 options_ref, dialog_ref, options_key, dialog_key;
+        u32 actor;
+        if (kbm_read64(0x9154340, &options_ref) && kbm_read64(options_ref, &options_key) &&
+            ui_object(map, options_key) == options &&
+            kbm_read64(0x9154338, &dialog_ref) && kbm_read64(dialog_ref, &dialog_key) &&
+            ui_object(map, dialog_key) == dialog && kbm_read32(0x97F3840, &actor) &&
+            ui_close_page_allowed(map, manager, focus, options, dialog)) {
+            u64 owner = ui_within(map, focus, options) ? options : dialog;
+            *target = (UiCloseTarget){owner, manager, 0, UI_CLOSE_CONVERSATION, actor, 0, 0};
+        }
+        return 1;
+    }
+    return 0;
+}
+
+int ui_close_tick(const CPU* cpu, u64 map, u64 manager) {
+    UiCloseTarget current = {0}, pending;
+    int scope = ui_close_target(cpu, map, manager, &current);
+    pm_lock(&g_pointer_lock);
+    pending = g_close_pending;
+    g_close_pending = (UiCloseTarget){0};
+    g_close_target = current;
+    g_close_scope = scope;
+    pm_unlock(&g_pointer_lock);
+    if (!pending.kind || (u32)((u32)__atomic_load_n(&g_frames, __ATOMIC_RELAXED) - pending.frame) > 4 ||
+        pending.kind != current.kind || pending.owner != current.owner ||
+        pending.context != current.context || pending.model != current.model ||
+        pending.generation != current.generation || pending.mode != current.mode) return 0;
+    u64 callback, args[2] = {0, 0};
+    unsigned count;
+    if (current.kind == UI_CLOSE_SERVICE) {
+        /* Native navigation-stack close, also used by the service's Back branch. */
+        callback = 0x816BB90; args[0] = 1; count = 2;
+    } else if (current.kind == UI_CLOSE_CONVERSATION) {
+        /* Native cancel hides both conversation roots and sends end-conversation. */
+        callback = 0x820EF90; args[0] = current.owner + 0x30; count = 2;
+    } else {
+        /* Native prompt cancel; never invoke its accept callback 0x816AAB0. */
+        callback = 0x816A9C0; count = 0;
+    }
+    int complete = guest_call(cpu, callback, args, count, NULL, 0, NULL);
+    LOG("native: UI Space close kind=%u owner=%llx -> %s\n", current.kind,
+        (unsigned long long)current.owner, complete ? "returned" : "incomplete");
+    native_world_cancel();
+    return 1; /* A close attempt consumes this frame's stale clicks and motion. */
+}
+
+static int ui_text_contains(u64 obj, const char* needle) {
+    u64 pointer;
+    u32 capacity;
+    char text[512];
+    unsigned length;
+    if (!kbm_read64(obj + 0x398, &pointer) || !kbm_read32(obj + 0x3A0, &capacity) ||
+        !pointer || !capacity || capacity > 1024 || !kbm_readable(pointer, capacity)) return 0;
+    length = capacity < sizeof text - 1 ? capacity : sizeof text - 1;
+    memcpy(text, GP(pointer), length);
+    text[length] = 0;
+    return strstr(text, needle) != NULL;
+}
+
+/* Console menus expose the A action as a footer legend rather than a child
+   button. This click maps only the leftmost craft hint, after verifying the
+   service, page, controller, wheel/focus/overlay gate and exact legend. */
+/* Some towns keep several cached copies of the vendor tab strip in the
+   registry.  The strict per-slot callback whitelist then sees duplicate slots
+   and refuses the click.  This narrower fallback accepts only the verified
+   vendor group/controller and the four fixed tab rectangles, so cached copies
+   cannot retarget another service. */
+static int ui_vendor_tab_click_fallback(UiPick* p, u32 serial) {
+    static const float left[4] = {126.0f, 303.0f, 505.0f, 682.0f};
+    u64 holder, nav, group, entry, holder2, controller, vt, data, count64;
+    u32 current, player, active, mode;
+    int target = -1;
+    if (!kbm_read64(0x9152080, &holder) || !holder ||
+        !kbm_read64(holder, &nav) || !nav ||
+        !kbm_read64(nav + 0x108, &group) || !group ||
+        !kbm_read64(nav + 2 * 8, &entry) || entry != group) return 0;
+    if (!kbm_read64(0x9158028, &holder2) || !holder2 ||
+        !kbm_read64(holder2, &controller) || !controller ||
+        !kbm_read64(controller, &vt) || vt != 0x90AB418 ||
+        !kbm_read32(controller + 0x18, &active) || active != 1 ||
+        !kbm_read32(controller + 0xC, &player) || player != 0 ||
+        !kbm_read32(controller + 0x200, &mode)) return 0;
+    if (!kbm_read64(group, &data) || !kbm_read64(group + 8, &count64) || count64 != 4 ||
+        !kbm_read32(group + 0x18, &current) || current >= 4) return 0;
+    if (p->point[1] < 39.0f || p->point[1] >= 63.0f) return 0;
+    for (int i = 0; i < 4; i++)
+        if (p->point[0] >= left[i] && p->point[0] < left[i] + 156.0f) target = i;
+    if (target < 0) return 0;
+    if ((u32)target == current) {
+        LOG("native: vendor tab unchanged current=%u target=%d serial=%u mode=%u\n",
+            current, target, serial, mode);
+        return 1;
+    }
+    u64 args[4] = {2, (u32)target, 0, 0};
+    int complete = guest_call(p->cpu, 0x816F550, args, 4, NULL, 0, NULL);
+    LOG("native: vendor tab fallback current=%u target=%d serial=%u mode=%u -> %s\n",
+        current, target, serial, mode, complete ? "returned" : "incomplete");
+    return 1;
+}
+
+/* The stash moves an item between the bag and the shared chest with the A
+   action, which the console UI only exposes as a footer legend.  Accept a
+   click on the leftmost legend region when that exact legend is on screen. */
+/* Option rows toggle with A and the console UI only shows it as a 切换 footer. */
+static int ui_options_toggle_click(UiPick* p, u32 serial) {
+    static const char toggle[] = "\xE5\x88\x87\xE6\x8D\xA2";
+    u64 footer;
