-/* The main-menu game settings page shows a four-entry tab strip with the
-   same native label class as the character page but its own 960-wide layout.
-   The page switches through 0x8186C90 instead of the character group setter.
-   Only visible tabs at the exact y=39 strip and the recorded x origins are
-   accepted, so the character page and world HUD cannot be redirected. */
-static int ui_settings_tab_click(UiPick* p, u32 serial) {
-    static const float origins[4] = {126.0f, 303.0f, 505.0f, 682.0f};
-    static const u64 tab_keys[4] = {
-        10326274740709475165ull, 10326271442174590532ull,
-        10326272541686218743ull, 10326269243151334110ull,
-    };
-    u64 settings, vt;
-    u32 page;
-    int seen = 0, target = -1;
-    if (!read64(0x9152940, &settings) || !settings ||
-        !read32(settings + 4, &page) || page > 4) return 0;
-    /* Vendor tab strips share the same class and geometry.  Require the four
-       registered settings labels themselves, or a vendor click would be
-       redirected into 0x8186C90. */
-    for (int k = 0; k < 4; k++) {
-        u64 tab = ui_object(p->map, tab_keys[k]);
-        if (!tab || !ui_visible(p->map, tab)) return 0;
-    }
-    for (u32 i = 0; i < g_ui_child_count; i++) {
-        u64 obj = g_ui_children[i].obj;
-        float r[4];
-        int idx = -1;
-        if (!read64(obj, &vt) || vt != 0x90ABB48 || !ui_visible(p->map, obj) ||
-            !readable(obj + 0x88, sizeof r)) continue;
-        memcpy(r, GP(obj + 0x88), sizeof r);
-        if (!isfinite(r[0]) || !isfinite(r[1]) || !isfinite(r[2]) || !isfinite(r[3]) ||
-            fabsf(r[1] - 39.0f) > 1.0f || r[2] - r[0] < 150.0f || r[2] - r[0] > 162.0f ||
-            r[3] - r[1] < 20.0f || r[3] - r[1] > 28.0f) continue;
-        for (int k = 0; k < 4; k++)
-            if (fabsf(r[0] - origins[k]) <= 1.5f) idx = k;
-        if (idx < 0 || (seen & (1 << idx))) continue;
-        seen |= 1 << idx;
-        if (p->point[0] >= r[0] && p->point[0] < r[2] &&
-            p->point[1] >= r[1] && p->point[1] < r[3]) target = idx;
-    }
-    if (seen != 0x0F || target < 0) return 0;
-    if ((u32)target == page) {
-        LOG("native: settings tab unchanged current=%u target=%d serial=%u\n",
-            page, target, serial);
-        return 1;
-    }
-    u64 args[4] = {0, (u32)target, 0, 0};
-    int complete = guest_call(p->cpu, 0x8186C90, args, 4, NULL, 0, NULL);
-    LOG("native: settings tab select current=%u target=%d serial=%u -> %s\n",
-        page, target, serial, complete ? "returned" : "incomplete");
-    return 1;
-}
