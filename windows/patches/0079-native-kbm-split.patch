+        }
+        memcpy(GP(scratch + 0x80), cylinder, sizeof cylinder);
+        /* Entity collision bounds, native ray test and native terrain depth.
+           No projected-nearest or generic confirm fallback may retarget a click. */
+        u64 args[3] = {scratch, scratch + 0x80, hit};
+        if (!guest_call(cpu, CYLINDER_PC, args, 3, NULL, 0, &r)) return -1;
+        if (!r.x0) continue;
+        memcpy(&depth, GP(hit), 4);
+        if (!isfinite(depth) || depth < 0 || depth >= best) continue;
+        args[0] = entry;
+        /* An incomplete capability query is unknown, not "no power": skip it
+           instead of turning a door or an NPC into an attack target. */
+        if (!guest_call(cpu, CAP_POWER_PC, args, 1, NULL, 0, &r)) continue;
+        u32 cap = ((i32)r.x0 > 0 && (u32)r.x0 != ASSIST_ACTION) ? (u32)r.x0 : 0;
