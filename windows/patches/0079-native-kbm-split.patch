-static int pick_entity(const CPU* cpu, u64 table, const WorldRay* ray, float occlusion,
-                       const WorldPos* pos, u32 player_actor, WalkGoal* goal) {
-    const u64 scratch = g_stack_top - 0x1D000, hit = scratch + 0x40;
-    u32 limit, shift;
-    u64 buckets;
-    float best = fminf(occlusion, ray->length) + 0.05f;
-    float player_radius = 0;
-    u64 player_entry;
-    if (lookup(table, player_actor, ENTITY_STRIDE, &player_entry) && readable(player_entry + 0x90, 4)) {
-        memcpy(&player_radius, GP(player_entry + 0x90), 4);
-        if (!isfinite(player_radius) || player_radius <= 0 || player_radius > 64) player_radius = 0;
-    }
-    int found = 0;
-    u32 hit_cap = 0;
-    int portal_found = 0;
-    float portal_dist = 0, portal_radius = 0;
-    u64 portal_id = 0, portal_cid = 0, portal_entry = 0;
-    u32 portal_sno = 0;
-    WorldPos portal_pos = {0};
-    if (!read32(table + 0x100, &limit) || !read32(table + 0x168, &shift) || shift > 16 ||
-        limit > 65536 || !read64(table + 0x120, &buckets)) return -1;
-    memcpy(GP(scratch), ray, sizeof *ray);
-    for (u32 i = 0; i < limit; i++) {
-        u64 bucket, entry;
-        u32 id, place, cid, actor_type, sno;
-        float cylinder[5], p[3], depth;
-        GuestResult r;
-        if (!read64(buckets + ((u64)i >> shift) * 8, &bucket) || !bucket) continue;
-        entry = bucket + (u64)(i & ((1u << shift) - 1)) * ENTITY_STRIDE;
-        if (!read32(entry, &id) || !id || (id & 0xFFFF) != i || id == 0xFFFFFFFFu || id == player_actor ||
-            !read32(entry + 0xA0, &place) || place != pos->place ||
-            !read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu ||
-            !readable(entry + 0x60, 12) || !readable(entry + 0x80, sizeof cylinder)) continue;
-        memcpy(p, GP(entry + 0x60), sizeof p);
-        memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
-        if (!read32(entry + 0x18, &sno)) sno = 0;
-        /* The rift portal sits on the obelisk's spot and exposes no clickable
-           cylinder, so the obelisk wins every ray and the portal can never be
-           clicked.  Remember it by position; a winning hit on the same spot is
-           retargeted to it after the loop. */
-        if (sno == RIFT_PORTAL_SNO) {
-            float pd = hypotf(p[0] - pos->x, p[1] - pos->y);
-            if (!portal_found || pd < portal_dist) {
-                portal_found = 1; portal_dist = pd; portal_id = id; portal_cid = cid;
-                portal_entry = entry; portal_sno = sno; portal_radius = cylinder[4];
-                portal_pos = (WorldPos){p[0], p[1], p[2], place};
-                LOG("native: rift portal %08x seen at %.2f radius %.2f\n", id, pd, cylinder[4]);
-            }
-        }
-        int finite = 1;
-        for (unsigned j = 0; j < 5; j++) if (!isfinite(cylinder[j])) finite = 0;
-        if (!finite || cylinder[3] <= 0 || cylinder[4] <= 0 ||
-            hypotf(p[0] - pos->x, p[1] - pos->y) > PICK_MAX_DISTANCE) continue;
-        /* Character bounds retain their spawn position in +0x80.  Intersect
-           their current location; static gizmos keep their authored offset. */
-        if (read32(entry + 0x14C, &actor_type) && actor_type == 1) {
-            cylinder[0] = p[0]; cylinder[1] = p[1]; cylinder[2] = p[2];
-        }
-        memcpy(GP(scratch + 0x80), cylinder, sizeof cylinder);
-        /* Entity collision bounds, native ray test and native terrain depth.
-           No projected-nearest or generic confirm fallback may retarget a click. */
-        u64 args[3] = {scratch, scratch + 0x80, hit};
-        if (!guest_call(cpu, CYLINDER_PC, args, 3, NULL, 0, &r)) return -1;
-        if (!r.x0) continue;
-        memcpy(&depth, GP(hit), 4);
-        if (!isfinite(depth) || depth < 0 || depth >= best) continue;
-        args[0] = entry;
-        /* An incomplete capability query is unknown, not "no power": skip it
-           instead of turning a door or an NPC into an attack target. */
-        if (!guest_call(cpu, CAP_POWER_PC, args, 1, NULL, 0, &r)) continue;
-        u32 cap = ((i32)r.x0 > 0 && (u32)r.x0 != ASSIST_ACTION) ? (u32)r.x0 : 0;
-        if (!cap && (!player_radius || cylinder[4] > 64)) return -1;
-        hit_cap = cap;
-        best = depth;
-        found = 1;
-        goal->handle = id;
-        goal->controller = cid;
-        goal->entity = (WorldPos){p[0], p[1], p[2], place};
-        goal->attack = cap == 0;
-        goal->power = cap ? cap : ATTACK_POWER;
-        goal->sno = sno;
-        /* entity+0x80 is {x, y, base_z, height, radius}: [3] is the height and
-           [4] the radius (0x8A34FA0 squares [4] for the horizontal test and adds
-           [3] for the top).  Stand outside the radius, with a margin, and clamp
-           so a very wide object still leaves a reachable walk point. */
-        if (cap && walk_into_sno(sno))
-            goal->approach = 0.9f;
-        else
-            goal->approach = cap ? fmaxf(INTERACT_APPROACH, fminf(cylinder[4] + 0.8f, 4.0f))
-                                 : fmaxf(ATTACK_APPROACH, cylinder[4] + player_radius + 0.2f);
-    }
-    if (portal_found && goal->sno != RIFT_PORTAL_SNO &&
-        hypotf(goal->entity.x - portal_pos.x, goal->entity.y - portal_pos.y) <= 1.5f) {
-        GuestResult r;
-        u64 args[1] = {portal_entry};
-        u32 cap = 0;
-        if (!guest_call(cpu, CAP_POWER_PC, args, 1, NULL, 0, &r)) return -1;
-        if ((i32)r.x0 > 0 && (u32)r.x0 != ASSIST_ACTION) cap = (u32)r.x0;
-        u32 loser = goal->sno;
-        goal->handle = portal_id;
-        goal->controller = portal_cid;
-        goal->entity = portal_pos;
-        goal->attack = cap == 0;
-        goal->power = cap ? cap : ATTACK_POWER;
-        goal->sno = portal_sno;
-        goal->approach = cap ? fmaxf(INTERACT_APPROACH, fminf(portal_radius + 0.8f, 4.0f))
-                             : fmaxf(ATTACK_APPROACH, portal_radius + player_radius + 0.2f);
-        found = 1; hit_cap = cap;
-        LOG("native: rift portal %08x retargeted over sno %u radius %.2f\n",
-            portal_id, loser, portal_radius);
-    }
-    if (found > 0) LOG("native: cylinder hit %08x sno %u depth %.3f terrain %.3f power %d%s\n",
-                      goal->handle, goal->sno, best, occlusion, (int)hit_cap,
-                      goal->attack ? " (attack)" : "");
-    return found;
-}
