-static int door_candidate_near(const CPU* cpu, u64 table, const WorldPos* pos,
-                               const WorldRay* ray, float occlusion, int ground_ok,
-                               const int pixel[2], WorldPos* found, u32* found_handle,
-                               u32* found_controller, u32* found_power, u32* found_sno) {
-    u32 limit, shift;
-    u64 buckets;
-    float best = 24.0f;
-    int hit = 0;
-    /* ground_target leaves FLT_MAX on failure; it is not an unobstructed ray. */
-    if (!ground_ok || !isfinite(occlusion) || occlusion < 0 || occlusion == FLT_MAX ||
-        !isfinite(ray->length) || ray->length <= 0) return 0;
-    if (!read32(table + 0x100, &limit) || !read32(table + 0x168, &shift) || shift > 16 ||
-        limit > 65536 || !read64(table + 0x120, &buckets)) return 0;
-    for (u32 i = 0; i < limit; i++) {
-        u64 bucket, entry;
-        u32 id, place, cid, sno;
-        float p[3], cylinder[5], base[2], top[2];
-        if (!read64(buckets + ((u64)i >> shift) * 8, &bucket) || !bucket) continue;
-        entry = bucket + (u64)(i & ((1u << shift) - 1)) * ENTITY_STRIDE;
-        if (!read32(entry, &id) || !id || id == 0xFFFFFFFFu || (id & 0xFFFF) != i ||
-            !read32(entry + 0xA0, &place) || place != pos->place ||
-            !read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu ||
-            !read32(entry + 0x18, &sno) || !door_sno(sno) ||
-            !readable(entry + 0x60, 12) || !readable(entry + 0x80, sizeof cylinder)) continue;
-        memcpy(p, GP(entry + 0x60), sizeof p);
-        memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
-        LOG("native: door probe %08x sno %u dist %.2f cylinder %.2f\n", id, sno,
-            hypotf(p[0] - pos->x, p[1] - pos->y), cylinder[4]);
-        if (!isfinite(cylinder[4]) || cylinder[4] < 0 || cylinder[4] > 64 ||
-            !isfinite(cylinder[3]) || cylinder[3] < 0 || cylinder[3] > 128) {
-            LOG("native: door skip %08x cylinder %.2f\n", id, cylinder[4]);
-            continue;
-        }
-        if (hypotf(p[0] - pos->x, p[1] - pos->y) > 120.0f) continue;
-        if (!project_point(cpu, place, p[0], p[1], p[2], base)) continue;
-        float height = cylinder[3] > 0 ? fminf(cylinder[3], 24.0f) : 2.0f;
-        if (!project_point(cpu, place, p[0], p[1], p[2] + height, top)) {
-            top[0] = base[0]; top[1] = base[1];
-        }
-        float y0 = fminf(base[1], top[1]), y1 = fmaxf(base[1], top[1]);
-        float cy = pixel[1] < y0 ? y0 : (pixel[1] > y1 ? y1 : pixel[1]);
-        float dx = pixel[0] - (base[0] + top[0]) * 0.5f;
-        float d = hypotf(dx, pixel[1] - cy);
-        if (d > best) continue;
-        float depth = (p[0] - ray->origin[0]) * ray->direction[0] +
-                      (p[1] - ray->origin[1]) * ray->direction[1] +
-                      (p[2] - ray->origin[2]) * ray->direction[2];
-        if (!isfinite(depth) || depth < 0 || depth > ray->length || depth > occlusion + 2.0f) {
-            LOG("native: door skip %08x depth %.2f terrain %.2f\n", id, depth, occlusion);
-            continue;
-        }
-        u64 cap_args[1] = {entry};
-        GuestResult cap;
-        int cap_ok = guest_call(cpu, CAP_POWER_PC, cap_args, 1, NULL, 0, &cap);
-        LOG("native: door measure %08x sno %u screen %.2f cap_ok %d cap %d\n", id, sno, d,
-            cap_ok, cap_ok ? (int)(i32)cap.x0 : -999);
-        if (!cap_ok || (i32)cap.x0 <= 0 || (u32)cap.x0 == ASSIST_ACTION) continue;
-        best = d;
-        *found = (WorldPos){p[0], p[1], p[2], place};
-        *found_handle = id;
-        *found_controller = cid;
-        *found_power = (u32)cap.x0;
-        *found_sno = sno;
-        hit = 1;
-    }
-    return hit;
-}
