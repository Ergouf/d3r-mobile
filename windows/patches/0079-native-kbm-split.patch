+        "root.normallayer.consolebuttonlegend_main.layoutroot.buttonlegend"));
+    if (!footer || !ui_visible(p->map, footer) || !ui_inside(p, footer) ||
+        !kbm_readable(footer + 0x88, sizeof rect)) return 0;
+    memcpy(rect, GP(footer + 0x88), sizeof rect);
+    if (p->point[0] > rect[0] + 240.0f) return 0;
+    if (!ui_text_contains(footer, toggle)) return 0;
+    int queued = native_action_press(1);
+    LOG("native: UI options toggle footer %u -> %s\n", serial, queued ? "queued" : "rejected");
+    return queued ? 1 : 0;
+}
