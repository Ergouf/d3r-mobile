-static int ray_at_pixel(const CPU* cpu, const int pixel[2], WorldRay* ray) {
-    const u64 pixel_address = g_stack_top - 0x1FF00;
-    const u64 ray_address = g_stack_top - 0x1FE00;
-    u64 args[3];
-    memcpy(GP(pixel_address), pixel, 2 * sizeof(int));
-    args[0] = pixel_address; args[1] = ray_address; args[2] = 0xFFFFFFFFu;
-    if (!guest_call(cpu, RAY_PC, args, 3, NULL, 0, NULL)) return 0;
-    memcpy(ray, GP(ray_address), sizeof(WorldRay));
-    u64 offset;
-    float origin_offset[3];
-    if (!read64(0x914F918, &offset) || !readable(offset, sizeof origin_offset)) return 0;
-    memcpy(origin_offset, GP(offset), sizeof origin_offset);
-    for (unsigned i = 0; i < 3; i++) ray->origin[i] += origin_offset[i];
-    for (unsigned i = 0; i < 3; i++)
-        if (!isfinite(ray->origin[i]) || !isfinite(ray->direction[i])) return 0;
-    float n = sqrtf(ray->direction[0] * ray->direction[0] +
-                    ray->direction[1] * ray->direction[1] +
-                    ray->direction[2] * ray->direction[2]);
-    if (!(n > 1e-6f)) return 0;
-    if (!isfinite(ray->length) || ray->length <= 0) return 0;
-    for (unsigned i = 0; i < 3; i++) ray->direction[i] /= n;
