+/* Kadala has its own navigation group and gamble controller. The A action is
+   again exposed only as a footer legend, so accept a click on its leftmost
+   "选择" region after checking the complete modal/controller/focus state. */
+static int ui_kadala_action_click(UiPick* p, u32 serial) {
+    static const char select[] = "\xE8\xB4\xAD\xE4\xB9\xB0";
+    u64 nav_holder, navigation, group, candidate, data, count, holder, controller, vtable, method;
+    u64 page, footer;
+    u32 current, player, active, mode, enabled;
+    float rect[4];
+    if (!read64(0x9152080, &nav_holder) || !nav_holder ||
+        !read64(nav_holder, &navigation) || !navigation ||
+        !read64(navigation + 0x108, &group) || !group ||
+        !read64(navigation + 3 * 8, &candidate) || candidate != group ||
+        !read64(group, &data) || !read64(group + 8, &count) || count != 1 ||
+        !read32(group + 0x18, &current) || current != 0 ||
+        !read32(group + 0x1C, &player) || player != 0 ||
+        !read64(data, &method) || method != 0 ||
+        !read64(data + 8, &method) || method != 0 ||
+        !read32(data + 0x10, &enabled) || enabled != 1 ||
+        !read64(0x9153278, &holder) || !holder || !read64(holder, &controller) || !controller ||
+        !read64(controller, &vtable) || vtable != 0x90A29E8 ||
+        !read64(vtable + 0x48, &method) || method != 0x81A3490 ||
+        !read32(controller + 0xC, &player) || player != 0 ||
+        !read32(controller + 0x18, &active) || active != 1 ||
+        !read32(controller + 0x200, &mode) || (mode != 0 && mode != 4)) return 0;
+    page = ui_object(p->map, ui_path_key("root.normallayer.consoleinventoryring_main"));
+    if (!page || !ui_visible(p->map, page)) return 0;
+    footer = ui_object(p->map, ui_path_key(
+        "root.normallayer.consolebuttonlegend_main.layoutroot.buttonlegend"));
+    if (!footer || !ui_visible(p->map, footer) || !ui_inside(p, footer) ||
+        !readable(footer + 0x88, sizeof rect)) return 0;
+    memcpy(rect, GP(footer + 0x88), sizeof rect);
+    if (p->point[0] > rect[0] + 240.0f || !ui_text_contains(footer, select)) return 0;
+    u64 args[3] = {page, player, 0};
+    int complete = guest_call(p->cpu, 0x81A5E90, args, 3, NULL, 0, NULL);
+    LOG("native: UI Kadala footer select %u -> %s\n", serial,
+        complete ? "returned" : "incomplete");
+    return 1;
+}
