+static int ui_text_contains(u64 obj, const char* needle) {
+    u64 pointer;
+    u32 capacity;
+    char text[512];
+    unsigned length;
+    if (!read64(obj + 0x398, &pointer) || !read32(obj + 0x3A0, &capacity) ||
+        !pointer || !capacity || capacity > 1024 || !readable(pointer, capacity)) return 0;
+    length = capacity < sizeof text - 1 ? capacity : sizeof text - 1;
+    memcpy(text, GP(pointer), length);
+    text[length] = 0;
+    return strstr(text, needle) != NULL;
+}
