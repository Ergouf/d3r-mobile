+/* Console menus expose the A action as a footer legend rather than a child
+   button. This click maps only the leftmost craft hint, after verifying the
+   service, page, controller, wheel/focus/overlay gate and exact legend. */
+static int ui_service_action_click(UiPick* p, u32 serial) {
+    static const char craft[] = "\xE6\x89\x93\xE9\x80\xA0";
+    static const char salvage[] = "\xE5\x88\x86\xE8\xA7\xA3";
+    static const char repair[] = "\xE4\xBF\xAE\xE5\xA4\x8D";
+    static const char train[] = "\xE8\xAE\xAD\xE7\xBB\x83";
+    UiServiceState service = {0};
+    u64 global, world, manager, footer, vtable, method, thunk, expected_method, focus_key, focus;
+    const char* label;
+    const char* name;
+    u32 player, action, group;
+    float rect[4];
+    GuestResult r;
+    if (!ui_service_state(p->map, &service) || !read64(service.controller, &vtable) ||
+        !read32(service.controller + 0xC, &player) || player != 0 ||
+        !read64(0x914F840, &global) || !read64(global + 0x10, &world) ||
+        !read64(world + 0xB80, &manager) || !ui_wheel_allowed(p, manager)) return 0;
+    group = service.spec->group;
+    if (group == 5) {
+        thunk = 0x8419000; expected_method = 0x84154A0; name = "blacksmith";
+        if (service.current == 0) { label = craft; action = 0; }
+        else if (service.current == 2) { label = salvage; action = 0; }
+        else if (service.current == 3) { label = repair; action = 0; } /* A: repair */
+        else if (service.current == 4) { label = train; action = 0; }
+        else return 0;
+    } else if (group == 6 && service.current == 3) {
+        thunk = 0x8427580; expected_method = 0x8425970; name = "jeweler";
+        label = train; action = 0;
+    } else if (group == 7 && service.current == 3) {
+        thunk = 0x81DF930; expected_method = 0x81DCA90; name = "mystic";
+        label = train; action = 0;
+    } else return 0;
+    if (!read64(vtable + 0x48, &method) || method != expected_method) return 0;
+    footer = ui_object(p->map, ui_path_key(
+        "root.normallayer.consolebuttonlegend_main.layoutroot.buttonlegend"));
+    if (!footer || !ui_visible(p->map, footer) || !ui_inside(p, footer) ||
+        !readable(footer + 0x88, sizeof rect)) return 0;
+    memcpy(rect, GP(footer + 0x88), sizeof rect);
+    if (p->point[0] > rect[0] + 240.0f || !ui_text_contains(footer, label)) return 0;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX &&
+        (!(focus = ui_object(p->map, focus_key)) || !ui_visible(p->map, focus) ||
+         !ui_within(p->map, focus, service.page))) return 0;
+    u64 args[3] = {service.page, player, action};
+    int complete = guest_call(p->cpu, thunk, args, 3, NULL, 0, NULL);
+    LOG("native: UI %s footer page=%u action=%u %u -> %s\n", name, service.current, action,
+        serial, complete ? "returned" : "incomplete");
+    return 1;
+}
