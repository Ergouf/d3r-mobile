@@ -2365,6 +2582,10 @@
     if (__atomic_exchange_n(&g_cancel, 0, __ATOMIC_ACQ_REL)) g_goal.active = 0;
     if (__atomic_load_n(&g_ui_blocked, __ATOMIC_ACQUIRE)) return;
     pending = take_pointer(&p);
+    if (pending && (p.fallback & NATIVE_POINTER_UI_EVENTS)) {
