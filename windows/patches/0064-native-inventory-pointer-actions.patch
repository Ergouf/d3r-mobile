+    if (ui_item_pointer(&p, press)) return;
+    if (press->fallback & NATIVE_POINTER_UI_RIGHT) { native_action_press(1ull << 1); return; }
     if (ui_map_click(&p, press->serial)) return;
     if (ui_tab_click(&p)) return;
