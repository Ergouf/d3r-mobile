+static int ui_close_page_allowed(u64 map, u64 manager, u64 focus, u64 first, u64 second) {
+    u64 subs, entries, normal;
+    u32 count;
+    if (!focus || (!ui_within(map, focus, first) &&
+                   (!second || !ui_within(map, focus, second))) ||
+        !read64(manager + 0x10, &subs) || !read64(subs, &entries) ||
+        !read32(subs + 8, &count) || !count || count > 1024 ||
+        !(normal = ui_object(map, 1))) return 0;
+    int subscribed = 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, callbacks, callback;
+        if (!read64(entries + i * 8ull, &obj)) return 0;
+        if (!obj || !ui_visible(map, obj)) continue;
