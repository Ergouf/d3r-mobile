+typedef struct {
+    const char* name;
+    u32 slot;
+} UiEquipSlot;
+
+/* The inventory ring's icon widgets have no click callback.  The game's
+   controller setter 0x81FCFD0 changes +0x150 and refreshes the item details
+   and prompt.  0x837CDA0 is navigation, not a slot setter: its second
+   argument is not the target slot.  +0x200 is 0xFFFF on a freshly opened
+   page and is not a selection gate; +0x204 is not updated by 0x81FCFD0. */
+static int ui_equipment_icon(UiPick* p, u32 serial) {
+    static const UiEquipSlot slots[] = {
+        {"button_armleft", 0}, {"button_armright", 1},
+        {"button_fingerright", 2}, {"button_neck", 3},
+        {"button_fingerleft", 4}, {"button_hands", 5},
+        {"button_shoulder", 6}, {"button_torso", 7},
+        {"button_head", 8}, {"button_waist", 9},
+        {"button_legs", 10}, {"button_feet", 11},
+        {"button_bracers", 12}, {"button_bag", 13},
+    };
+    static const char prefix[] =
+        "root.normallayer.consoleinventoryring_main.layoutroot.inventoryring.";
+    UiTabState state = {0};
+    u64 ring, ring_key, vt, holder, controller, focus_key, focus;
+    u32 count, selected, active;
+    GuestResult r;
+    char path[sizeof prefix + 32];
+    if (!ui_tab_state(p->map, &state) || state.current != 0 ||
+        !(ring = ui_object(p->map, ui_path_key(
+            "root.normallayer.consoleinventoryring_main.layoutroot.inventoryring"))) ||
+        !ui_visible(p->map, ring) || !ui_within(p->map, ring, state.page) ||
+        !read64(ring, &vt) || vt != 0x90AF208 ||
+        !read64(ring + 0x30, &ring_key) ||
+        !read32(ring + 0x68, &count) || count != 15) return 0;
+    /* The inventory page can remain visible behind another modal. */
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX &&
+        (!(focus = ui_object(p->map, focus_key)) || !ui_visible(p->map, focus) ||
+         !ui_within(p->map, focus, state.page))) return 0;
+    for (unsigned i = 0; i < sizeof slots / sizeof slots[0]; i++) {
+        u64 button, parent_key;
+        snprintf(path, sizeof path, "%s%s", prefix, slots[i].name);
+        button = ui_object(p->map, ui_path_key(path));
+        if (!button || !read64(button, &vt) || vt != 0x90AF208 ||
+            !read64(button + 0x38, &parent_key) || parent_key != ring_key ||
+            !ui_visible(p->map, button) || !ui_inside(p, button)) continue;
+        if (!read64(0x9157F58, &holder) || !read64(holder, &controller) ||
+            !read64(controller, &vt) || vt != 0x90AAEE0 ||
+            !read32(controller + 0x18, &active) || !active ||
+            !read32(controller + 0x150, &selected) || selected >= 14) {
+            LOG("native: UI equipment icon %u blocked (%s), fall through\n", serial, slots[i].name);
+            return 0;
+        }
+        if (selected == slots[i].slot) {
+            LOG("native: UI equipment icon %u unchanged (%s)\n", serial, slots[i].name);
+            return 1;
+        }
+        u64 args[2] = {controller, slots[i].slot};
+        int complete = guest_call(p->cpu, 0x81FCFD0, args, 2, NULL, 0, NULL);
+        int changed = complete && read32(controller + 0x150, &selected) &&
+            selected == slots[i].slot;
+        LOG("native: UI equipment icon %u %s slot=%u -> %s\n", serial,
+            slots[i].name, slots[i].slot, changed ? "selected" : "incomplete");
+        return 1;
+    }
+    return 0;
+}
+
 static void ui_click(const CPU* cpu, const PointerPress* press) {
     UiPick p = {.cpu = cpu};
     GuestResult r;
@@ -751,6 +820,7 @@ static void ui_click(const CPU* cpu, const PointerPress* press) {
     if (!isfinite(p.point[0]) || !isfinite(p.point[1])) return;
     ui_build_children(p.map);
     if (ui_tab_click(&p)) return;
+    if (ui_equipment_icon(&p, press->serial)) return;
     if (!read64(manager + 0x10, &subs) || !read64(subs, &entries) ||
         !read32(subs + 8, &sub_count) || sub_count > 1024) sub_count = 0;
     int focused = 0, menu_owner = 0;
