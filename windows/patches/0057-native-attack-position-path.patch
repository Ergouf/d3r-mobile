diff --git a/src/nx/runtime/native_world.c b/src/nx/runtime/native_world.c
index f9debbe..0793410 100644
--- a/src/nx/runtime/native_world.c
+++ b/src/nx/runtime/native_world.c
@@ -453,19 +453,26 @@ static int submit_attack(const CPU* cpu, u64 player_object, const WalkGoal* goal
     const u64 record = g_stack_top - 0x1CB00, path = record + 0x14;
     u32* words = (u32*)GP(record);
     memset(GP(record), 0, 0x80);
-    words[0] = goal->controller;
+    words[0] = 0xFFFFFFFFu;
     words[1] = words[2] = ATTACK_POWER;
     words[3] = 0;
     words[4] = 0xFFFFFFFFu;
-    /* Natural A against the observed monster used a type-1 actor path and
