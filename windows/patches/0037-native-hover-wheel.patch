+/* A wheel can stay visible behind a modal. Require its own subscribed callback
+   owner and reject other input layers/owners before checking the selector. */
+static int ui_hover_allowed(UiPick* p, u64 manager) {
+    UiTabState state = {0};
+    u64 subs, entries, normal, owner;
+    u32 count;
+    if (!ui_tab_state(p->map, &state) || (state.current != 0 && state.current != 1) ||
+        !read64(manager + 0x10, &subs) || !read64(subs, &entries) ||
+        !read32(subs + 8, &count) || !count || count > 1024) return 0;
+    normal = ui_object(p->map, 1);
+    owner = ui_object(p->map, ui_path_key(state.current == 0 ?
+        "root.normallayer.consoleinventoryring_main.layoutroot" :
+        "root.normallayer.consoleskillselection_main.layoutroot"));
+    if (!normal || !owner || !ui_visible(p->map, normal)) return 0;
+    int subscribed = 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj, vt, method, table, callback;
+        if (!read64(entries + i * 8ull, &obj)) return 0;
+        if (!obj || !ui_visible(p->map, obj)) continue;
+        if (!ui_within(p->map, obj, normal)) return 0;
+        if (!read64(obj, &vt) || !read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+            !read64(obj + 0x118, &table) || !table || !read64(table + 0x20, &callback) ||
+            !ui_code(callback)) continue;
+        if (!ui_within(p->map, obj, state.page)) return 0;
+        if (obj == owner && callback == (state.current == 0 ? 0x81FB910ull : 0x8387180ull))
+            subscribed = 1;
+    }
+    return subscribed;
+}
