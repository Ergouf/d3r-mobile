+    /* the mouse as player 1's left stick: the direction from the middle of the window, as far as the pointer is
+       out. The stick's own keys win while they are held, so WASD still works next to the pointer */
+    if (mouse_steer_on() && g_mouse_x >= 0 && !st[0] && !st[1]) {
+        int ww = 1280, wh = 720;
+        float dx, dy, len, dead, radius, mag;
+        SDL_GetWindowSize(g_win, &ww, &wh);
+        dx = g_mouse_x - (float)ww * 0.5f;
+        dy = g_mouse_y - (float)wh * 0.5f;
+        len = sqrtf(dx * dx + dy * dy);
+        dead = (float)(ww < wh ? ww : wh) * 0.05f;
+        radius = (float)(ww < wh ? ww : wh) * 0.30f;
+        if (len > dead) {
+            mag = (len - dead) / (radius - dead);
+            if (mag > 1.0f) mag = 1.0f;
+            lx = (i32)(dx / len * mag * 32767.0f);
+            ly = (i32)(-dy / len * mag * 32767.0f);
+        }
+    }
+    nonpad |= g_mouse_buttons;
     pm_lock(&g_hle.hid.input_lock);
