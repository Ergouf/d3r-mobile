+                if (mouse_steer_on() && e.button.which != SDL_TOUCH_MOUSEID) {
+                    /* the buttons are player 1's: left A, right B, middle X, back Y, forward L */
+                    u64 bit = mouse_button_bit(e.button.button);
+                    if (e.type == SDL_EVENT_MOUSE_BUTTON_DOWN)
+                        g_mouse_buttons |= bit;
+                    else
+                        g_mouse_buttons &= ~bit;
+                    break;
+                }
+                touch_mouse(&e);
+                break;
+            case SDL_EVENT_MOUSE_MOTION:
+                if (mouse_steer_on() && e.motion.which != SDL_TOUCH_MOUSEID) {
+                    g_mouse_x = e.motion.x;
