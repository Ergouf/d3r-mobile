+static int mouse_steer_on(void) { return g_settings.mouse_steer && !g_opt_headless; }
+static u64 mouse_button_bit(u8 button) {
+    switch (button) {
+        case SDL_BUTTON_LEFT: return 1ull << 0;   /* A */
+        case SDL_BUTTON_RIGHT: return 1ull << 1;  /* B */
+        case SDL_BUTTON_MIDDLE: return 1ull << 2; /* X */
+        case SDL_BUTTON_X1: return 1ull << 3;     /* Y */
+        case SDL_BUTTON_X2: return 1ull << 6;     /* L */
