+static int ui_vendor_tab_click(UiPick* p, u32 serial, u64 subscribers, u32 sub_count) {
+    static const u64 callbacks[4] = {0x837DF30, 0x837DF60, 0x837DF90, 0x837DFC0};
+    static const u32 modes[4] = {1, 0, 2, 3};
+    static const float left[4] = {126.0f, 303.0f, 505.0f, 682.0f};
+    u64 holder, navigation, group, current_group, data, count, controller, page;
+    u32 current, player, active, mode, enabled[4];
+    if (!sub_count || !read64(0x9152080, &holder) || !holder ||
+        !read64(holder, &navigation) || !navigation ||
+        !read64(navigation + 2 * 8, &group) || !group ||
+        !read64(navigation + 0x108, &current_group) || current_group != group ||
+        !read64(group, &data) || !read64(group + 8, &count) || count != 4 ||
+        !read32(group + 0x18, &current) || current >= 4 ||
+        !read32(group + 0x1C, &player) || player != 0 ||
+        !read64(0x9158028, &holder) || !holder || !read64(holder, &controller) || !controller ||
+        !read32(controller + 0x18, &active) || active != 1 ||
+        !read32(controller + 0x200, &mode) || mode != modes[current]) return 0;
+    for (unsigned i = 0; i < 4; i++) {
+        u64 open, close;
+        if (!read64(data + i * 0x18, &open) || open != callbacks[i] ||
+            !read64(data + i * 0x18 + 8, &close) || close ||
+            !read32(data + i * 0x18 + 0x10, &enabled[i]) || enabled[i] > 1) return 0;
+    }
+    page = ui_object(p->map, ui_path_key("root.normallayer.consoleinventoryring_main"));
+    if (!page || !ui_visible(p->map, page)) return 0;
+    u64 parent = 0, target_obj = 0;
+    unsigned seen = 0;
+    int target = -1;
+    for (u32 i = 0; i < g_ui_child_count; i++) {
+        u64 obj = g_ui_children[i].obj, vt;
+        float rect[4];
+        if (!read64(obj, &vt) || vt != 0x90ABB48 || !ui_visible(p->map, obj) ||
+            !ui_within(p->map, obj, page) || !readable(obj + 0x88, sizeof rect)) continue;
+        memcpy(rect, GP(obj + 0x88), sizeof rect);
+        if (!isfinite(rect[0]) || !isfinite(rect[1]) || !isfinite(rect[2]) || !isfinite(rect[3]) ||
+            fabsf(rect[1] - 39.0f) > 1.0f || fabsf(rect[3] - 63.0f) > 1.0f ||
+            fabsf(rect[2] - rect[0] - 156.0f) > 1.0f) continue;
+        for (unsigned slot = 0; slot < 4; slot++) {
+            if (fabsf(rect[0] - left[slot]) > 1.0f) continue;
+            if ((seen & (1u << slot)) || (parent && parent != g_ui_children[i].parent)) return 0;
+            seen |= 1u << slot;
+            parent = g_ui_children[i].parent;
+            if (p->point[0] >= rect[0] && p->point[0] < rect[2] &&
+                p->point[1] >= rect[1] && p->point[1] < rect[3]) {
+                target = (int)slot;
+                target_obj = obj;
+            }
+        }
+    }
+    if (seen != 0xF || target < 0 || !ui_inside(p, target_obj)) return 0;
+    /* Vendor labels have no callback table. Only the active vendor subscriber
+       authorizes their navigation group; a modal subscriber owns the click. */
+    u64 owner = ui_object(p->map, ui_path_key("root.normallayer.consoleinventoryring_main.layoutroot"));
+    /* Layer roots use reserved UIReference IDs, not FNV path keys. Normal is
+       1; the observed TopLayer root is 3. Reject every other input layer. */
+    u64 normal = ui_object(p->map, 1);
+    if (!normal || !ui_visible(p->map, normal)) return 1;
+    int subscribed = 0;
+    for (u32 i = 0; i < sub_count; i++) {
+        u64 obj, vt, method, table, callback;
+        if (!read64(subscribers + i * 8ull, &obj)) return 1;
+        if (!obj || !ui_visible(p->map, obj)) continue;
+        if (!ui_within(p->map, obj, normal)) {
+            LOG("native: UI vendor tab %u blocked by other input layer\n", serial);
+            return 1;
+        }
+        if (!read64(obj, &vt) || !read64(vt + 0xB0, &method) || method != 0x83B81F0 ||
+            !read64(obj + 0x118, &table) || !table || !read64(table + 0x20, &callback) ||
+            !ui_code(callback)) continue;
+        if (!ui_within(p->map, obj, page)) {
+            LOG("native: UI vendor tab %u blocked by other callback owner\n", serial);
+            return 1;
+        }
+        if (obj == owner && callback == 0x81FB910) subscribed = 1;
+    }
+    GuestResult result;
+    u64 focus_key, focus;
+    if (!subscribed || !guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &result) ||
+        !read64(result.x0, &focus_key)) return 1;
+    if (focus_key != UINT64_MAX && (!(focus = ui_object(p->map, focus_key)) ||
+        !ui_visible(p->map, focus) || !ui_within(p->map, focus, page))) {
+        LOG("native: UI vendor tab %u blocked by focus\n", serial);
+        return 1;
+    }
+    if (!enabled[target] || current == (u32)target) {
+        LOG("native: UI vendor tab %u %s current=%u target=%d\n", serial,
+            enabled[target] ? "unchanged" : "disabled", current, target);
+        return 1;
+    }
+    /* Native group 2, never the character group's selector or global confirm. */
+    u64 args[4] = {2, (u32)target, 0, 0};
+    int complete = guest_call(p->cpu, 0x816F550, args, 4, NULL, 0, NULL);
+    LOG("native: UI vendor tab %u current=%u target=%d -> %s\n", serial,
+        current, target, complete ? "returned" : "incomplete");
+    return 1;
+}
