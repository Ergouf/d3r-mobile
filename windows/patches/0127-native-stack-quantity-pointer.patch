+/* The quantity picker is a top-layer subscriber with arrow sprites and one
+   combined accept/cancel label, rather than regular Button widgets. */
+static int ui_split_click(UiPick* p, const PointerPress* press, u64 manager) {
+    const char* path = "root.toplayer.consolesplitstack_main.layoutroot.dialogcontent";
+    u64 root = ui_object(p->map, ui_path_key(path)), subs, entries, callbacks, accept, cancel;
+    u32 count;
+    if (!root || !ui_visible(p->map, root)) return 0;
+    /* Claim the modal even when a stale pointer request cannot be dispatched. */
+    if (!(press->fallback & NATIVE_POINTER_UI_DOWN)) return 1;
+    if (!kbm_read64(manager + 0x10, &subs) || !kbm_read64(subs, &entries) ||
+        !kbm_read32(subs + 8, &count) || !count || count > 1024 ||
+        !kbm_read64(root + 0x118, &callbacks) ||
+        !kbm_read64(callbacks + 0x20, &accept) || accept != 0x8232C50 ||
+        !kbm_read64(callbacks + 0x28, &cancel) || cancel != 0x8232CA0) return 1;
+    int subscribed = 0;
+    for (u32 i = 0; i < count; i++) {
+        u64 obj;
+        if (!kbm_read64(entries + i * 8ull, &obj)) return 1;
+        if (!obj || !ui_visible(p->map, obj)) continue;
+        if (obj == root) { subscribed = 1; continue; }
+        if (ui_within(p->map, obj, ui_object(p->map, 3)) &&
+            !ui_within(p->map, obj, root)) return 1;
+    }
+    if (!subscribed) return 1;
+    u64 target = 0, method = 0;
+    char name[192];
+    snprintf(name, sizeof name, "%s.lessarrow", path);
+    target = ui_object(p->map, ui_path_key(name));
+    if (target && ui_visible(p->map, target) && ui_inside(p, target)) method = 0x8232F10;
+    snprintf(name, sizeof name, "%s.morearrow", path);
+    target = ui_object(p->map, ui_path_key(name));
+    if (target && ui_visible(p->map, target) && ui_inside(p, target)) method = 0x8232FF0;
+    if (!method) for (size_t i = 0; i < g_ui_child_count; i++) {
+        u64 label = g_ui_children[i].obj;
+        if (!ui_visible(p->map, label) || !ui_within(p->map, label, root) ||
+            !ui_text_contains(label, "接受") || !ui_text_contains(label, "取消") ||
+            !ui_inside(p, label) || !kbm_readable(label + 0x88, 16)) continue;
+        const float* rect = (const float*)GP(label + 0x88);
+        method = p->point[0] < (rect[0] + rect[2]) * .5f ? accept : cancel;
+        break;
+    }
+    if (method) {
+        const u64 args[] = {root + 0x30, 0};
+        int done = guest_call(p->cpu, method, args, 2, NULL, 0, NULL);
+        LOG("native: quantity pointer %u callback=%llx -> %s\n", press->serial,
+            (unsigned long long)method, done ? "returned" : "incomplete");
+    }
     return 1;
 }
 
