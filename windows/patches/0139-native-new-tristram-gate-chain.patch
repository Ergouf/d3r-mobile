+static int paired_portal_near(const CPU* cpu, u64 table, const WorldPos* pos, u32 only_sno,
+                              float distance_limit, WorldPos* found, u32* found_handle,
+                              u32* found_controller, u32* found_power) {
+    u32 limit, shift;
+    u64 buckets;
+    float best = distance_limit;
+    int hit = 0;
+    if (!kbm_read32(table + 0x100, &limit) || !kbm_read32(table + 0x168, &shift) || shift > 16 ||
+        limit > 65536 || !kbm_read64(table + 0x120, &buckets)) return 0;
+    for (u32 i = 0; i < limit; i++) {
+        u64 bucket, entry;
+        u32 id, place, cid, sno;
+        float p[3];
+        if (!kbm_read64(buckets + ((u64)i >> shift) * 8, &bucket) || !bucket) continue;
+        entry = bucket + (u64)(i & ((1u << shift) - 1)) * ENTITY_STRIDE;
+        if (!kbm_read32(entry, &id) || !id || id == 0xFFFFFFFFu ||
+            !kbm_read32(entry + 0xA0, &place) || place != pos->place ||
+            !kbm_read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu ||
+            !kbm_read32(entry + 0x18, &sno) || sno != only_sno ||
+            !kbm_readable(entry + 0x60, 12)) continue;
+        memcpy(p, GP(entry + 0x60), sizeof p);
+        float distance = hypotf(p[0] - pos->x, p[1] - pos->y);
+        if (!isfinite(distance) || distance > best) continue;
+        u64 cap_args[1] = {entry};
+        GuestResult cap;
+        if (!guest_call(cpu, CAP_POWER_PC, cap_args, 1, NULL, 0, &cap) ||
+            (i32)cap.x0 <= 0 || (u32)cap.x0 == ASSIST_ACTION) continue;
+        best = distance;
+        *found = (WorldPos){p[0], p[1], p[2], place};
+        *found_handle = id;
+        *found_controller = cid;
+        *found_power = (u32)cap.x0;
+        hit = 1;
+    }
+    return hit;
 }
 
