+/* The runtime menu is itself a menu: after a key-capture page has had first
+   refusal, apply the configured menu/confirm/cancel bindings before the
+   ordinary key switch.  Raw arrows, Enter, Esc and Backspace remain fallbacks. */
+static SDL_Keycode overlay_menu_key(SDL_Scancode scan, SDL_Keycode key) {
+    static const SDL_Keycode mapped[] = {SDLK_UP, SDLK_LEFT, SDLK_DOWN, SDLK_RIGHT, SDLK_RETURN, SDLK_BACKSPACE};
+    for (int i = SNX_KBM_MENU_UP; i <= SNX_KBM_CANCEL; i++)
+        if (scan == g_pc_keys[i]) return mapped[i - SNX_KBM_MENU_UP];
+    if (scan == g_pc_keys[SNX_KBM_PAUSE_BACK]) return SDLK_ESCAPE;
+    return key;
+}
