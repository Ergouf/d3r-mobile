+/* The console footer stores {icon:buttonN}. Show the PC control that actually
+   sends that button. button4, l3, l1 and r1 have no PC key yet, so those glyphs stay. */
+static void ui_footer_relabel(u64 map) {
+    static const struct { const char* icon; const char* label; } map_label[] = {
+        {"button1", "\xE5\xB7\xA6\xE9\x94\xAE"}, /* left mouse */
+        {"button2", "Esc"},
+        {"button3", "Alt"},
+    };
+    u64 footer, pointer;
+    u32 capacity;
+    char text[512], out[512];
+    unsigned length, o = 0;
+    int changed = 0;
+    footer = ui_object(map, ui_path_key(
+        "root.normallayer.consolebuttonlegend_main.layoutroot.buttonlegend"));
+    if (!footer || !ui_visible(map, footer) ||
+        !read64(footer + 0x398, &pointer) || !read32(footer + 0x3A0, &capacity) ||
+        !pointer || capacity < 2 || capacity > 1024 || !readable(pointer, capacity)) return;
+    length = capacity < sizeof text - 1 ? capacity : (unsigned)sizeof text - 1;
+    memcpy(text, GP(pointer), length);
+    text[length] = 0;
+    length = (unsigned)strlen(text);
+    for (unsigned i = 0; i < length && o + 1 < sizeof out; ) {
+        if (text[i] == 123 && !strncmp(text + i + 1, "icon:", 5)) {
+            unsigned j = i + 6, n = 0;
+            char name[12];
+            const char* label = NULL;
+            while (text[j] && text[j] != ',' && text[j] != 125 && n + 1 < sizeof name)
+                name[n++] = text[j++];
+            name[n] = 0;
+            while (text[j] && text[j] != 125) j++;
+            if (text[j] == 125) j++;
+            for (unsigned k = 0; n && k < sizeof map_label / sizeof map_label[0]; k++)
+                if (!strcmp(name, map_label[k].icon)) label = map_label[k].label;
+            if (label) {
+                size_t ln = strlen(label);
+                if (o + ln >= sizeof out) break;
+                memcpy(out + o, label, ln);
+                o += (unsigned)ln;
+                changed = 1;
+                i = j;
+                continue;
+            }
+        }
+        out[o++] = text[i++];
+    }
+    out[o] = 0;
+    if (!changed || o + 1 > capacity) return;
+    memcpy(GP(pointer), out, o + 1);
+}
