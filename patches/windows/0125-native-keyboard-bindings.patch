+const char* backend_kbm_key(int index) {
+    return index >= 0 && index < SNX_KBM_BINDINGS ?
+        SDL_GetScancodeName(__atomic_load_n(&g_pc_keys[index], __ATOMIC_ACQUIRE)) : "";
+}
+static int pc_keys_store(const SDL_Scancode* keys) {
+    char path[1100], temporary[1120];
+    snprintf(path, sizeof path, "%skeybinds.ini", g_exedir);
+    snprintf(temporary, sizeof temporary, "%s.tmp", path);
+    FILE* file = fopen(temporary, "w");
+    if (!file) return 0;
+    static const char* const legacy[6] = {"a", "b", "x", "y", "l", "r"};
+    int ok = 1;
+    for (int i = 0; i < 6; i++)
+        if (fprintf(file, "%s=%s\n", legacy[i], SDL_GetScancodeName(g_skill_key[i])) < 0) ok = 0;
+    for (int i = 0; i < SNX_KBM_BINDINGS; i++)
+        if (fprintf(file, "%s=%s\n", g_pc_names[i], SDL_GetScancodeName(keys[i])) < 0) ok = 0;
+    if (fclose(file)) ok = 0;
+    if (!ok || !SDL_RenamePath(temporary, path)) { remove(temporary); return 0; }
+    for (int i = 0; i < SNX_KBM_BINDINGS; i++)
+        __atomic_store_n(&g_pc_keys[i], keys[i], __ATOMIC_RELEASE);
+    LOG("input: PC bindings saved\n");
+    return 1;
+}
+int backend_kbm_bind(int index, int scancode) {
+    if (index < 0 || index >= SNX_KBM_BINDINGS || scancode < SDL_SCANCODE_A ||
+        scancode > SDL_SCANCODE_Z) {
+        if (scancode < SDL_SCANCODE_1 || scancode > SDL_SCANCODE_0) return 0;
+        if (index < 0 || index >= SNX_KBM_BINDINGS) return 0;
+    }
+    for (int i = 0; i < SNX_KBM_BINDINGS; i++)
+        if (i != index && g_pc_keys[i] == scancode) return 0;
+    /* Fixed movement, compare and menu controls must remain reachable. */
+    if (scancode == SDL_SCANCODE_W || scancode == SDL_SCANCODE_A || scancode == SDL_SCANCODE_D ||
+        scancode == SDL_SCANCODE_I || scancode == SDL_SCANCODE_Z || scancode == SDL_SCANCODE_V ||
+        scancode == SDL_SCANCODE_K || scancode == SDL_SCANCODE_L) return 0;
+    SDL_Scancode keys[SNX_KBM_BINDINGS];
+    memcpy(keys, g_pc_keys, sizeof keys);
+    keys[index] = (SDL_Scancode)scancode;
+    return pc_keys_store(keys);
+}
+int backend_kbm_reset(void) { return pc_keys_store(g_pc_defaults); }
+static int pc_key_event(SDL_KeyboardEvent* key) {
+    if (mouse_steer_on() || (native_world_ui_blocked() && !native_ui_char_page() && !native_world_map_open())) return 0;
+    SDL_Scancode from = key->scancode;
+    /* Map actions have their own fixed 1/3 hints, independent of combat keys. */
+    if (native_world_map_open() && (from == SDL_SCANCODE_1 || from == SDL_SCANCODE_3)) return 0;
+    for (int i = 0; i < SNX_KBM_BINDINGS; i++) {
+        if (from != g_pc_keys[i]) continue;
+        key->scancode = g_pc_defaults[i];
+        key->key = SDL_GetKeyFromScancode(key->scancode, SDL_KMOD_NONE, false);
+        return 0;
+    }
+    /* Esc always remains available as a back key. Tab remains a map alias. */
+    for (int i = 0; i < SNX_KBM_BINDINGS - 1; i++)
+        if (from == g_pc_defaults[i]) return 1;
+    return 0;
 }
 
