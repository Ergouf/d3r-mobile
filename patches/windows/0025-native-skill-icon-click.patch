     return 0;
 }
 
+/* The skill wheel's category icons have no click callback.  The game's
+   angular selector at controller+0x168 owns the wheel; 0x838F4D0(selector,
+   &child_key, 0) changes the selector's +0x28 immediately; controller+0x1CC
+   is a deferred mirror and is not checked.  The right-side
+   category title/description follows the selector; the equipped skill
+   name/info pane is not the selector's state. */
+static int ui_skill_icon(UiPick* p, u32 serial) {
+    UiTabState state = {0};
+    GuestResult r;
+    u64 ring, ring_key, vt, children, holder, controller, selector;
+    u64 entries, nentries, focus_key, focus;
+    u32 count, selected;
+    if (!ui_tab_state(p->map, &state) || state.current != 1 ||
+        !(ring = ui_object(p->map, ui_path_key(
+            "root.normallayer.consoleskillselection_main.layoutroot.skillloadout"))) ||
+        !ui_visible(p->map, ring) || !ui_within(p->map, ring, state.page) ||
+        !read64(ring, &vt) || vt != 0x90AF208 ||
+        !read64(ring + 0x30, &ring_key) ||
+        !read64(ring + 0x60, &children) ||
+        !read32(ring + 0x68, &count) || count != 14) return 0;
+    if (!guest_call(p->cpu, 0x832D180, NULL, 0, NULL, 0, &r) ||
+        !read64(r.x0, &focus_key)) return 0;
+    if (focus_key != UINT64_MAX &&
+        (!(focus = ui_object(p->map, focus_key)) || !ui_visible(p->map, focus) ||
+         !ui_within(p->map, focus, state.page))) return 0;
+    if (!read64(0x9158040, &holder) || !read64(holder, &controller)) return 0;
+    selector = controller + 0x168;
+    if (!read64(selector, &entries) || !read64(selector + 8, &nentries) ||
+        nentries != 11 || !read32(selector + 0x28, &selected) || selected >= nentries)
+        return 0;
+    for (u32 i = 3; i < 14; i++) {
+        u64 child, parent_key, key;
+        if (!read64(children + (u64)i * 24 + 8, &child) || !child ||
+            !read64(child, &vt) || (vt != 0x90ABB48 && vt != 0x90AF208) ||
+            !read64(child + 0x38, &parent_key) || parent_key != ring_key ||
+            !ui_visible(p->map, child) || !ui_inside(p, child) ||
+            !read64(child + 0x30, &key)) continue;
+        for (u32 j = 0; j < nentries; j++) {
+            u64 entry_key;
+            if (!read64(entries + (u64)j * 16 + 8, &entry_key) ||
+                entry_key != key) continue;
+            if (selected == j) {
+                LOG("native: UI skill icon %u unchanged slot=%u\n", serial, j);
+                return 1;
+            }
+            u64 args[3] = {selector, child + 0x30, 0};
+            int complete = guest_call(p->cpu, 0x838F4D0, args, 3, NULL, 0, NULL);
+            int changed = complete && read32(selector + 0x28, &selected) &&
+                selected == j;
+            LOG("native: UI skill icon %u slot=%u -> %s\n", serial, j,
+                changed ? "selected" : "incomplete");
+            return 1;
+        }
+        LOG("native: UI skill icon %u blocked child=%u\n", serial, i);
+        return 1;
+    }
+    return 0;
+}
+
 static void ui_click(const CPU* cpu, const PointerPress* press) {
     UiPick p = {.cpu = cpu};
     GuestResult r;
@@ -821,6 +880,7 @@ static void ui_click(const CPU* cpu, const PointerPress* press) {
     ui_build_children(p.map);
     if (ui_tab_click(&p)) return;
     if (ui_equipment_icon(&p, press->serial)) return;
+    if (ui_skill_icon(&p, press->serial)) return;
     if (!read64(manager + 0x10, &subs) || !read64(subs, &entries) ||
         !read32(subs + 8, &sub_count) || sub_count > 1024) sub_count = 0;
     int focused = 0, menu_owner = 0;
