+/* A distant chest or NPC can be exactly under the pointer while a nearer
+   monster's wide collision cylinder wins the ray and turns the click into an
+   attack.  If the pointer names an operate target within a few screen pixels,
+   prefer that target over the actor.  The strict screen radius keeps ordinary
+   monster clicks unchanged; Shift-click deliberately skips this path. */
+static int interact_priority(const CPU* cpu, u64 table, const WorldPos* pos, const WorldRay* ray,
+                             float occlusion, const int pixel[2], u32 player_actor,
+                             WalkGoal* goal) {
+    WorldPos candidate;
+    u32 id = 0;
+    if (!assist_candidate_near(cpu, table, pos, pixel, INTERACT_PRIORITY_DISTANCE, &candidate, &id,
+                               player_actor, INTERACT_PRIORITY_SCREEN))
+        return 0;
+    u64 entry;
+    u32 cid = 0, sno = 0;
+    if (!kbm_lookup(table, id, ENTITY_STRIDE, &entry) ||
+        !kbm_read32(entry + 0x14, &cid) || cid == 0xFFFFFFFFu ||
+        !kbm_read32(entry + 0x18, &sno)) return 0;
+    GuestResult cap;
+    const u64 cap_args[1] = {entry};
+    if (!guest_call(cpu, CAP_POWER_PC, cap_args, 1, NULL, 0, &cap) || (i32)cap.x0 <= 0 ||
+        (u32)cap.x0 == ASSIST_ACTION) return 0;
+    float t = (candidate.x - ray->origin[0]) * ray->direction[0] +
+              (candidate.y - ray->origin[1]) * ray->direction[1] +
+              (candidate.z - ray->origin[2]) * ray->direction[2];
+    if (!isfinite(t) || t > occlusion + 2.0f) return 0;
+    float radius = 0;
+    if (kbm_readable(entry + 0x80, 20)) {
+        float cylinder[5];
+        memcpy(cylinder, GP(entry + 0x80), sizeof cylinder);
+        if (isfinite(cylinder[4]) && cylinder[4] > 0 && cylinder[4] < 64) radius = cylinder[4];
+    }
+    memset(goal, 0, sizeof *goal);
+    goal->handle = id;
+    goal->controller = cid;
+    goal->entity = candidate;
+    goal->power = (u32)cap.x0;
+    goal->sno = sno;
+    goal->attack = 0;
+    goal->approach = walk_into_sno(sno) ? 0.9f
+                                       : fmaxf(INTERACT_APPROACH, fminf(radius + 0.8f, 4.0f));
+    LOG("native: interact priority handle %08x sno %u power %u (%.2f,%.2f,%.2f)\n",
+        id, sno, goal->power, candidate.x, candidate.y, candidate.z);
+    return 1;
 }
 
