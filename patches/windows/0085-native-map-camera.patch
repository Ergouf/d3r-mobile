diff --git a/src/nx/runtime/native_ui.c b/src/nx/runtime/native_ui.c
--- a/src/nx/runtime/native_ui.c
+++ b/src/nx/runtime/native_ui.c
@@ -34,6 +34,60 @@
 
 void native_ui_compare_set(int held) {
     __atomic_store_n(&g_compare_requested, held != 0, __ATOMIC_RELEASE);
+}
+
+static int g_map_zoom_steps, g_map_pan_x, g_map_pan_y, g_map_recenter, g_map_reset_zoom;
+
+void native_map_zoom(int notches) {
+    if (notches) __atomic_fetch_add(&g_map_zoom_steps, notches, __ATOMIC_RELAXED);
+}
+void native_map_pan(int dx, int dy) {
+    if (dx) __atomic_fetch_add(&g_map_pan_x, dx, __ATOMIC_RELAXED);
+    if (dy) __atomic_fetch_add(&g_map_pan_y, dy, __ATOMIC_RELAXED);
+}
+void native_map_recenter(void) { __atomic_store_n(&g_map_recenter, 1, __ATOMIC_RELAXED); }
+void native_map_reset_zoom(void) { __atomic_store_n(&g_map_reset_zoom, 1, __ATOMIC_RELAXED); }
+
+static void map_camera_adjust(u64 map, u64 local, int zoom, int pan_x, int pan_y,
+                              int recenter, int reset) {
+    u64 vt;
+    float z, pan[2];
+    if (!local || !ui_visible(map, local) || !kbm_read64(local, &vt) || vt != 0x90AF870ull ||
+        !kbm_readable(local + 0x1F8, 8) || !kbm_readable(local + 0x214, 4)) return;
+    z = *(float*)GP(local + 0x214);
+    if (z != z || z < 0.25f || z > 4.0f) return;
+    if (reset) z = 1.0f;
+    if (zoom) z -= 0.05f * (float)zoom;
+    if (z < 0.5f) z = 0.5f;
+    if (z > 1.5f) z = 1.5f;
+    if (reset || zoom) *(float*)GP(local + 0x214) = z;
+    if (recenter) {
+        pan[0] = pan[1] = 0;
+        memcpy(GP(local + 0x1F8), pan, sizeof pan);
+        return;
+    }
+    if (!pan_x && !pan_y) return;
+    memcpy(pan, GP(local + 0x1F8), sizeof pan);
+    if (pan[0] != pan[0] || pan[1] != pan[1]) return;
+    pan[0] += (float)pan_x;
+    pan[1] += (float)pan_y;
+    memcpy(GP(local + 0x1F8), pan, sizeof pan);
+}
+
+void native_map_apply(u64 map) {
+    static const char* const paths[] = {
+        "root.normallayer.map_dialog_mainpage.localmap",
+        "root.normallayer.waypointmap_main.layoutroot.overlaycontainer.worldmap",
+    };
+    int zoom = __atomic_exchange_n(&g_map_zoom_steps, 0, __ATOMIC_RELAXED);
+    int pan_x = __atomic_exchange_n(&g_map_pan_x, 0, __ATOMIC_RELAXED);
+    int pan_y = __atomic_exchange_n(&g_map_pan_y, 0, __ATOMIC_RELAXED);
+    int recenter = __atomic_exchange_n(&g_map_recenter, 0, __ATOMIC_RELAXED);
+    int reset = __atomic_exchange_n(&g_map_reset_zoom, 0, __ATOMIC_RELAXED);
+    if (!map || (!zoom && !pan_x && !pan_y && !recenter && !reset)) return;
+    for (unsigned i = 0; i < sizeof paths / sizeof paths[0]; i++)
+        map_camera_adjust(map, ui_object(map, ui_path_key(paths[i])),
+                          zoom, pan_x, pan_y, recenter, reset);
 }
 
 int native_ui_char_page(void) {
