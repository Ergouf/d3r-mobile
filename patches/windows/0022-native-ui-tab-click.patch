+static int g_ui_tab_target = -1, g_ui_tab_attempts;
+
+static int ui_tab_selected(u64 map, int* selected, u64* parent) {
+    int seen = 0, selected_count = 0, entries = 0;
+    u64 tab_parent = 0;
+    ui_build_children(map);
+    for (u32 i = 0; i < g_ui_child_count; i++) {
+        u64 obj = g_ui_children[i].obj, vt;
+        u32 flags;
+        float r[4];
+        if (!read64(obj, &vt) || vt != 0x90ABB48 ||
+            !read32(obj + 0x18, &flags) || !(flags & 4) ||
+            !readable(obj + 0x88, 16)) continue;
+        memcpy(r, GP(obj + 0x88), sizeof r);
+        if (!(r[2] - r[0] >= 150.0f && r[2] - r[0] <= 162.0f &&
+              r[3] - r[1] >= 20.0f && r[3] - r[1] <= 28.0f &&
+              r[1] >= 38.0f && r[1] < 64.0f)) continue;
+        int idx = (int)((r[0] - 90.0f) / 156.0f);
+        if (idx < 0 || idx > 4) continue;
+        if (tab_parent == 0) tab_parent = g_ui_children[i].parent;
+        else if (tab_parent != g_ui_children[i].parent) return 0;
+        entries++;
+        seen |= 1 << idx;
+        if ((flags & 0x1400) == 0x1400) { *selected = idx; selected_count++; }
+    }
+    if (entries != 5 || seen != 0x1F || selected_count != 1) return 0;
+    *parent = tab_parent;
+    return 1;
+}
+
+static int ui_tab_hit(const UiPick* p, int* target) {
+    for (u32 i = 0; i < g_ui_child_count; i++) {
+        u64 obj = g_ui_children[i].obj, vt;
+        u32 flags;
+        float r[4];
+        if (!read64(obj, &vt) || vt != 0x90ABB48 ||
+            !read32(obj + 0x18, &flags) || !(flags & 4) || !readable(obj + 0x88, 16)) continue;
+        memcpy(r, GP(obj + 0x88), sizeof r);
+        if (r[2] - r[0] < 150.0f || r[2] - r[0] > 162.0f ||
+            r[3] - r[1] < 20.0f || r[3] - r[1] > 28.0f || r[1] < 38.0f || r[1] >= 64.0f) continue;
+        int idx = (int)((r[0] - 90.0f) / 156.0f);
+        if (idx < 0 || idx > 4) continue;
+        if (p->point[0] >= r[0] && p->point[0] < r[2] &&
+            p->point[1] >= r[1] && p->point[1] < r[3]) { *target = idx; return 1; }
+    }
+    return 0;
+}
+
+static int ui_tab_step(UiPick* p) {
+    int current, target;
+    u64 parent;
+    if (!ui_tab_selected(p->map, &current, &parent) || !ui_tab_hit(p, &target)) return 0;
+    g_ui_tab_target = target;
+    g_ui_tab_attempts = 0;
+    LOG("native: UI tab click current=%d target=%d\n", current, target);
+    return 1;
+}
+
+static void ui_tab_tick(void) {
+    u64 global, world, manager, map, parent;
+    int current;
+    if (__atomic_load_n(&g_ui_tab_target, __ATOMIC_ACQUIRE) < 0) return;
+    if (!read64(0x914F840, &global) || !read64(global + 0x10, &world) ||
+        !read64(world + 0xB80, &manager) || !read64(manager, &map) ||
+        !ui_tab_selected(map, &current, &parent)) { __atomic_store_n(&g_ui_tab_target, -1, __ATOMIC_RELEASE); return; }
+    int target = __atomic_load_n(&g_ui_tab_target, __ATOMIC_ACQUIRE);
+    if (current == target) { __atomic_store_n(&g_ui_tab_target, -1, __ATOMIC_RELEASE); return; }
+    if (++g_ui_tab_attempts > 16) { __atomic_store_n(&g_ui_tab_target, -1, __ATOMIC_RELEASE); return; }
+    int dir = target > current ? 1 : -1;
+    if (!native_action_press(1ull << (dir > 0 ? 7 : 6))) return;
+    LOG("native: UI tab step current=%d target=%d dir=%s attempt=%d\n", current, target,
+        dir > 0 ? "R" : "L", g_ui_tab_attempts);
+}
+
 static int ui_code(u64 pc) {
     return pc >= g_code_lo && pc < g_code_hi && !(pc & 3);
 }
