diff --git a/src/nx/runtime/native_world.c b/src/nx/runtime/native_world.c
--- a/src/nx/runtime/native_world.c
+++ b/src/nx/runtime/native_world.c
@@ -2502,6 +2502,15 @@
    and 120 world units of the player. A valid click-time terrain depth must
    place the door in front of the occluder before it can become an operate goal.
    It only covers the listed SNOs; ordinary props/NPCs keep the ray/assist path. */
+int native_world_map_open(void) {
+    u64 global, world, manager, map, local, waypoint;
+    if (!read64(0x914F840, &global) || !read64(global + 0x10, &world) ||
+        !read64(world + 0xB80, &manager) || !read64(manager, &map)) return 0;
+    local = ui_object(map, ui_path_key("root.normallayer.map_dialog_mainpage"));
+    waypoint = ui_object(map, ui_path_key("root.normallayer.waypointmap_main"));
+    return (local && ui_visible(map, local)) || (waypoint && ui_visible(map, waypoint));
+}
+
 static int door_sno(u32 sno) {
     return sno == 178293u || /* inn door */
            sno == 90419u ||  /* trOut_NewTristram_Gate_Town */
