+static int pc_skill_digit(SDL_Scancode scancode, int repeat, SDL_Keymod modifiers) {
+    if (scancode < SDL_SCANCODE_1 || scancode > SDL_SCANCODE_4 || native_world_ui_blocked()) return 0;
+    if (repeat || (modifiers & (SDL_KMOD_CTRL | SDL_KMOD_ALT | SDL_KMOD_GUI))) return 1;
+    float pointer_x = g_mouse_x, pointer_y = g_mouse_y;
+    if (!isfinite(pointer_x) || !isfinite(pointer_y) || pointer_x < 0 || pointer_y < 0)
+        SDL_GetMouseState(&pointer_x, &pointer_y);
+    unsigned slot = 2u + (unsigned)(scancode - SDL_SCANCODE_1);
+    pc_world_pointer(pointer_x, pointer_y, NATIVE_POINTER_SKILL | NATIVE_POINTER_SLOT(slot));
+    return 1;
+}
