+/* The six skill slots (A B X Y L R) are bound by keybinds.ini next to the game's exe:
+     a=space
+     b=z
+     ...
+   An absent file keeps the defaults below.  The face/shoulder keys no longer
+   have a second hard-coded mapping: one slot, one key, so the file is the whole
+   binding. */
+static const u64 SKILL_PAD[6] = {1ull << 0, 1ull << 1, 1ull << 2, 1ull << 3, 1ull << 6, 1ull << 7};
+static SDL_Scancode g_skill_key[6] = {SDL_SCANCODE_SPACE, SDL_SCANCODE_Z, SDL_SCANCODE_C,
+                                      SDL_SCANCODE_V, SDL_SCANCODE_Q, SDL_SCANCODE_E};
+static int g_skill_keys_loaded;
+
+static void skill_keys_load(void) {
+    static const char* const names[6] = {"a", "b", "x", "y", "l", "r"};
+    char path[1100], line[160];
+    FILE* f;
+    if (g_skill_keys_loaded) return;
+    g_skill_keys_loaded = 1;
+    snprintf(path, sizeof path, "%skeybinds.ini", g_exedir);
+    f = fopen(path, "r");
+    if (!f) {
+        LOG("input: skill keys are the defaults (no %s)\n", path);
+        return;
+    }
+    while (fgets(line, sizeof line, f)) {
+        char name[16], value[64];
+        int slot = -1;
+        if (sscanf(line, " %15[^= \t] = %63s", name, value) != 2) continue;
+        for (int i = 0; i < 6; i++)
+            if (!strcmp(name, names[i])) slot = i;
+        if (slot < 0) {
+            if (name[0] != ';' && name[0] != '#')
+                WARN("input: keybinds.ini: unknown slot '%s'\n", name);
+            continue;
+        }
+        SDL_Scancode k = SDL_GetScancodeFromName(value);
+        if (k == SDL_SCANCODE_UNKNOWN) {
+            WARN("input: keybinds.ini: unknown key '%s' for '%s'\n", value, name);
+            continue;
+        }
+        for (int j = 0; j < 6; j++)
+            if (j != slot && g_skill_key[j] == k)
+                WARN("input: keybinds.ini: '%s' also binds slot %s\n", value, names[j]);
+        g_skill_key[slot] = k;
+    }
+    fclose(f);
+    LOG("input: skill keys %s=%s %s=%s %s=%s %s=%s %s=%s %s=%s\n", names[0],
+        SDL_GetScancodeName(g_skill_key[0]), names[1], SDL_GetScancodeName(g_skill_key[1]),
+        names[2], SDL_GetScancodeName(g_skill_key[2]), names[3], SDL_GetScancodeName(g_skill_key[3]),
+        names[4], SDL_GetScancodeName(g_skill_key[4]), names[5], SDL_GetScancodeName(g_skill_key[5]));
+}
