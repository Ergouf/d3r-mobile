+/* The attack record a natural A press builds when nothing is interactable:
+   +0 controller 0xFFFFFFFF, +4/+8 the attack power, +0xC 0, +0x10 -1, +0x14 a
+   type-2 position path built by 0x866D580(path, world_pos). */
+static int submit_attack(const CPU* cpu, u64 player_object, const WalkGoal* goal) {
+    const u64 record = g_stack_top - 0x1CB00, path = record + 0x14, pos = record + 0xA0;
+    u32* words = (u32*)GP(record);
+    memset(GP(record), 0, 0x80);
+    words[0] = 0xFFFFFFFFu;
+    words[1] = words[2] = ATTACK_POWER;
+    words[3] = 0;
+    words[4] = 0xFFFFFFFFu;
+    memcpy(GP(pos), &goal->entity, sizeof goal->entity);
+    u64 build[2] = {path, pos};
+    if (!guest_call(cpu, PATH_POS_PC, build, 2, NULL, 0, NULL)) {
+        LOG("native: attack path build failed for %08x\n", goal->handle);
+        return 0;
+    }
+    u32 type, id;
+    if (!read32(path, &type) || !read32(path + 4, &id) || type != 2 || id != 0xFFFFFFFFu) {
+        LOG("native: attack path mismatch type %u id %08x\n", type, id);
+        return 0;
+    }
+    u64 submit[4] = {player_object, record, 1, 1};
+    GuestResult r;
+    if (!guest_call(cpu, ACTION_PC, submit, 4, NULL, 0, &r)) {
+        LOG("native: attack call incomplete for %08x\n", goal->handle);
+        return 0;
+    }
+    LOG("native: attack %08x power %d at (%.2f,%.2f,%.2f) -> %d\n", goal->handle,
+        (int)ATTACK_POWER, goal->entity.x, goal->entity.y, goal->entity.z, (int)(u32)r.x0);
+    return (u32)r.x0 == 1;
+}
