+u64 vk_sample_hash(u64 gva, u64 len) {
+    u8 tmp[2048 + 128];
+    if (len <= sizeof tmp) {
+        gmem_read(gva, tmp, len);
+        return vk_hash(tmp, len);
+    }
+    u32 n = 0;
+    gmem_read(gva, tmp, 64);
+    n = 64;
+    gmem_read(gva + len - 64, tmp + n, 64);
+    n += 64;
+    u64 step = (len - 32) / 62;
+    for (int i = 0; i < 62; i++) {
+        gmem_read(gva + (u64)i * step, tmp + n, 32);
+        n += 32;
+    }
+    return vk_hash(tmp, n);
+}
