+static void ring_reset(Ring* r, const VmaBudget* budget) {
+    r->small = r->cap > STAGE_MIN && r->used <= r->cap / 4 ? r->small + 1 : 0;
+    if (r->small >= 300 || (budget && r->buf && ring_misplaced(r, budget))) {
+        vmaDestroyBuffer(g_vk.vma, r->buf, r->mem);
+        *r = (Ring){0};
+    }
+    r->used = 0;
