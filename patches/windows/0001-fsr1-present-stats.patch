diff --git a/src/nx/gpu/vk/shaders/fsr.frag b/src/nx/gpu/vk/shaders/fsr.frag
new file mode 100644
index 0000000..0ed0905
--- /dev/null
+++ b/src/nx/gpu/vk/shaders/fsr.frag
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright 2026 the ScarletNX contributors
+// FSR 1 EASU: the presented frame, enlarged into the swapchain image at the draw's viewport (gpu/vk/fsr.c).
+// Ported from AMD FidelityFX FSR 1 (ffx_fsr1.h, MIT licence): FsrEasuF and its FsrEasuTapF / FsrEasuSetF helpers,
+// the scalar (32-bit) path. The twelve taps and the gradient it follows are AMD's; only the coordinates differ: this
+// shader reads a rectangle of a larger image, given in rect and mapped to image UV by uvp().
+#version 450
+layout(set = 0, binding = 0) uniform sampler2D img;
+layout(push_constant) uniform Pc {
+    vec4 con0;  // output pixel to a position in the source rectangle
+    vec4 con1;
+    vec4 con2;
+    vec4 con3;
+    vec4 rect;  // xy: the source rectangle's origin in image UV; zw: its size in image UV
+    vec4 dst;   // xy: the draw's origin in framebuffer pixels; zw: its size
+    vec4 flags; // x: the source is flipped vertically
+} pc;
+layout(location = 0) out vec4 o;
+
+// a position in the source rectangle (0 to 1) in the image's UV
+vec2 uvp(vec2 p) {
+    return pc.rect.xy + p * pc.rect.zw;
+}
+vec4 red(vec2 p) { return textureGather(img, uvp(p), 0); }
+vec4 grn(vec2 p) { return textureGather(img, uvp(p), 1); }
+vec4 blu(vec2 p) { return textureGather(img, uvp(p), 2); }
+
+// one tap of the 12-tap kernel, with AMD's approximation of a Lanczos2 window
+void tapF(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c) {
+    vec2 v;
+    v.x = off.x * dir.x + off.y * dir.y;
+    v.y = off.x * (-dir.y) + off.y * dir.x;
+    v *= len;
+    float d2 = v.x * v.x + v.y * v.y;
+    d2 = min(d2, clp);
+    float wB = 2.0 / 5.0 * d2 - 1.0;
+    float wA = lob * d2 - 1.0;
+    wB *= wB;
+    wA *= wA;
+    wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);
+    float w = wB * wA;
+    aC += c * w;
+    aW += w;
+}
+
+// the gradient and its length from one corner of the 2x2 the output pixel falls in
+void setF(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
+    float dc = lD - lC;
+    float cb = lC - lB;
+    float lenX = max(abs(dc), abs(cb));
+    lenX = 1.0 / max(lenX, 1e-8);
+    float dirX = lD - lB;
+    dir.x += dirX * w;
+    lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
+    lenX *= lenX;
+    len += lenX * w;
+    float ec = lE - lC;
+    float ca = lC - lA;
+    float lenY = max(abs(ec), abs(ca));
+    lenY = 1.0 / max(lenY, 1e-8);
+    float dirY = lE - lA;
+    dir.y += dirY * w;
+    lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
+    lenY *= lenY;
+    len += lenY * w;
+}
+
+vec3 easu(vec2 ip) {
+    // the position of 'f' in the source rectangle, and the fraction into its pixel
+    vec2 pp = ip * pc.con0.xy + pc.con0.zw;
+    vec2 fp = floor(pp);
+    pp -= fp;
+    // the four gather points: 2x2 texels each, twelve taps of the kernel
+    vec2 p0 = fp * pc.con1.xy + pc.con1.zw;
+    vec2 p1 = p0 + pc.con2.xy;
+    vec2 p2 = p0 + pc.con2.zw;
+    vec2 p3 = p0 + pc.con3.xy;
+    vec4 bczzR = red(p0), bczzG = grn(p0), bczzB = blu(p0);
+    vec4 ijfeR = red(p1), ijfeG = grn(p1), ijfeB = blu(p1);
+    vec4 klhgR = red(p2), klhgG = grn(p2), klhgB = blu(p2);
+    vec4 zzonR = red(p3), zzonG = grn(p3), zzonB = blu(p3);
+    // the luminance the gradient follows (a rough one: red, green and half the blue)
+    vec4 bczzL = bczzB * 0.5 + (bczzR * 0.5 + bczzG);
+    vec4 ijfeL = ijfeB * 0.5 + (ijfeR * 0.5 + ijfeG);
+    vec4 klhgL = klhgB * 0.5 + (klhgR * 0.5 + klhgG);
+    vec4 zzonL = zzonB * 0.5 + (zzonR * 0.5 + zzonG);
+    float bL = bczzL.x, cL = bczzL.y;
+    float iL = ijfeL.x, jL = ijfeL.y, fL = ijfeL.z, eL = ijfeL.w;
+    float kL = klhgL.x, lL = klhgL.y, hL = klhgL.z, gL = klhgL.w;
+    float oL = zzonL.z, nL = zzonL.w;
+    // the gradient, weighted by how near each corner of the 2x2 the output pixel is
+    vec2 dir = vec2(0.0);
+    float len = 0.0;
+    setF(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+    setF(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
+    setF(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
+    setF(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);
+    // normalize it, and shape the length
+    float dirR = dir.x * dir.x + dir.y * dir.y;
+    bool zro = dirR < 1.0 / 32768.0;
+    dirR = inversesqrt(max(dirR, 1.0 / 32768.0));
+    dirR = zro ? 1.0 : dirR;
+    dir.x = zro ? 1.0 : dir.x;
+    dir *= dirR;
+    len = len * 0.5;
+    len *= len;
+    // the kernel stretches along the edge and shortens across it
+    float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
+    vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+    float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+    float clp = 1.0 / lob;
+    // the four nearest texels, to ring the result in
+    vec3 min4 = min(min(vec3(ijfeR.z, ijfeG.z, ijfeB.z), vec3(klhgR.w, klhgG.w, klhgB.w)),
+                    min(vec3(ijfeR.y, ijfeG.y, ijfeB.y), vec3(klhgR.x, klhgG.x, klhgB.x)));
+    vec3 max4 = max(max(vec3(ijfeR.z, ijfeG.z, ijfeB.z), vec3(klhgR.w, klhgG.w, klhgB.w)),
+                    max(vec3(ijfeR.y, ijfeG.y, ijfeB.y), vec3(klhgR.x, klhgG.x, klhgB.x)));
+    vec3 aC = vec3(0.0);
+    float aW = 0.0;
+    tapF(aC, aW, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, vec3(bczzR.x, bczzG.x, bczzB.x));
+    tapF(aC, aW, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, vec3(bczzR.y, bczzG.y, bczzB.y));
+    tapF(aC, aW, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, vec3(ijfeR.x, ijfeG.x, ijfeB.x));
+    tapF(aC, aW, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, vec3(ijfeR.y, ijfeG.y, ijfeB.y));
+    tapF(aC, aW, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, vec3(ijfeR.z, ijfeG.z, ijfeB.z));
+    tapF(aC, aW, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, vec3(ijfeR.w, ijfeG.w, ijfeB.w));
+    tapF(aC, aW, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, vec3(klhgR.x, klhgG.x, klhgB.x));
+    tapF(aC, aW, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, vec3(klhgR.y, klhgG.y, klhgB.y));
+    tapF(aC, aW, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, vec3(klhgR.z, klhgG.z, klhgB.z));
+    tapF(aC, aW, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, vec3(klhgR.w, klhgG.w, klhgB.w));
+    tapF(aC, aW, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, vec3(zzonR.z, zzonG.z, zzonB.z));
+    tapF(aC, aW, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, vec3(zzonR.w, zzonG.w, zzonB.w));
+    return min(max4, max(min4, aC / aW));
+}
+
+void main() {
+    // the output pixel, counted from the draw's origin
+    vec2 ip = floor(gl_FragCoord.xy - pc.dst.xy);
+    // Mirror output pixels so the gather's component order and the EASU kernel stay in source order.
+    if (pc.flags.x > 0.5) ip.y = pc.dst.w - 1.0 - ip.y;
+    o = vec4(easu(ip), 1.0);
+}
