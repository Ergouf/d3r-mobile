+/* Optional CPU-side presentation timings, updated only under vk_lock. These are call durations, not GPU times. */
+typedef struct {
+    u64 count, sum_ns, max_ns;
+} PresentCallStats;
+typedef struct {
+    u64 ok, not_ready, timeout, suboptimal, out_of_date, surface_lost, other;
+    VkResult last;
+} PresentResultStats;
+static struct {
+    u64 frames;
+    PresentCallStats cmd, acquire, queue, present;
+    PresentResultStats acquire_result, present_result;
+} g_present_stats;
+static u64 g_present_stats_frames;
+static int g_present_stats_on = -1;
+static int present_stats_on(void) {
+    if (g_present_stats_on < 0) {
+        const char* env = getenv("SNX_PRESENT_STATS");
+        g_present_stats_on = env && *env && strcmp(env, "0") != 0;
+    }
+    return g_present_stats_on;
+}
+static void present_call_note(PresentCallStats* s, u64 start) {
+    u64 ns = plat_ns() - start;
+    s->count++;
+    s->sum_ns += ns;
+    if (ns > s->max_ns) s->max_ns = ns;
+}
+static void present_result_note(PresentResultStats* s, VkResult result) {
+    s->last = result;
+    switch (result) {
+        case VK_SUCCESS: s->ok++; break;
+        case VK_NOT_READY: s->not_ready++; break;
+        case VK_TIMEOUT: s->timeout++; break;
+        case VK_SUBOPTIMAL_KHR: s->suboptimal++; break;
+        case VK_ERROR_OUT_OF_DATE_KHR: s->out_of_date++; break;
+        case VK_ERROR_SURFACE_LOST_KHR: s->surface_lost++; break;
+        default: s->other++; break;
+    }
+}
+static void present_stats_frame(void) {
+    g_present_stats_frames++;
+    if (++g_present_stats.frames != 600) return;
+    LOG("present-stats: guest=%llu window=600 call=count/sum_us/max_us cmd=%llu/%llu/%llu "
+        "acquire=%llu/%llu/%llu rec_queue=%llu/%llu/%llu present=%llu/%llu/%llu\n",
+        (unsigned long long)g_present_stats_frames,
+        (unsigned long long)g_present_stats.cmd.count, (unsigned long long)(g_present_stats.cmd.sum_ns / 1000),
+        (unsigned long long)(g_present_stats.cmd.max_ns / 1000),
+        (unsigned long long)g_present_stats.acquire.count, (unsigned long long)(g_present_stats.acquire.sum_ns / 1000),
+        (unsigned long long)(g_present_stats.acquire.max_ns / 1000),
+        (unsigned long long)g_present_stats.queue.count, (unsigned long long)(g_present_stats.queue.sum_ns / 1000),
+        (unsigned long long)(g_present_stats.queue.max_ns / 1000),
+        (unsigned long long)g_present_stats.present.count, (unsigned long long)(g_present_stats.present.sum_ns / 1000),
+        (unsigned long long)(g_present_stats.present.max_ns / 1000));
+    const PresentResultStats* a = &g_present_stats.acquire_result;
+    const PresentResultStats* p = &g_present_stats.present_result;
+    LOG("present-stats: guest=%llu rc=ok/not_ready/timeout/suboptimal/out_of_date/surface_lost/other "
+        "acquire=%llu/%llu/%llu/%llu/%llu/%llu/%llu last=%d present=%llu/%llu/%llu/%llu/%llu/%llu/%llu last=%d\n",
+        (unsigned long long)g_present_stats_frames,
+        (unsigned long long)a->ok, (unsigned long long)a->not_ready, (unsigned long long)a->timeout,
+        (unsigned long long)a->suboptimal, (unsigned long long)a->out_of_date,
+        (unsigned long long)a->surface_lost, (unsigned long long)a->other, (int)a->last,
+        (unsigned long long)p->ok, (unsigned long long)p->not_ready, (unsigned long long)p->timeout,
+        (unsigned long long)p->suboptimal, (unsigned long long)p->out_of_date,
+        (unsigned long long)p->surface_lost, (unsigned long long)p->other, (int)p->last);
+    memset(&g_present_stats, 0, sizeof g_present_stats);
+}
