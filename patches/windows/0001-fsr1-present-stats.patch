diff --git a/src/nx/gpu/vk/shaders/fsr_rcas.frag b/src/nx/gpu/vk/shaders/fsr_rcas.frag
new file mode 100644
index 0000000..920caed
--- /dev/null
+++ b/src/nx/gpu/vk/shaders/fsr_rcas.frag
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright 2026 the ScarletNX contributors
+// FSR 1 RCAS: the EASU output sharpened by its ring, into the swapchain image (gpu/vk/fsr.c).
+// Ported from AMD FidelityFX FSR 1 (ffx_fsr1.h, MIT licence), FsrRcasF, the scalar path. The input is the EASU
+// output at the swapchain's own size, so every tap is an exact texel (texelFetch, no filtering).
+#version 450
+layout(set = 0, binding = 0) uniform sampler2D img;
+layout(push_constant) uniform Pc {
+    vec4 sharp; // x: the lobe scale, exp2(-sharpness); the rest unused
+    vec4 size;  // xy: the input's size in texels
+    vec4 dst;   // xy: the draw's origin in framebuffer pixels
+} pc;
+layout(location = 0) out vec4 o;
+
+#define RCAS_LIMIT (0.25 - 1.0 / 16.0)
+
+vec3 texel(ivec2 p) {
+    ivec2 s = ivec2(pc.size.xy);
+    return texelFetch(img, clamp(p, ivec2(0), s - 1), 0).rgb;
+}
+
+vec3 rcas(vec3 b, vec3 d, vec3 e, vec3 f, vec3 h) {
+    float bR = b.r, bG = b.g, bB = b.b;
+    float dR = d.r, dG = d.g, dB = d.b;
+    float eR = e.r, eG = e.g, eB = e.b;
+    float fR = f.r, fG = f.g, fB = f.b;
+    float hR = h.r, hG = h.g, hB = h.b;
+    // luma times two
+    float bL = bB * 0.5 + (bR * 0.5 + bG);
+    float dL = dB * 0.5 + (dR * 0.5 + dG);
+    float eL = eB * 0.5 + (eR * 0.5 + eG);
+    float fL = fB * 0.5 + (fR * 0.5 + fG);
+    float hL = hB * 0.5 + (hR * 0.5 + hG);
+    // noise detection: flat rings are not sharpened
+    float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
+    float hi = max(max(max(bL, dL), max(eL, fL)), hL);
+    float lo = min(min(min(bL, dL), min(eL, fL)), hL);
+    nz = clamp(abs(nz) / max(hi - lo, 1.0 / 1024.0), 0.0, 1.0);
+    nz = -0.5 * nz + 1.0;
+    // the ring's range
+    float mn4R = min(min(bR, dR), min(fR, hR));
+    float mn4G = min(min(bG, dG), min(fG, hG));
+    float mn4B = min(min(bB, dB), min(fB, hB));
+    float mx4R = max(max(bR, dR), max(fR, hR));
+    float mx4G = max(max(bG, dG), max(fG, hG));
+    float mx4B = max(max(bB, dB), max(fB, hB));
+    float hitMinR = min(mn4R, eR) / max(4.0 * mx4R, 1e-8);
+    float hitMinG = min(mn4G, eG) / max(4.0 * mx4G, 1e-8);
+    float hitMinB = min(mn4B, eB) / max(4.0 * mx4B, 1e-8);
+    float hitMaxR = (1.0 - max(mx4R, eR)) / min(4.0 * mn4R - 4.0, -1e-8);
+    float hitMaxG = (1.0 - max(mx4G, eG)) / min(4.0 * mn4G - 4.0, -1e-8);
+    float hitMaxB = (1.0 - max(mx4B, eB)) / min(4.0 * mn4B - 4.0, -1e-8);
+    float lobeR = max(-hitMinR, hitMaxR);
+    float lobeG = max(-hitMinG, hitMaxG);
+    float lobeB = max(-hitMinB, hitMaxB);
+    float lobe = max(-RCAS_LIMIT, min(max(max(lobeR, lobeG), lobeB), 0.0)) * pc.sharp.x;
+    lobe *= nz;
+    float rcpL = 1.0 / (4.0 * lobe + 1.0);
+    return vec3((lobe * bR + lobe * dR + lobe * hR + lobe * fR + eR) * rcpL,
+                (lobe * bG + lobe * dG + lobe * hG + lobe * fG + eG) * rcpL,
+                (lobe * bB + lobe * dB + lobe * hB + lobe * fB + eB) * rcpL);
+}
+
+void main() {
+    ivec2 p = ivec2(floor(gl_FragCoord.xy - pc.dst.xy));
+    o = vec4(rcas(texel(p + ivec2(0, -1)), texel(p + ivec2(-1, 0)), texel(p), texel(p + ivec2(1, 0)),
+                  texel(p + ivec2(0, 1))),
+             1.0);
+}
