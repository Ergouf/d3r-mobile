@@ -63,6 +63,84 @@ static u64 g_gval;         /* the last submission */
 static u64 g_landed;       /* submissions whose storage results vk_buf_frame_done has landed */
 u32 g_vk_epoch, g_vk_present;
 
+/* vk_wait_submit is also called without vk_lock (the release worker). Keep diagnostics per thread throughout. */
+typedef struct {
+    u64 count, sum_ns, max_ns, over_20ms;
+} CmdCallStats;
+enum { WAIT_FRAME, WAIT_FINISH, WAIT_SUBMIT, WAIT_REASON_N };
+enum { RECYCLE_TOTAL, RECYCLE_MAINTENANCE, RECYCLE_RESET, RECYCLE_BUDGET, RECYCLE_STAGE_N };
+static __thread int g_cmd_stats_on = -1;
+static __thread CmdCallStats g_cmd_wait_stats[WAIT_REASON_N], g_cmd_recycle_stats[RECYCLE_STAGE_N];
+static __thread u64 g_cmd_wait_calls, g_cmd_recycle_calls;
+static __thread unsigned g_cmd_wait_warned, g_cmd_recycle_warned;
+static int cmd_stats_on(void) {
+    if (g_cmd_stats_on < 0) {
+        const char* env = getenv("SNX_PRESENT_STATS");
+        g_cmd_stats_on = env && *env && strcmp(env, "0") != 0;
+    }
+    return g_cmd_stats_on;
+}
+static void cmd_stats_add(CmdCallStats* s, u64 ns) {
+    s->count++;
+    s->sum_ns += ns;
+    if (ns > s->max_ns) s->max_ns = ns;
+    if (ns > 20000000) s->over_20ms++;
+}
+static void cmd_wait_note(unsigned reason, u64 value, u64 ns) {
+    cmd_stats_add(&g_cmd_wait_stats[reason], ns);
+    if (ns > 20000000 && g_cmd_wait_warned < 10) {
+        static const char* const names[] = {"frame", "finish", "submit"};
+        g_cmd_wait_warned++;
+        WARN("timeline-wait: thread=%p reason=%s target=%llu us=%llu\n", (void*)&g_cmd_stats_on, names[reason],
+             (unsigned long long)value, (unsigned long long)(ns / 1000));
+    }
+    if (++g_cmd_wait_calls % 600) return;
+    const CmdCallStats* f = &g_cmd_wait_stats[WAIT_FRAME];
+    const CmdCallStats* n = &g_cmd_wait_stats[WAIT_FINISH];
+    const CmdCallStats* s = &g_cmd_wait_stats[WAIT_SUBMIT];
+    LOG("timeline-stats: thread=%p calls=%llu window=600 count/sum_us/max_us/over20ms "
+        "frame=%llu/%llu/%llu/%llu finish=%llu/%llu/%llu/%llu submit=%llu/%llu/%llu/%llu\n",
+        (void*)&g_cmd_stats_on, (unsigned long long)g_cmd_wait_calls,
+        (unsigned long long)f->count, (unsigned long long)(f->sum_ns / 1000),
+        (unsigned long long)(f->max_ns / 1000), (unsigned long long)f->over_20ms,
+        (unsigned long long)n->count, (unsigned long long)(n->sum_ns / 1000),
+        (unsigned long long)(n->max_ns / 1000), (unsigned long long)n->over_20ms,
+        (unsigned long long)s->count, (unsigned long long)(s->sum_ns / 1000),
+        (unsigned long long)(s->max_ns / 1000), (unsigned long long)s->over_20ms);
+    memset(g_cmd_wait_stats, 0, sizeof g_cmd_wait_stats);
+}
+static void cmd_recycle_note(u64 total, u64 maintenance, u64 reset, u64 budget) {
+    cmd_stats_add(&g_cmd_recycle_stats[RECYCLE_TOTAL], total);
+    cmd_stats_add(&g_cmd_recycle_stats[RECYCLE_MAINTENANCE], maintenance);
+    cmd_stats_add(&g_cmd_recycle_stats[RECYCLE_RESET], reset);
+    cmd_stats_add(&g_cmd_recycle_stats[RECYCLE_BUDGET], budget);
+    if (maintenance > 20000000 && g_cmd_recycle_warned < 10) {
+        g_cmd_recycle_warned++;
+        WARN("recycle-slow: thread=%p frame=%llu total_us=%llu maintenance_us=%llu reset_us=%llu budget_us=%llu\n",
+             (void*)&g_cmd_stats_on, (unsigned long long)g_frame_id, (unsigned long long)(total / 1000),
+             (unsigned long long)(maintenance / 1000), (unsigned long long)(reset / 1000),
+             (unsigned long long)(budget / 1000));
+    }
+    if (++g_cmd_recycle_calls % 600) return;
+    const CmdCallStats* t = &g_cmd_recycle_stats[RECYCLE_TOTAL];
+    const CmdCallStats* m = &g_cmd_recycle_stats[RECYCLE_MAINTENANCE];
+    const CmdCallStats* r = &g_cmd_recycle_stats[RECYCLE_RESET];
+    const CmdCallStats* b = &g_cmd_recycle_stats[RECYCLE_BUDGET];
+    LOG("recycle-stats: thread=%p calls=%llu window=600 count/sum_us/max_us/over20ms "
+        "total=%llu/%llu/%llu/%llu maintenance=%llu/%llu/%llu/%llu "
+        "reset=%llu/%llu/%llu/%llu budget=%llu/%llu/%llu/%llu\n",
+        (void*)&g_cmd_stats_on, (unsigned long long)g_cmd_recycle_calls,
+        (unsigned long long)t->count, (unsigned long long)(t->sum_ns / 1000),
+        (unsigned long long)(t->max_ns / 1000), (unsigned long long)t->over_20ms,
+        (unsigned long long)m->count, (unsigned long long)(m->sum_ns / 1000),
+        (unsigned long long)(m->max_ns / 1000), (unsigned long long)m->over_20ms,
+        (unsigned long long)r->count, (unsigned long long)(r->sum_ns / 1000),
+        (unsigned long long)(r->max_ns / 1000), (unsigned long long)r->over_20ms,
+        (unsigned long long)b->count, (unsigned long long)(b->sum_ns / 1000),
+        (unsigned long long)(b->max_ns / 1000), (unsigned long long)b->over_20ms);
+    memset(g_cmd_recycle_stats, 0, sizeof g_cmd_recycle_stats);
+}
+
 u64 vk_hash(const void* p, u64 size) {
     const u64* q = p;
     u64 n = size / 8, i = 0;
@@ -180,10 +258,13 @@ static void ring_reset(Ring* r, const VmaBudget* budget) {
     r->used = 0;
 }
 
-static void timeline_wait(u64 value) {
+static void timeline_wait(u64 value, unsigned reason) {
+    int stats = cmd_stats_on();
