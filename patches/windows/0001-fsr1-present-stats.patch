+        if (stats) maintenance_start = plat_ns();
+        land_through(f->last);
+        f->last = 0;
+    }
+    dead_free(f);
+    u64 reset_start = stats ? plat_ns() : 0;
+    vkResetCommandPool(g_vk.dev, f->pool, 0);
