+            g_pace_stats.sleeps++;
+            g_pace_stats.sleep_sum_ns += sleep;
+            if (sleep > g_pace_stats.sleep_max_ns) g_pace_stats.sleep_max_ns = sleep;
+        }
+        if (g_pace_stats.calls == 600) {
+            report = g_pace_stats;
+            report_calls = g_pace_stats_calls;
+            memset(&g_pace_stats, 0, sizeof g_pace_stats);
+        }
+    }
     pm_unlock(&g_pace_lock);
     if (next > now) plat_sleep_ns((i64)(next - now));
+    if (report_calls)
+        LOG("pace-stats: calls=%llu window=%llu fps=%d interval=%u period_us=%llu initial=%llu resets=%llu "
+            "count/sum_us/max_us late=%llu/%llu/%llu requested_sleep=%llu/%llu/%llu\n",
+            (unsigned long long)report_calls, (unsigned long long)report.calls, fps, interval,
+            (unsigned long long)(period / 1000), (unsigned long long)report.initial,
+            (unsigned long long)report.resets, (unsigned long long)report.late_count,
+            (unsigned long long)(report.late_sum_ns / 1000), (unsigned long long)(report.late_max_ns / 1000),
+            (unsigned long long)report.sleeps, (unsigned long long)(report.sleep_sum_ns / 1000),
+            (unsigned long long)(report.sleep_max_ns / 1000));
 }
 
