diff --git a/src/nx/gpu/vk/fsr.c b/src/nx/gpu/vk/fsr.c
new file mode 100644
index 0000000..b418c94
--- /dev/null
+++ b/src/nx/gpu/vk/fsr.c
@@ -0,0 +1,336 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the ScarletNX contributors */
+/* FSR 1 as the final upscale (AMD FidelityFX FSR 1, MIT licence): the presented frame's rectangle enlarged into the
+   swapchain image where a blit would stretch it with one bilinear tap. EASU rebuilds edges into an image the size of
+   the window's rectangle; RCAS then sharpens that by each pixel's ring. The shaders (shaders/fsr.frag and
+   shaders/fsr_rcas.frag) do the work; this makes their pipelines, keeps the intermediate image, binds the frame and
+   draws. Under vk_lock, from renderer.c's show(): the swapchain image is in TRANSFER_DST_OPTIMAL, the frame in
+   SHADER_READ_ONLY_OPTIMAL. */
+#include <math.h>
+#include <string.h>
+#include "nx/gpu/vk/vk.h"
+#include "nx/gpu/vk/fsr_spv.h"
+#include "nx/runtime/platform/log.h"
+
+/* the EASU shader's push constants, in its order: vec4s of floats */
+typedef struct {
+    float con0[4]; /* output pixel to a position in the source rectangle */
+    float con1[4];
+    float con2[4];
+    float con3[4];
+    float rect[4];  /* the source rectangle's origin and size, in the image's UV */
+    float dst[4];   /* the draw's origin and size, in framebuffer pixels */
+    float flags[4]; /* x: the source is flipped vertically */
+} EasuPush;
+
+/* the RCAS shader's */
+typedef struct {
+    float sharp[4]; /* x: the lobe scale, exp2(-sharpness) */
+    float size[4];  /* xy: the input's size in texels */
+    float dst[4];   /* xy: the draw's origin in framebuffer pixels */
+} RcasPush;
+
+/* RCAS attenuation in stops: 0 is strongest; larger values reduce sharpening. */
+#define FSR_SHARPNESS 1.5f
+
+static VkDescriptorSetLayout g_easu_dsl, g_rcas_dsl;
+static VkPipelineLayout g_easu_layout, g_rcas_layout;
+static VkPipeline g_easu_pipe, g_rcas_pipe;
+static VkFormat g_pipe_format;
+static VkSampler g_samp;
+static VkImage g_tmp;
+static VmaAllocation g_tmp_mem;
+static VkImageView g_tmp_view;
+static VkImageLayout g_tmp_layout;
+static u32 g_tmp_w, g_tmp_h;
+
+static int layout_make(void) {
+    VkDescriptorSetLayoutBinding b = {.binding = 0,
+                                      .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                                      .descriptorCount = 1,
+                                      .stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT};
+    VkDescriptorSetLayoutCreateInfo dci = {
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, .bindingCount = 1, .pBindings = &b};
+    VkPushConstantRange easu_pc = {VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(EasuPush)};
+    VkPushConstantRange rcas_pc = {VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(RcasPush)};
+    VkPipelineLayoutCreateInfo lci = {.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+                                      .setLayoutCount = 1,
+                                      .pSetLayouts = &g_easu_dsl,
+                                      .pushConstantRangeCount = 1,
+                                      .pPushConstantRanges = &easu_pc};
+    VkSamplerCreateInfo sci = {.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+                               .magFilter = VK_FILTER_NEAREST,
+                               .minFilter = VK_FILTER_NEAREST,
+                               .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+                               .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                               .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                               .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE};
+    if (g_samp) return 1;
+    if (!VK_OK(vkCreateDescriptorSetLayout(g_vk.dev, &dci, NULL, &g_easu_dsl))) return 0;
+    if (!VK_OK(vkCreateDescriptorSetLayout(g_vk.dev, &dci, NULL, &g_rcas_dsl))) return 0;
+    if (!VK_OK(vkCreatePipelineLayout(g_vk.dev, &lci, NULL, &g_easu_layout))) return 0;
+    lci.pSetLayouts = &g_rcas_dsl;
+    lci.pPushConstantRanges = &rcas_pc;
+    if (!VK_OK(vkCreatePipelineLayout(g_vk.dev, &lci, NULL, &g_rcas_layout))) return 0;
+    if (!VK_OK(vkCreateSampler(g_vk.dev, &sci, NULL, &g_samp))) return 0;
+    return 1;
+}
+
+/* A set for one draw. It goes through the recorder's stand-in allocator: the frame command buffer is
+   recorded on another thread, and a raw VkDescriptorSet may also look like one of its stand-ins. */
+static VkDescriptorSet set_new(VkDescriptorSetLayout layout, VkImageView view) {
+    VkDescriptorImageInfo di = {.sampler = g_samp,
+                                .imageView = view,
+                                .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    VkWriteDescriptorSet wr = {.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+                               .descriptorCount = 1,
+                               .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                               .pImageInfo = &di};
+    return vk_rec_new_set(layout, 1, &wr);
+}
+
+/* The EASU output can change size when the frame's aspect changes, even within the same swapchain. */
+static int tmp_make(u32 w, u32 h) {
+    VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+                            .imageType = VK_IMAGE_TYPE_2D,
+                            .format = g_vk.sc_format,
+                            .extent = {w, h, 1},
+                            .mipLevels = 1,
+                            .arrayLayers = 1,
+                            .samples = VK_SAMPLE_COUNT_1_BIT,
+                            .tiling = VK_IMAGE_TILING_OPTIMAL,
+                            .usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+                            .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
+    VmaAllocationCreateInfo aci = {.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE};
+    VkImageViewCreateInfo vci = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+                                 .viewType = VK_IMAGE_VIEW_TYPE_2D,
+                                 .format = g_vk.sc_format,
+                                 .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    if (g_tmp && g_tmp_w == w && g_tmp_h == h) return 1;
+    if (g_tmp) {
+        vk_defer_image(g_tmp, g_tmp_mem, g_tmp_view, VK_NULL_HANDLE);
+        g_tmp = VK_NULL_HANDLE;
+        g_tmp_view = VK_NULL_HANDLE;
+        g_tmp_w = g_tmp_h = 0;
+    }
+    if (!VK_OK(vmaCreateImage(g_vk.vma, &ii, &aci, &g_tmp, &g_tmp_mem, NULL))) return 0;
+    vci.image = g_tmp;
+    if (!VK_OK(vkCreateImageView(g_vk.dev, &vci, NULL, &g_tmp_view))) {
+        vmaDestroyImage(g_vk.vma, g_tmp, g_tmp_mem);
+        g_tmp = VK_NULL_HANDLE;
+        return 0;
+    }
+    g_tmp_w = w;
+    g_tmp_h = h;
+    g_tmp_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    LOG("vulkan: FSR 1 EASU + RCAS, attenuation %.2f stops, output %ux%u\n", FSR_SHARPNESS, w, h);
+    return 1;
+}
+
+static int pipeline_make(VkFormat format) {
+    VkShaderModule vs, fs_easu, fs_rcas;
+    VkPipelineShaderStageCreateInfo st[2] = {{.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                                              .stage = VK_SHADER_STAGE_VERTEX_BIT,
+                                              .pName = "main"},
+                                             {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                                              .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+                                              .pName = "main"}};
+    VkPipelineVertexInputStateCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    VkPipelineInputAssemblyStateCreateInfo ia = {.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+                                                 .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST};
+    VkPipelineViewportStateCreateInfo vp = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO, .viewportCount = 1, .scissorCount = 1};
+    VkPipelineRasterizationStateCreateInfo rs = {.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+                                                 .polygonMode = VK_POLYGON_MODE_FILL,
+                                                 .cullMode = VK_CULL_MODE_NONE,
+                                                 .lineWidth = 1};
+    VkPipelineMultisampleStateCreateInfo ms = {.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+                                               .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT};
+    /* the passes write every pixel of their rectangle: no blend */
+    VkPipelineColorBlendAttachmentState ba = {.blendEnable = VK_FALSE, .colorWriteMask = 0xF};
+    VkPipelineColorBlendStateCreateInfo cb = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO, .attachmentCount = 1, .pAttachments = &ba};
+    VkDynamicState dyn[2] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo ds = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO, .dynamicStateCount = 2, .pDynamicStates = dyn};
+    VkPipelineRenderingCreateInfo ri = {.sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+                                        .colorAttachmentCount = 1,
+                                        .pColorAttachmentFormats = &format};
+    VkGraphicsPipelineCreateInfo gci = {.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+                                        .pNext = &ri,
+                                        .stageCount = 2,
+                                        .pStages = st,
+                                        .pVertexInputState = &vi,
+                                        .pInputAssemblyState = &ia,
+                                        .pViewportState = &vp,
+                                        .pRasterizationState = &rs,
+                                        .pMultisampleState = &ms,
+                                        .pColorBlendState = &cb,
+                                        .pDynamicState = &ds,
+                                        .layout = g_easu_layout};
+    int ok;
+    if (g_easu_pipe && g_rcas_pipe && g_pipe_format == format) return 1;
+    if (g_easu_pipe) vkDestroyPipeline(g_vk.dev, g_easu_pipe, NULL); /* vk_finish ran when the swapchain changed */
+    if (g_rcas_pipe) vkDestroyPipeline(g_vk.dev, g_rcas_pipe, NULL);
+    g_easu_pipe = g_rcas_pipe = VK_NULL_HANDLE;
+    vs = vk_module_spv(fsr_vert_spv, fsr_vert_spv_size / 4);
+    fs_easu = vk_module_spv(fsr_frag_spv, fsr_frag_spv_size / 4);
+    fs_rcas = vk_module_spv(fsr_rcas_spv, fsr_rcas_spv_size / 4);
+    st[0].module = vs;
+    st[1].module = fs_easu;
+    ok = vs && fs_easu && fs_rcas &&
+         VK_OK(vkCreateGraphicsPipelines(g_vk.dev, vk_pipeline_cache(), 1, &gci, NULL, &g_easu_pipe));
+    if (ok) {
+        st[1].module = fs_rcas;
+        gci.layout = g_rcas_layout;
+        ok = VK_OK(vkCreateGraphicsPipelines(g_vk.dev, vk_pipeline_cache(), 1, &gci, NULL, &g_rcas_pipe));
+    }
+    if (vs) vkDestroyShaderModule(g_vk.dev, vs, NULL);
+    if (fs_easu) vkDestroyShaderModule(g_vk.dev, fs_easu, NULL);
+    if (fs_rcas) vkDestroyShaderModule(g_vk.dev, fs_rcas, NULL);
+    g_pipe_format = format;
+    if (!ok) {
+        if (g_easu_pipe) vkDestroyPipeline(g_vk.dev, g_easu_pipe, NULL);
+        if (g_rcas_pipe) vkDestroyPipeline(g_vk.dev, g_rcas_pipe, NULL);
+        g_easu_pipe = g_rcas_pipe = VK_NULL_HANDLE;
+    }
+    return ok;
+}
+
+/* Called after the swapchain's work has finished. */
+void vk_fsr_swapchain_gone(void) {
+    if (g_tmp) {
+        vkDestroyImageView(g_vk.dev, g_tmp_view, NULL);
+        vmaDestroyImage(g_vk.vma, g_tmp, g_tmp_mem);
+        g_tmp = VK_NULL_HANDLE;
+        g_tmp_view = VK_NULL_HANDLE;
+        g_tmp_w = g_tmp_h = 0;
+    }
+}
+
+/* src: the frame, in SHADER_READ_ONLY_OPTIMAL, its view level 0; uv: the used rectangle (u, v, width, height) in the
+   image's UV; iw, ih: that rectangle in texels; dst: the rectangle (x, y, width, height) in the swapchain image,
+   which is in TRANSFER_DST_OPTIMAL and is left in it. flip: the frame is stored bottom-up. 0: the pass did not run,
+   and the caller blits instead. */
+int vk_fsr_draw(VkCommandBuffer cb, VkImageView view, int flip, const float uv[4], u32 iw, u32 ih, VkImage sc,
+                const i32 dst[4]) {
+    EasuPush ep;
+    RcasPush rp;
+    VkDescriptorSet set, tset;
+    VkImageView scv = vk_sc_view(sc);
+    float iwr, ihr, owr, ohr, ix, iy;
+    if (!view || !scv || !iw || !ih || dst[2] <= 0 || dst[3] <= 0) return 0;
+    if (!layout_make() || !pipeline_make(g_vk.sc_format)) return 0;
+    if (!tmp_make((u32)dst[2], (u32)dst[3])) return 0;
+    set = set_new(g_easu_dsl, view);
+    tset = set_new(g_rcas_dsl, g_tmp_view);
+    if (!set || !tset) return 0;
+    iwr = (float)iw, ihr = (float)ih, owr = (float)dst[2], ohr = (float)dst[3];
+    /* AMD's con0 to con3 for a frame of iw x ih texels drawn into dst[2] x dst[3] pixels (ffx_fsr1.h,
+       FsrEasuCon) */
+    ep.con0[0] = iwr / owr;
+    ep.con0[1] = ihr / ohr;
+    ep.con0[2] = 0.5f * ep.con0[0] - 0.5f;
+    ep.con0[3] = 0.5f * ep.con0[1] - 0.5f;
+    ix = 1.0f / iwr;
+    iy = 1.0f / ihr;
+    ep.con1[0] = ix;
+    ep.con1[1] = iy;
+    ep.con1[2] = ix;
+    ep.con1[3] = -iy;
+    ep.con2[0] = -ix;
+    ep.con2[1] = 2.0f * iy;
+    ep.con2[2] = ix;
+    ep.con2[3] = 2.0f * iy;
+    ep.con3[0] = 0;
+    ep.con3[1] = 4.0f * iy;
+    ep.con3[2] = 0;
+    ep.con3[3] = 0;
+    memcpy(ep.rect, uv, 4 * sizeof(float));
+    ep.dst[0] = 0;
+    ep.dst[1] = 0;
+    ep.dst[2] = owr;
+    ep.dst[3] = ohr;
+    ep.flags[0] = flip ? 1.0f : 0.0f;
+    ep.flags[1] = ep.flags[2] = ep.flags[3] = 0.0f;
+    rp.sharp[0] = exp2f(-FSR_SHARPNESS);
+    rp.sharp[1] = rp.sharp[2] = rp.sharp[3] = 0.0f;
+    rp.size[0] = owr;
+    rp.size[1] = ohr;
+    rp.size[2] = rp.size[3] = 0.0f;
+    rp.dst[0] = (float)dst[0];
+    rp.dst[1] = (float)dst[1];
+    rp.dst[2] = rp.dst[3] = 0.0f;
+    /* EASU into the intermediate image: the frame's pixels to the window rectangle's */
+    vk_barrier(cb, g_tmp, VK_IMAGE_ASPECT_COLOR_BIT, VK_PIPELINE_STAGE_2_NONE, 0, g_tmp_layout,
+               VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+               VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    g_tmp_layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    {
+        VkRenderingAttachmentInfo at = {.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+                                        .imageView = g_tmp_view,
+                                        .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                                        .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE,
+                                        .storeOp = VK_ATTACHMENT_STORE_OP_STORE};
+        VkRect2D area = {{0, 0}, {(u32)dst[2], (u32)dst[3]}};
+        VkRenderingInfo ri = {.sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+                              .renderArea = area,
+                              .layerCount = 1,
+                              .colorAttachmentCount = 1,
+                              .pColorAttachments = &at};
+        VkViewport vp = {0, 0, owr, ohr, 0, 1};
+        rec_CmdBeginRendering(cb, &ri);
+        vk_render_forget_state();
+        rec_CmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, g_easu_pipe);
+        rec_CmdSetViewport(cb, 0, 1, &vp);
+        rec_CmdSetScissor(cb, 0, 1, &area);
+        rec_CmdPushConstants(cb, g_easu_layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof ep, &ep);
+        rec_CmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, g_easu_layout, 0, 1, &set, 0, NULL);
+        rec_CmdDraw(cb, 3, 1, 0, 0);
+        rec_CmdEndRendering(cb);
+    }
+    vk_barrier(cb, g_tmp, VK_IMAGE_ASPECT_COLOR_BIT, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,
+               VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+               VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,
+               VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    g_tmp_layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    /* RCAS into the swapchain image's rectangle */
+    {
+        VkRenderingAttachmentInfo at;
+        VkRenderingInfo ri;
+        VkRect2D area = {{dst[0], dst[1]}, {(u32)dst[2], (u32)dst[3]}};
+        VkViewport vp = {(float)dst[0], (float)dst[1], owr, ohr, 0, 1};
+        vk_barrier(cb, sc, VK_IMAGE_ASPECT_COLOR_BIT, VK_PIPELINE_STAGE_2_BLIT_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,
+                   VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+        at = (VkRenderingAttachmentInfo){.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+                                         .imageView = scv,
+                                         .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                                         .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE,
+                                         .storeOp = VK_ATTACHMENT_STORE_OP_STORE};
+        ri = (VkRenderingInfo){.sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+                               .renderArea = area,
+                               .layerCount = 1,
+                               .colorAttachmentCount = 1,
+                               .pColorAttachments = &at};
+        rec_CmdBeginRendering(cb, &ri);
+        vk_render_forget_state();
+        rec_CmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, g_rcas_pipe);
+        rec_CmdSetViewport(cb, 0, 1, &vp);
+        rec_CmdSetScissor(cb, 0, 1, &area);
+        rec_CmdPushConstants(cb, g_rcas_layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof rp, &rp);
+        rec_CmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, g_rcas_layout, 0, 1, &tset, 0, NULL);
+        rec_CmdDraw(cb, 3, 1, 0, 0);
+        rec_CmdEndRendering(cb);
+    }
+    vk_barrier(cb, sc, VK_IMAGE_ASPECT_COLOR_BIT, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,
+               VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+               VK_PIPELINE_STAGE_2_BLIT_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    /* back for the next frame's EASU */
+    vk_barrier(cb, g_tmp, VK_IMAGE_ASPECT_COLOR_BIT, VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT,
+               VK_ACCESS_2_SHADER_SAMPLED_READ_BIT, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+               VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+               VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    g_tmp_layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    return 1;
+}
