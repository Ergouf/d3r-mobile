diff --git a/src/nx/runtime/native_ui.c b/src/nx/runtime/native_ui.c
--- a/src/nx/runtime/native_ui.c
+++ b/src/nx/runtime/native_ui.c
@@ -364,6 +364,19 @@
 /* The bucket hash in 0x8335350 only covers the low 4 bytes of the key; a few
    UI nodes whose key collides are not reachable from its bucket. Scan the whole
    registry when the direct lookup misses. */
+static int ui_guest_read64(u64 address, u64* out) {
+    MemBlock b;
+    if (!address || address >= AS_END || address + 8 > AS_END) return 0;
+    mem_query(address, &b);
+    if (!(b.perm & PERM_R) || address < b.addr || address + 8 > b.addr + b.size) {
+        /* Registry nodes live in a large RW allocation; accept any readable
+           mapping that starts before the node, not only ones starting at it. */
+        if (!(b.perm & PERM_R) || address + 8 > b.addr + b.size) return 0;
+    }
+    memcpy(out, GP(address), 8);
+    return 1;
+}
+
 static u64 ui_find_key(u64 map, u64 key) {
     u32 mask, total;
     u64 buckets;
@@ -375,9 +388,9 @@
         if (!kbm_read64(buckets + (u64)i * 8, &node)) continue;
         for (unsigned g = 0; node && g < 1024; g++) {
             u64 actual, obj, next;
-            if (!kbm_read64(node, &next)) break;
-            if (kbm_read64(node + 8, &actual) && actual == key &&
-                kbm_read64(node + 0x10, &obj)) return obj;
+            if (!ui_guest_read64(node, &next)) break;
+            if (ui_guest_read64(node + 8, &actual) && actual == key &&
+                ui_guest_read64(node + 0x10, &obj)) return obj;
             node = next;
         }
     }
