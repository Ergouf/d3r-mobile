+/* The PC Diablo III cursor asset (32x32 RGBA, hotspot 0,0).  SDL draws it as
+   the system cursor; the old runtime-drawn pointer is no longer composited. */
+static void pc_cursor_init(void) {
+    SDL_Surface* surface = SDL_CreateSurfaceFrom(32, 32, SDL_PIXELFORMAT_RGBA32,
+                                                 (void*)g_pc_cursor_rgba, 32 * 4);
+    if (!surface) {
+        WARN("video: PC cursor surface: %s\n", SDL_GetError());
+        return;
+    }
+    g_pc_cursor = SDL_CreateColorCursor(surface, 0, 0);
+    SDL_DestroySurface(surface);
+    if (!g_pc_cursor) {
+        WARN("video: PC cursor: %s\n", SDL_GetError());
+        return;
+    }
+    SDL_SetCursor(g_pc_cursor);
+    SDL_ShowCursor();
+    LOG("video: PC cursor loaded (32x32, hotspot 0,0)\n");
+}
