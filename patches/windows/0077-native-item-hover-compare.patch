+static void ui_compare_tick(const CPU* cpu, u64 map) {
+    int held = __atomic_load_n(&g_compare_requested, __ATOMIC_ACQUIRE);
+    if (!held && !g_compare_owner) return;
+    UiPick p = {.cpu = cpu, .map = map};
+    UiItemContext c = {0};
+    u32 mode, item;
+    if (!ui_item_context(&p, &c)) return; /* A covering modal owns the input. */
+    if (c.stash || (g_compare_owner && g_compare_owner != c.owner)) {
+        g_compare_owner = 0;
+        return;
+    }
+    if (!read32(c.owner + 0x154, &mode) || mode > 1) return;
+    if (!g_compare_owner) {
+        if (!held) return;
+        g_compare_owner = c.owner;
+        g_compare_restore = mode;
+    }
+    u32 desired = held ? 1 : g_compare_restore;
+    if (mode == desired) {
+        if (!held) g_compare_owner = 0;
+        return;
+    }
+    /* 9 = Compare, 10 = return from Compare. Other button3 contexts include
+       unrelated inventory actions and must not receive this modifier. */
+    GuestResult r;
+    if (held) {
+        if (!read32(c.side[0] + 0x48, &item) || item == UINT32_MAX ||
+            !guest_call(cpu, 0x8170BD0, NULL, 0, NULL, 0, &r) || !r.x0) return;
+        const u64 context_args[] = {r.x0, 5};
+        if (!guest_call(cpu, 0x81C0820, context_args, 2, NULL, 0, &r) ||
+            r.x0 != (mode ? 10u : 9u)) return;
+    }
+    /* Use the complete native Compare branch: it switches the item models,
+       preserves the selected item and refreshes their detail callbacks. */
+    /* Release uses the native model setter even when the pointer has moved to
+       an empty/non-equipment row whose button3 action is no longer Compare. */
+    const u64 args[] = {c.owner, held ? 0u : desired};
+    int complete = guest_call(cpu, held ? 0x8373750 : 0x81FC220, args, 2, NULL, 0, NULL);
+    int changed = complete && read32(c.owner + 0x154, &mode) && mode == desired;
+    LOG("native: UI Alt compare owner=%llx held=%d -> %s\n", (unsigned long long)c.owner,
+        held, changed ? "changed" : "incomplete");
+    if (!held && changed) g_compare_owner = 0;
 }
 
