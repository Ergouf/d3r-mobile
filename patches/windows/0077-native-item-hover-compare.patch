+/* The list's native selection setter calls its registered selection-change
+   callback. Never invoke the row's accept/equip callback for a hover. */
+static int ui_item_hover(UiPick* p) {
+    UiItemContext c = {0};
+    UiItem item = {0};
+    u64 binding;
+    u32 selected;
+    if (!ui_item_context(p, &c)) return 0;
+    ui_build_children(p->map);
+    if (!ui_item_pick(p, &c, &item) || !item.control ||
+        !read64(item.control + 0x48, &binding) || binding != c.side[item.side] ||
+        !read32(item.control + 0x1E0, &selected)) return 0;
+    if (selected == item.index) return 1;
+    const u64 args[] = {item.control, item.index};
+    int complete = guest_call(p->cpu, 0x838A6E0, args, 2, NULL, 0, NULL);
+    u32 handle;
+    int changed = complete && read32(item.control + 0x1E0, &selected) && selected == item.index &&
+                  read32(binding + 0x48, &handle) && handle == item.handle;
+    LOG("native: UI hover item %08x side=%d row=%u -> %s\n", item.handle, item.side,
+        item.index, changed ? "selected" : "incomplete");
+    return 1;
+}
