diff --git a/src/nx/runtime/native_input.c b/src/nx/runtime/native_input.c
new file mode 100644
index 0000000..4fe9ed6
--- /dev/null
+++ b/src/nx/runtime/native_input.c
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the ScarletNX contributors */
+#include "nx/runtime/native_input.h"
+#include "nx/runtime/loader.h"
+#include "nx/runtime/arm.h"
+#include "nx/runtime/main.h"
+#include "nx/runtime/rtapi.h"
+#include "nx/runtime/platform/log.h"
+#include "nx/memory/mem.h"
+#include "common/filesystem/host.h"
+#include <stdlib.h>
+#include <string.h>
+
+/* the game's djb2 (h = h * 33 + c) and the UI_HUD_ClickPredicate string: a pure
+   function with no stack or TLS, so it proves the bridge without touching game state */
+#define SELFTEST_PC  0x8a49690ull /* FUN_00a49690 */
+#define SELFTEST_ARG 0x8dcf212ull /* "UI_HUD_ClickPredicate" */
+#define SELFTEST_WANT 0x908be1d4u
+
+#define NATIVE_STACK_SIZE (256u * 1024u)
+#define NATIVE_MAX_STEPS  200000
+
+static u64 g_stack_top;
+static int g_selftest_done;
+static int g_busy;
+static int g_test_ui; /* SNX_NATIVE_TEST=1: queue one UIConsole_MainMenu_Accept call */
+static PMutex g_lock = PMUTEX_INIT;
+static int g_have;
+static u64 g_pc;
+static u64 g_args[8];
+
+int native_input_pending(void) { return __atomic_load_n(&g_have, __ATOMIC_ACQUIRE); }
+
+int native_input_queue(u64 pc, const u64 args[8]) {
+    int queued = 0;
+    pm_lock(&g_lock);
+    if (!g_have) {
+        g_pc = pc;
+        if (args)
+            memcpy(g_args, args, sizeof g_args);
+        else
+            memset(g_args, 0, sizeof g_args);
+        __atomic_store_n(&g_have, 1, __ATOMIC_RELEASE);
+        queued = 1;
+    }
+    pm_unlock(&g_lock);
+    return queued;
+}
+
+static int native_input_take(u64* pc, u64 args[8]) {
+    int have;
+    pm_lock(&g_lock);
+    have = g_have;
+    if (have) {
+        *pc = g_pc;
+        memcpy(args, g_args, sizeof g_args);
+        __atomic_store_n(&g_have, 0, __ATOMIC_RELEASE);
+    }
+    pm_unlock(&g_lock);
+    return have;
+}
+
+void native_input_init(void) {
+    u64 base;
+    if (g_arm_mod) return; /* the 32-bit path has its own CPU state */
+    base = kmem_alloc(NATIVE_STACK_SIZE, MS_STACK, PERM_RW);
+    if (!base) {
+        WARN("native: no guest stack for the injection bridge\n");
+        return;
+    }
+    g_stack_top = base + NATIVE_STACK_SIZE - 0x100;
+    g_test_ui = getenv("SNX_NATIVE_TEST") != NULL;
+    LOG("native: bridge ready (stack %llx%s)\n", (unsigned long long)g_stack_top, g_test_ui ? ", test UI" : "");
+}
+
+void native_input_tick(void) {
+    /* Off by default. With SNX_NATIVE_TEST=1, once the game has shown 3000 frames, queue one call to the runtime's
+       UIConsole_MainMenu_Accept (0x8366870) with x0=0, x1=0: a probe of the handler's real arguments. */
+    u64 args[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    static int queued;
+    if (!g_test_ui || queued || !g_stack_top) return;
+    if (__atomic_load_n(&g_frames, __ATOMIC_RELAXED) < 3000) return;
+    if (native_input_queue(0x8366870, args)) {
+        queued = 1;
+        LOG("native: UI accept probe queued after %d frames\n", g_frames);
+    }
+}
+
+void native_input_run(CPU* c) {
+    CPU n;
+    u64 pc, args[8];
+    int steps = 0;
+    if (g_busy || !g_stack_top || !native_input_take(&pc, args)) return;
+    g_busy = 1;
+    n = *c;
+    memcpy(n.x, args, sizeof args);
+    n.x[30] = 0; /* returning to 0 ends the call */
+    n.x[31] = g_stack_top;
+    n.pc = pc;
+    n.poll = 0; /* never hand this core away in the middle of a nested call */
+    if (pc == SELFTEST_PC && !g_selftest_done)
+        LOG("native: self-test call x0=%llx bytes=%02x %02x %02x %02x sp=%llx\n", (unsigned long long)n.x[0],
+            n.x[0] < (1ull << 32) ? g_mem[n.x[0]] : 0, n.x[0] + 1 < (1ull << 32) ? g_mem[n.x[0] + 1] : 0,
+            n.x[0] + 2 < (1ull << 32) ? g_mem[n.x[0] + 2] : 0, n.x[0] + 3 < (1ull << 32) ? g_mem[n.x[0] + 3] : 0,
+            (unsigned long long)n.x[31]);
+    while (n.pc && steps < NATIVE_MAX_STEPS) {
+        GuestFn f = snx_lookup(&n, n.pc);
+        if (!f) {
+            WARN("native: no code at %llx\n", (unsigned long long)n.pc);
+            break;
+        }
+        f(&n, n.pc);
+        steps++;
+    }
+    if (pc == SELFTEST_PC && !g_selftest_done) {
+        u32 got = (u32)n.x[0];
+        g_selftest_done = 1;
+        LOG("native: djb2('A') self-test %u (want 65), steps %d%s\n", got, steps, got == 65 ? "" : " MISMATCH");
+    } else {
+        LOG("native: call %llx returned, steps %d, x0=%llx\n", (unsigned long long)pc, steps,
+            (unsigned long long)n.x[0]);
+    }
+    g_busy = 0;
+}
diff --git a/src/nx/runtime/native_input.h b/src/nx/runtime/native_input.h
new file mode 100644
index 0000000..9b06a1c
--- /dev/null
+++ b/src/nx/runtime/native_input.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the ScarletNX contributors */
+/* A call from the runtime into the game's own guest code, run on the game thread.
+
+   The UI table's handlers are continuation blocks inside the game's script VM, and
+   calling guest code from a host thread with a copied CPU crashes (BEX64 in JIT).
+   This bridge therefore queues a call on whichever thread posts it and runs it at
+   the next SVC the game thread makes: the CPU, TLS and thread are the game's own,
+   and only the stack is a fresh one from the kernel region. Nested SVCs from the
+   called function do not re-enter it. */
+#ifndef SNX_NATIVE_INPUT_H
+#define SNX_NATIVE_INPUT_H
+#include "common/cpu/aarch64/cpu.h"
+
+/* Allocates the scratch guest stack and queues a self-test call (djb2 over the
+   UI_HUD_ClickPredicate string); called once after the game is loaded. */
+void native_input_init(void);
+
+/* 1 when the call was queued (one slot: a call already waiting makes this 0) */
+int native_input_queue(u64 pc, const u64 args[8]);
+int native_input_pending(void);
+
+/* Called from the frontend each frame: once the game has shown some frames, queues the self-test, so the bridge is not
+   exercised in the middle of boot */
+void native_input_tick(void);
+
+/* Runs the queued call on the game thread, at the SVC entry. Safe to call on
+   every SVC: it returns at once when nothing waits or a call is already running. */
+void native_input_run(CPU* c);
+
+#endif
