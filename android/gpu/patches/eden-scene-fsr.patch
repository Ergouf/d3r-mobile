+#ifdef D3_ANDROID_SCENE_FSR
+void BlitImageHelper::BlitScaleImage(const Framebuffer* framebuffer, ImageView& source,
+                                     const Region2D& dst_region, const Region2D& src_region,
+                                     const Extent3D& src_size, VkImageAspectFlags aspects) {
+    const bool color = aspects == VK_IMAGE_ASPECT_COLOR_BIT;
+    const bool stencil = (aspects & VK_IMAGE_ASPECT_STENCIL_BIT) != 0;
+    ASSERT(!stencil || device.IsExtShaderStencilExportSupported());
+    const BlitImagePipelineKey key{framebuffer->RenderPass(),
+                                   Tegra::Engines::Fermi2D::Operation::SrcCopy};
+    const auto pipeline = color ? FindOrEmplaceColorPipeline(key)
+                        : stencil ? FindOrEmplaceDepthStencilPipeline(key)
+                                  : FindOrEmplaceBlitDepthPipeline(key.renderpass);
+    const auto layout = stencil ? *two_textures_pipeline_layout : *one_texture_pipeline_layout;
+    const auto view = color ? source.Handle(Shader::TextureType::Color2D) : source.DepthView();
+    const auto stencil_view = stencil ? source.StencilView() : VK_NULL_HANDLE;
+    const auto sampler = color ? *linear_sampler : *nearest_sampler;
+    RecordShaderReadBarrier(scheduler, source);
+    scheduler.RequestRenderpass(framebuffer);
+    scheduler.Record([=, this](vk::CommandBuffer command) {
+        const auto set = stencil ? two_textures_descriptor_allocator.Commit()
+                                 : one_texture_descriptor_allocator.Commit();
+        if (stencil) UpdateTwoTexturesDescriptorSet(device, set, sampler, view, stencil_view);
+        else UpdateOneTextureDescriptorSet(device, set, sampler, view);
+        command.BindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+        command.BindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0, set, nullptr);
+        // Regions are in physical pixels, not normalized UV coordinates.
+        BindBlitState(command, layout, dst_region, src_region, src_size);
+        command.Draw(3, 1, 0, 0);
+    });
+    scheduler.InvalidateState();
+}
+#endif
