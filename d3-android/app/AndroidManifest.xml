<?xml version="1.0" encoding="utf-8"?>
<!-- The installed package is separate; the Activity retains the JNI class name. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.d3mobile.host.recovery"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36" />

    <!-- arm64 guest + host: no x86/armeabi fallbacks on purpose. -->
    <application
        android:label="D3HOST Recovery"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:hasCode="true">

        <activity
            android:name="com.d3mobile.host.MainActivity"
            android:label="D3HOST Recovery"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
