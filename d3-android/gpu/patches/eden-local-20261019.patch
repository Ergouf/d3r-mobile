diff --git a/src/common/thread.h b/src/common/thread.h
index 4a36295..e2fc6c9 100644
--- a/src/common/thread.h
+++ b/src/common/thread.h
@@ -77,8 +77,10 @@ public:
             condvar.notify_all();
             return true;
         } else {
-            condvar.wait(lk, token,
-                        [this, current_generation] { return current_generation != generation; });
+            // Port note: Android libc++ has no stop_token overload, so poll the token.
+            condvar.wait(lk, [this, current_generation, token] {
+                return current_generation != generation || token.stop_requested();
+            });
             return !token.stop_requested();
         }
     }
diff --git a/src/video_core/cdma_pusher.cpp b/src/video_core/cdma_pusher.cpp
