         while (!stop_token.stop_requested()) {
             {
                 std::unique_lock l{command_mutex};
-                command_cv.wait(l, stop_token, [this]() { return command_lists.size() > 0; });
+                // Port note: Android libc++ lacks the stop_token overload of
